// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ROLES {
  USER
  CONSUMER
  AGENT
  CLIENT
  ADMIN
  STUDENT
  EDUCATOR
  HEADTEACHER
  PARENT
  JUNIOR
  SENIOR
  SOPHOMORE
  FRESHMAN
  WRITER
  STAFF
  MODERATOR
  PATIENT
  DOCTOR
  PATRON
  EXPERT
  STAFF_MEMBER
  SERVICE_PROVIDER
  RIDER
  DRIVER
  SUPPLIER
}

enum StudentLevelStatus {
  JUNIOR
  SENIOR
  SOPHOMORE
  FRESHMAN
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @db.ObjectId
  role         ROLES?   @default(USER)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  createdAt DateTime? @default(now())
  read      Boolean   @default(false)
  Company   Company?  @relation(fields: [companyId], references: [id])
  companyId String?   @db.ObjectId

  @@index([companyId])
}

model CompanyCategory {
  id      String    @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  icon    String?
  image   String?
  status  String
  Company Company[]

  @@index([status])
}

// Category model with self-relations for hierarchy (categories & subcategories)
model ProductCategory {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  icon            String?
  image           String?
  slug            String    @unique
  description     String
  longDescription String
  seoTitle        String
  seoDescription  String
  metaKeywords    String[]
  sortOrder       Int       @default(0)
  visible         Boolean   @default(false)
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  createdBy       String
  updatedBy       String
  status          String
  allBrands       String[]
  tags            String[]

  // Hierarchy pointers
  subcategories Json // Store subcategories as a JSON array

  // Media & SEO assets
  imageAlt    String
  thumbnail   String?
  bannerImage String?

  // Localization
  localization Json

  // Dynamic fields
  productCount   Int
  isFeatured     Boolean @default(false)
  showInHomepage Boolean @default(false)

  // Custom attributes
  attributes Json

  Product             Product[]
  marketplaceListings marketplaceListings[]
  StoreCategory       StoreCategory[]
  Company             Company?              @relation(fields: [companyId], references: [id])
  companyId           String?               @db.ObjectId
  Podcast             Podcast[]
  // @@index([slug])

  @@index([companyId])
  @@index([tags])
  @@index([metaKeywords])
  @@index([allBrands])
  @@index([status])
}

/// Associates a Company with a ProductCategory,
/// plus any store-specific settings.
model StoreCategory {
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  category   ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId String          @db.ObjectId

  displayName String?
  icon        String?
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)

  id String @id @default(auto()) @map("_id") @db.ObjectId

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Store the selected subcategory objects directly as JSON
  subcategories Json?

  // Store the selected brand names as a JSON array
  allBrands Json? // e.g., ["Nike", "Adidas"]

  @@unique([companyId, categoryId])
  @@index([companyId, sortOrder])
  @@index([companyId])
  @@index([categoryId])
  @@index([allBrands])
}

model Company {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  tagline     String? // short marketing line
  description String?

  hasWebsite Boolean? @default(false)

  companyCategoryId String?          @db.ObjectId
  companyCategory   CompanyCategory? @relation(fields: [companyCategoryId], references: [id])
  category          String
  variant           String?
  logoUrl           String?
  bannerUrl         String?
  videoUrl          String? // Added field for company video URL

  contactEmail String
  contactPhone String?
  site         String? @default("default")
  address      String?
  geoLocation  Json? // { lat: number, lng: number }
  openingHours Json? // { mon: "9–5", tue: "...", … }
  domain       String? @unique
  currency     String  @default("KES")
  locale       String  @default("en-US")

  lat     Float? // Office Latitude
  lng     Float? // Office Longitude
  radius  Int      @default(200) // Allowed distance in meters
  devices Device[]

  settings CompanySettings?

  pricingTiers Json[] // ServicePricingTier name, description, price, duration, features[]

  themeSettings Json? // colors, fonts, layout toggles

  // existing relations
  user   User?   @relation(name: "companyAdmin", fields: [userId], references: [id])
  userId String? @db.ObjectId

  sslStatus String? @default("PENDING")
  // inventory InventoryItem[]

  productRequests Request[]
  Target          Target[]
  commissions     Commission[]
  commissionsRate CommissionRate[]

  // adminUserId String? @db.ObjectId // Optional: Link to the initial admin user of the company
  // adminUser   User?   @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  deletedAt DateTime?
  // sEOId     String?   @db.ObjectId

  awards  Json?
  metrics Json?
  stats   Json?

  /// Highlighted sections (e.g., mission, vision, key points)
  /// Shape: Highlight[]
  highlights Json?

  founderName  String?
  founderQuote String?
  founderImage String?
  partnerLogos Json? // Array of logo URLs for partner marquee sections

  // NEW PROPS FOR CUSTOMIZABLE TEXT
  sectionSubtitle    String?
  sectionTitle       String?
  sectionDescription String?
  // END NEW PROPS

  StoreCategory StoreCategory[]

  PageSection  PageSection[]
  Collection   Collection[]
  socialLinks  SocialLink[] // structured social profiles
  policies     Policy[] // structured, editable policies
  faqs         FAQ[] // common questions
  testimonials Testimonial[] // customer quotes
  promotions   Promotion[] // site-wide deals
  Announcement Announcement[]
  Conversation Conversation[]

  productCategories ProductCategory[]

  marketplaceListings marketplaceListings[]
  Product             Product[]

  customerOrders CustomerOrder[]
  inventoryItems InventoryItem[]

  salesAgents SalesAgent[]
  clients     Client[]
  consumers   Consumer[]
  educators   Educator[]
  students    Student[]
  parents     Parent[]
  HeadTeacher HeadTeacher[]

  academicLevels AcademicLevel[]
  courses        Course[]
  departments    Department[]

  blogs    Blog[]
  seoBlogs SeoBlog[]

  notifications Notification[]

  heroSlides Banner[]
  appPromos  AppPromo[]

  events           Event[]
  tasks            Task[]
  locations        Locations[]
  discussionTopics DiscussionTopic[]

  attendanceRecords AttendanceRecord[]

  exams                           Exam[]
  grades                          Grade[] // Grades are now directly linked to a company
  classSchedules                  ClassSchedule[]
  EducatorAcademicLevelAssignment EducatorAcademicLevelAssignment[]
  CourseEducatorAssignment        CourseEducatorAssignment[]
  CourseAcademicLevel             CourseAcademicLevel[]
  CourseEnrollment                CourseEnrollment[]
  CourseAssignment                CourseAssignment[]
  AssignmentSubmission            AssignmentSubmission[]
  EventRegistration               EventRegistration[]
  DiscussionPost                  DiscussionPost[]
  DiscussionComment               DiscussionComment[]
  Project                         Project[]
  Doctor                          Doctor[]
  Writer                          Writer[]
  Podcast                         Podcast[]
  Donor                           Donor[]
  CompanyLocation                 CompanyLocation[]
  Inquiry                         Inquiry[]
  Showing                         Showing[]
  OfferContract                   OfferContract[]
  Appointment                     Appointment[]
  staffMembers                    StaffProfile[]
  services                        Service[]
  prescriptions                   Prescription[]
  PatientInvoices                 PatientInvoices[]
  User                            User[]                            @relation("CompanyUsers")
  Plan                            Plan[]
  Diagnosis                       Diagnosis[]
  BillingTransaction              BillingTransaction[]
  Video                           Video[]
  Photo                           Photo[]
  PhotoAlbum                      PhotoAlbum[]
  VideoAlbum                      VideoAlbum[]
  Sponsor                         Sponsor[]
  Document                        Document[]
  Expert                          Expert[]
  Content                         Content[]
  PromotionDiscount               PromotionDiscount[]
  Location                        Location[]
  Booking                         Booking[]
  Communication                   Communication[]
  Case                            Case[]
  FinanceAppointment              FinanceAppointment[]
  Invoice                         Invoice[]
  Package                         Package[]

  sEOId String? @unique @db.ObjectId
  SEO   SEO?    @relation(fields: [sEOId], references: [id], onDelete: NoAction)

  analyticsConfigId String?          @unique @db.ObjectId
  AnalyticsConfig   AnalyticsConfig? @relation(fields: [analyticsConfigId], references: [id], onDelete: NoAction)

  paymentSettingsId String?          @unique @db.ObjectId
  PaymentSettings   PaymentSettings? @relation(fields: [paymentSettingsId], references: [id], onDelete: NoAction)

  shippingSettingsId String?           @unique @db.ObjectId
  ShippingSettings   ShippingSettings? @relation(fields: [shippingSettingsId], references: [id], onDelete: NoAction)

  Subscription          Subscription[]
  CoreValues            CoreValues[]
  Destination           Destination[]
  TourPackage           TourPackage[]
  // @@index([slug])
  Delivery              Delivery[]
  subscriptionCompanies SubscriptionCompany[]
  feeItems              FeeItem[]
  classrooms            Classroom[]

  // Library Management relations
  libraryBooks     LibraryBook[]
  libraryIssuances LibraryIssuance[]

  // Transport Management relations
  transportVehicles TransportVehicle[]
  transportRoutes   TransportRoute[]

  // Hostel Management relations
  hostelBlocks HostelBlock[]

  // Staff Management (HR) relations
  staffLeaves   StaffLeave[]
  staffPayrolls StaffPayroll[]

  // Fee Management relations
  feeStructures FeeStructure[]

  // Inventory & Assets relations
  assets                    Asset[]
  inventoryAudits           InventoryAudit[]
  libraryCategories         LibraryCategory[]
  libraryMembers            LibraryMember[]
  librarySuppliers          LibrarySupplier[]
  libraryAcquisitions       LibraryAcquisition[]
  transportShifts           TransportShift[]
  librarySupplierCategories LibrarySupplierCategory[]
  transportDrivers          TransportDriver[]
  hostelMembers             HostelMember[]
  hostelVisitors            HostelVisitor[]
  hostelStaffs              HostelStaff[]
  roles                     Role[]
  leads                     Lead[]
  staffAttendanceRecords    StaffAttendanceRecord[]

  @@index([userId])
}

enum CategoryStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model CoreValues {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  company     Company @relation(fields: [companyId], references: [id])
  companyId   String  @db.ObjectId
  title       String  @default("")
  description String? @default("")
  icon        String? @default("")

  @@index([companyId])
}

model SocialLink {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  company   Company        @relation(fields: [companyId], references: [id])
  companyId String         @db.ObjectId
  channel   SocialChannel? @default(TWITTER)
  url       String         @default("")

  @@index([companyId])
}

model Policy {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  company   Company    @relation(fields: [companyId], references: [id])
  companyId String     @db.ObjectId
  type      PolicyType @default(PRIVACY)
  title     String?    @default("")
  content   String     @default("")

  @@index([companyId])
}

model Banner {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  type            String?   @default("image") // e.g."video" | "image" | "Hero" | "Promo" | "Feature"
  imageUrl        String?
  productImageUrl String?
  headline        String?
  subline         String?
  ctaText         String?
  ctaLink         String?
  videoLink       String?
  badgeText       String?
  price           String?
  endsAt          DateTime?
  order           Int       @default(0)
  iconKey         String? // e.g. "laundry", "delivery"
  backgroundColor String?
  textColor       String?

  @@index([companyId])
}

//this promotion on the other hand is a promotion table that highlights the promotions or offers a company offers something lika a banner
model Promotion {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  code        String?
  title       String
  description String?

  startsAt DateTime?
  endsAt   DateTime?

  badgeText String?
  price     String?

  ctaText   String?
  ctaLink   String?
  bannerUrl String?

  // New fields for richer site promotion
  featureImage1 String?
  featureImage2 String?
  featureImage3 String?

  perks          Json? // e.g. [{ icon: "SparklesIcon", label: "Uncompromising Quality" }]
  trustLogos     Json? // e.g. ["/logos/google.svg", "/logos/microsoft.svg"]
  themePrimary   String? // overrides store.themeSettings.primaryColor
  themeSecondary String? // overrides store.themeSettings.secondaryColor

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([companyId])
}

model AnalyticsConfig {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  googleTag   String?
  facebookTag String?

  hotjarSiteId String?

  isActive Boolean @default(false)

  company Company?
}

model PaymentSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Back-relation to Company (Company is the defining side via paymentSettingsId)
  company Company?

  // --- Payment Method Enablement Flags ---
  isStripeEnabled   Boolean @default(false)
  isPaypalEnabled   Boolean @default(false)
  isMpesaEnabled    Boolean @default(false)
  isPaystackEnabled Boolean @default(false) // NEW: Toggle for Paystack
  isGhubaEnabled    Boolean @default(false)

  // --- M-Pesa Configuration (You might consider encrypting these) ---
  mpesaShortcode      String?
  mpesaConsumerKey    String?
  mpesaConsumerSecret String?
  mpesaCallbackUrl    String?
  mpesaPasskey        String?

  mpesaSecret_encrypted String?
  mpesaSecret_iv        String?
  mpesaSecret_tag       String?

  // --- Paystack Configuration (NEW) ---
  paystackPublicKey String?
  paystackSecretKey String? // IMPORTANT: Must be encrypted in the database in a real-world application.

  stripePublishableKey String?
  stripeSecretKey      String?

  paypalClientId     String?
  paypalClientSecret String?
  // --- Ghuba Configuration (NEW) ---
  ghubaMerchantId    String?
  ghubaApiKey        String? // IMPORTANT: Must be encrypted in the database in a real-world application.

  stripeSecret_encrypted String?
  stripeSecret_iv        String?
  stripeSecret_tag       String?

  paypalSecret_encrypted String?
  paypalSecret_iv        String?
  paypalSecret_tag       String?

  paystackSecret_encrypted String?
  paystackSecret_iv        String?
  paystackSecret_tag       String?

  ghubaSecret_encrypted String?
  ghubaSecret_iv        String?
  ghubaSecret_tag       String?
}

