// Academic Level Model
// Defines the different educational levels or "classes" students can belong to.
model AcademicLevel {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String // e.g., "Playgroup", "Grade 1", "High School - Freshman", "University - Year 1"
  description String?
  sortOrder   Int     @default(0) // For ordering display (e.g., Grade 1 before Grade 2)

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  // NEW: Junction table for many-to-many with Educator
  educatorAssignments EducatorAcademicLevelAssignment[]

  gradesEarned Grade[] @relation("gradesEarned") // New relation for historical grades

  AttendanceRecord AttendanceRecord[]

  CourseAcademicLevel  CourseAcademicLevel[]
  StudentAcademicLevel StudentAcademicLevel[]

  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @updatedAt
  classrooms     Classroom[]
  classSchedules ClassSchedule[]
  exams          Exam[]

  @@unique([companyId, name]) // A company cannot have two academic levels with the same name
  @@index([companyId, sortOrder]) // For efficient querying and ordering
  @@index([companyId])
}

model Classroom {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name        String // e.g., "Room 101", "Science Lab"
  description String?
  capacity    Int?

  academicLevelId String?        @db.ObjectId
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId

  classSchedules ClassSchedule[]

  createdAt                        DateTime?                         @default(now())
  updatedAt                        DateTime?                         @updatedAt
  attendanceRecords                AttendanceRecord[]
  educatorAcademicLevelAssignments EducatorAcademicLevelAssignment[]
  courseEducatorAssignments        CourseEducatorAssignment[]
  studentAcademicLevels            StudentAcademicLevel[]
  exams                            Exam[]
  courseAssignments                CourseAssignment[]

  // Early Learning
  activityAssignments ActivityAssignment[] @relation("ClassroomActivityAssignments")

  @@index([companyId])
  @@index([academicLevelId])
  @@index([companyId, name(sort: Asc)])
}

