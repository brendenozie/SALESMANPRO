// ─────────────────────────────────────────────────────────
// EARLY LEARNING / ACTIVITY SYSTEM
// ─────────────────────────────────────────────────────────

/// Defines a category of educational activity (drawing, story-time, puzzle-play, etc.)
/// New activity types can be added without code changes to the activity framework.
model ActivityType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @db.ObjectId
  company     Company  @relation("ActivityTypes", fields: [companyId], references: [id])

  name        String   // e.g. "Drawing", "Story Time", "Puzzle Play", "Sing Along", "Make Friends"
  slug        String   // e.g. "drawing", "story-time", "puzzle-play", "sing-along", "make-friends"
  description String?
  icon        String?  // emoji or icon identifier
  color       String?  // hex colour for UI card

  ageMin Int?   // minimum recommended age in years
  ageMax Int?   // maximum recommended age in years

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, isActive])
}

/// A specific activity instance within a type (e.g. "Draw a Happy Sun", "The Three Bears")
model Activity {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String       @db.ObjectId
  company        Company      @relation("Activities", fields: [companyId], references: [id])

  activityTypeId String       @db.ObjectId
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id])

  title        String
  description  String?
  instructions String?   // student-facing instructions

  ageMin Int?
  ageMax Int?

  durationMins Int?      // estimated time to complete

  /// Flexible content payload - structure depends on activityType.slug:
  /// drawing:    { prompts: string[], guidedSteps: string[] }
  /// story-time: { text: string, pages: { text, imageUrl }[], questions: string[] }
  /// puzzle-play:{ type: "matching"|"ordering"|"memory", items: any[] }
  /// sing-along: { lyrics: string, audioUrl: string }
  /// make-friends: { scenario: string, options: string[], reflection: string }
  content Json?

  mediaAssetId String?     @db.ObjectId
  mediaAsset   MediaAsset? @relation("ActivityMedia", fields: [mediaAssetId], references: [id])

  createdById String  @db.ObjectId
  createdBy   User    @relation("ActivityCreators", fields: [createdById], references: [id])

  isPublished Boolean @default(false)
  isAiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ActivityAssignment[]

  @@index([companyId])
  @@index([activityTypeId])
  @@index([companyId, isPublished])
}

/// Teacher assigns an Activity to a student or a whole classroom
model ActivityAssignment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @db.ObjectId
  company      Company  @relation("ActivityAssignments", fields: [companyId], references: [id])

  activityId   String   @db.ObjectId
  activity     Activity @relation(fields: [activityId], references: [id])

  assignedById String   @db.ObjectId
  assignedBy   User     @relation("ActivityAssigners", fields: [assignedById], references: [id])

  /// If null → whole classroom is assigned. If set → only this student.
  studentId    String?    @db.ObjectId
  student      Student?   @relation("StudentActivityAssignments", fields: [studentId], references: [id])

  /// Which classroom this assignment targets (used for classroom-wide assignments)
  classroomId  String?    @db.ObjectId
  classroom    Classroom? @relation("ClassroomActivityAssignments", fields: [classroomId], references: [id])

  dueDate      DateTime?
  instructions String?   // teacher's additional instructions

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts ActivityAttempt[]

  @@index([companyId])
  @@index([activityId])
  @@index([studentId])
  @@index([classroomId])
  @@index([assignedById])
}

/// Records a student's attempt / completion of an assigned activity
model ActivityAttempt {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId            String             @db.ObjectId
  company              Company            @relation("ActivityAttempts", fields: [companyId], references: [id])

  activityAssignmentId String             @db.ObjectId
  activityAssignment   ActivityAssignment @relation(fields: [activityAssignmentId], references: [id])

  studentId  String  @db.ObjectId
  student    Student @relation("StudentActivityAttempts", fields: [studentId], references: [id])

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  isCompleted Boolean   @default(false)

  /// Drawing: stores base64 or Cloudinary URL of canvas snapshot
  mediaAssetId String?     @db.ObjectId
  mediaAsset   MediaAsset? @relation("AttemptMedia", fields: [mediaAssetId], references: [id])

  /// Flexible data: puzzle score, story comprehension answers, etc.
  data Json?

  teacherNote String?  // teacher's feedback/note on this attempt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([activityAssignmentId])
  @@index([studentId])
  @@index([isCompleted])
}

// ==========================================
// FITNESS & WELLNESS EXTENSIONS
// ==========================================

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

model Equipment {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String             @db.ObjectId
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId      String?            @db.ObjectId
  location        Location?          @relation(fields: [locationId], references: [id])
  name            String
  category        String             // e.g., "Cardio", "Strength", "Free Weights", "Recovery"
  roomOrArea      String?            // e.g., "Studio 1", "Main Gym Floor"
  serialNumber    String?
  purchaseDate    DateTime?
  purchaseCost    Float?
  condition       EquipmentCondition @default(GOOD)
  status          EquipmentStatus    @default(AVAILABLE)
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  notes           String?
  imageUrl        String?

  maintenanceLogs EquipmentMaintenance[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([companyId])
  @@index([locationId])
  @@index([status])
  @@index([category])
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model EquipmentMaintenance {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String            @db.ObjectId
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  equipmentId       String            @db.ObjectId
  equipment         Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  status            MaintenanceStatus @default(SCHEDULED)
  technicianName    String?
  vendorName        String?
  cost              Float             @default(0)
  maintenanceDate   DateTime          @default(now())
  nextScheduledDate DateTime?
  notes             String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([companyId])
  @@index([equipmentId])
  @@index([status])
}

enum MembershipInterval {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model MembershipPlan {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId          String             @db.ObjectId
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String             // e.g., "All-Access Gold", "Online Only", "Weekend Warrior"
  description        String?
  price              Float
  interval           MembershipInterval @default(MONTHLY)
  durationDays       Int                @default(30)
  hasGymAccess       Boolean            @default(true)
  hasClassAccess      Boolean            @default(true)
  hasDigitalAccess   Boolean            @default(true)
  allowedLocationIds String[]           // Empty = all locations, or specific location ObjectIds
  features           String[]
  isActive           Boolean            @default(true)

  memberships        FitnessMembership[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([companyId])
  @@index([isActive])
}

enum FitnessMembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  PENDING
}

model FitnessMembership {
  id         String                  @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String                  @db.ObjectId
  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consumerId String                  @db.ObjectId
  consumer   Consumer                @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  planId     String                  @db.ObjectId
  plan       MembershipPlan          @relation(fields: [planId], references: [id])
  startDate  DateTime                @default(now())
  endDate    DateTime
  status     FitnessMembershipStatus @default(ACTIVE)
  notes      String?
  orderId    String?                 // Reference to canonical CustomerOrder if bought via shop/POS

  checkIns   GymCheckIn[]

  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([companyId])
  @@index([consumerId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

enum EntitlementTargetType {
  COURSE
  PROGRAM
  CLASS
  TRAINING_PLAN
  GENERAL_DIGITAL
}

enum EntitlementSource {
  PURCHASE
  MEMBERSHIP
  SUBSCRIPTION
  MANUAL_GRANT
  PROMOTIONAL
  TRAINER_ASSIGNMENT
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model FitnessEntitlement {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String                @db.ObjectId
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consumerId  String                @db.ObjectId
  consumer    Consumer              @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  targetType  EntitlementTargetType @default(COURSE)
  targetId    String                // Course ID, Program ID, etc.
  courseId    String?               @db.ObjectId
  course      Course?               @relation(fields: [courseId], references: [id])
  source      EntitlementSource     @default(PURCHASE)
  sourceRefId String?               // Order ID or Membership ID
  validFrom   DateTime              @default(now())
  validUntil  DateTime?             // null = lifetime access
  status      EntitlementStatus     @default(ACTIVE)

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([companyId])
  @@index([consumerId])
  @@index([targetType, targetId])
  @@index([status])
}

enum CheckInStatus {
  SUCCESS
  DENIED_NO_MEMBERSHIP
  DENIED_EXPIRED
  DENIED_WRONG_LOCATION
  DENIED_SUSPENDED
}

enum CheckInMethod {
  MANUAL_STAFF
  QR_CODE
  KIOSK
  NFC
}

model GymCheckIn {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String             @db.ObjectId
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consumerId   String             @db.ObjectId
  consumer     Consumer           @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  locationId   String?            @db.ObjectId
  location     Location?          @relation(fields: [locationId], references: [id])
  membershipId String?            @db.ObjectId
  membership   FitnessMembership? @relation(fields: [membershipId], references: [id])
  status       CheckInStatus      @default(SUCCESS)
  method       CheckInMethod      @default(MANUAL_STAFF)
  checkInTime  DateTime           @default(now())
  notes        String?

  createdAt    DateTime           @default(now())

  @@index([companyId])
  @@index([consumerId])
  @@index([locationId])
  @@index([checkInTime])
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model FitnessTrainingPlan {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String             @db.ObjectId
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  consumerId   String?            @db.ObjectId
  consumer     Consumer?          @relation(fields: [consumerId], references: [id])
  trainerId    String?            @db.ObjectId
  trainer      Educator?          @relation(fields: [trainerId], references: [id])
  status       TrainingPlanStatus @default(ACTIVE)
  weeksCount   Int                @default(4)
  difficulty   String             @default("INTERMEDIATE")
  scheduleJson Json?

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([companyId])
  @@index([consumerId])
  @@index([trainerId])
}

model FitnessExercise {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String   @db.ObjectId
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  category        String   // Cardio, Strength, Flexibility, Core, Olympic
  muscleGroup     String   // Chest, Back, Legs, Shoulders, Arms, Full Body
  equipmentNeeded String?  // Barbell, Dumbbell, Bodyweight, Cable, Machine
  difficulty      String   @default("INTERMEDIATE")
  instructions    String?
  videoUrl        String?
  imageUrl        String?
  defaultSets     Int?     @default(3)
  defaultReps     Int?     @default(10)
  restDurationSec Int?     @default(60)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([category])
  @@index([muscleGroup])
}

