// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @db.ObjectId
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model ProductCategory {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  icon          String?
  image         String?
  status        String
  brand         String[]
  allBrands     String[]
  tags          String[]
  subcategories Json // Store subcategories as a JSON array
  Product       Product[]
}

model Subcategory {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  image  String?
  status String
  brand  String[]
  tags   String[]
}

model UsersCategory {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  status String
  users  User[]
}

model Company {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  salesAgents     SalesAgent[]
  products        Product[]
  inventory       InventoryItem[]
  clients         Client[]
  productRequests Request[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           User[]
  Target          Target[]
}

model Product {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  description        String?
  category           String?
  subCategory        String?
  image              String?
  tags               String[]
  brand              String[]
  costPrice          Float
  salesPrice         Float
  companyId          String               @db.ObjectId
  company            Company              @relation(fields: [companyId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  productCategoryId  String?              @db.ObjectId
  productCategory    ProductCategory?     @relation(fields: [productCategoryId], references: [id])
  inventoryItems     InventoryItem[]
  requests           Request[]            @relation("ProductRequests")
  commissions        Commission[]
  Target             Target[]
  CommissionRate     CommissionRate?
  OrderItem          OrderItem[]
  MarketplaceListing MarketplaceListing[]
}

model Task {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  taskName    String
  dueDate     DateTime  @db.Date
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @db.ObjectId
  dueTime     String
  description String?
  icon        String?
  status      String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

model Client {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String              @unique
  phoneNumber       String?
  companyId         String              @db.ObjectId
  company           Company             @relation(fields: [companyId], references: [id])
  salesAgentId      String?             @db.ObjectId
  salesAgent        SalesAgent?         @relation(fields: [salesAgentId], references: [id])
  orders            CustomerOrder[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  communications    Communication[]     @relation("CommunicationReceiver")
  ClientInventory   ClientInventory[]
  AgentInventoryLog AgentInventoryLog[]
}

model Communication {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String     @db.ObjectId
  sender     SalesAgent @relation("CommunicationSender", fields: [senderId], references: [id])
  receiverId String     @db.ObjectId
  receiver   Client     @relation("CommunicationReceiver", fields: [receiverId], references: [id])
  subject    String?
  message    String
  createdAt  DateTime   @default(now())
}

model SalesAgent {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String               @unique
  phoneNumber        String?
  companyId          String               @db.ObjectId
  company            Company              @relation(fields: [companyId], references: [id])
  clients            Client[]
  productRequests    Request[]
  role               String               @default("Agent")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  commissions        Commission[]
  communications     Communication[]      @relation("CommunicationSender")
  Return             Return[]
  AgentInventory     AgentInventory[]
  Assignment         Assignment[]
  Target             Target[]
  ClientInventory    ClientInventory[]
  ClientInventoryLog ClientInventoryLog[]
  // manager    SalesAgent? @relation("Manager", fields: [managerId], references: [id])
  // subAgents  SalesAgent[] @relation("Manager")
}

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String         @unique
  password        String
  companyId       String?        @db.ObjectId
  company         Company?       @relation(fields: [companyId], references: [id])
  role            String         @default("User")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        Account[]
  sessions        Session[]
  usersCategory   UsersCategory? @relation(fields: [usersCategoryId], references: [id])
  usersCategoryId String?        @db.ObjectId
  tasks           Task[]
  auditLogs       AuditLog[]
  requests        Request[]
  returns         Return[]
  Assignment      Assignment[]
}

enum Status {
  PENDING
  APPROVED
  DENIED
}

model Return {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  inventoryId   String        @db.ObjectId
  inventoryItem InventoryItem @relation(fields: [inventoryId], references: [id])
  returnedById  String        @db.ObjectId
  returnedBy    SalesAgent    @relation(fields: [returnedById], references: [id])
  ApprovedBy    User?         @relation(fields: [ApprovedById], references: [id])
  ApprovedById  String?       @db.ObjectId
  quantity      Int
  reason        String?
  status        Status        @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Assignment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  ApprovedBy       User?         @relation(fields: [ApprovedById], references: [id])
  ApprovedById     String?       @db.ObjectId
  salesAgentId     String        @db.ObjectId
  salesAgent       SalesAgent    @relation(fields: [salesAgentId], references: [id])
  inventoryItemId  String        @db.ObjectId
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityAssigned Int
  reason           String? // Optional reason for assignment
  createdAt        DateTime      @default(now())
}

model InventoryItem {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  productId        String            @db.ObjectId
  product          Product           @relation(fields: [productId], references: [id])
  companyId        String            @db.ObjectId
  company          Company           @relation(fields: [companyId], references: [id])
  quantity         Int
  reorderThreshold Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inventoryLogs    InventoryLog[]
  returns          Return[]
  AgentInventory   AgentInventory[]
  Assignment       Assignment[]
  ClientInventory  ClientInventory[]
}

model InventoryLog {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  inventoryId   String        @db.ObjectId
  inventoryItem InventoryItem @relation(fields: [inventoryId], references: [id])
  damaged       Int           @default(0)
  action        String
  quantity      Int
  createdAt     DateTime      @default(now())
}

model AgentInventory {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId      String              @db.ObjectId
  salesAgent        SalesAgent          @relation(fields: [salesAgentId], references: [id])
  inventoryItemId   String              @db.ObjectId
  inventoryItem     InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  quantity          Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  AgentInventoryLog AgentInventoryLog[]
  ClientInventory   ClientInventory[]
}

model CommissionRate {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  productId      String         @unique @db.ObjectId
  product        Product        @relation(fields: [productId], references: [id])
  salesAgentId   String? // Optional for agent-specific rates
  teamId         String? // Optional for team-specific rates
  commissionType CommissionType // Enum: FIXED or PERCENTAGE
  commissionRate Float
  startDate      DateTime       @default(now())
  endDate        DateTime?
  createdAt      DateTime       @default(now())
}

model Commission {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId     String           @db.ObjectId
  salesAgent       SalesAgent       @relation(fields: [salesAgentId], references: [id])
  productId        String           @db.ObjectId
  product          Product          @relation(fields: [productId], references: [id])
  commissionRate   Float // Rate (percentage or fixed) based on criteria
  commissionEarned Float // Calculated based on the chosen criteria
  basedOn          CommissionType   @default(COST) // Define whether based on COST or QUANTITY
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  status           CommissionStatus @default(PENDING)

  @@unique([salesAgentId, productId]) // Composite unique constraint
  @@index([salesAgentId, status])
}

enum CommissionType {
  COST // Commission based on total sales value
  QUANTITY // Commission based on quantity sold
}

enum CommissionStatus {
  PENDING
  COMPLETED
  DENIED
}

model CommissionLog {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  commissionId String
  oldStatus    CommissionStatus
  newStatus    CommissionStatus
  changedBy    String
  changedAt    DateTime         @default(now())
}

model Target {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId  String       @db.ObjectId
  salesAgent    SalesAgent   @relation(fields: [salesAgentId], references: [id])
  productId     String       @db.ObjectId
  product       Product      @relation(fields: [productId], references: [id])
  targetType    TargetType   @default(COST) // Define whether target is based on COST or QUANTITY
  targetValue   Float // Value to achieve (e.g., $5000 sales or 100 units sold)
  achievedValue Float        @default(0) // Progress towards target
  startDate     DateTime
  endDate       DateTime
  status        TargetStatus @default(ONGOING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Company       Company?     @relation(fields: [companyId], references: [id])
  companyId     String?      @db.ObjectId

  @@unique([salesAgentId, productId]) // Composite unique constraint
  @@unique([salesAgentId, productId, startDate])
  @@index([salesAgentId, status, startDate, endDate])
}

enum TargetType {
  COST // Target based on total sales value
  QUANTITY // Target based on quantity sold
  REVENUE
  UNITS
  ORDERS
}

enum TargetStatus {
  ONGOING
  ACHIEVED
  EXPIRED
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  details   String?
}

enum SellerType {
  CLIENT
  CONSUMER
}

model MarketplaceListing {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  sellerId    String     @db.ObjectId // ID of either a Client or Consumer
  sellerType  SellerType
  productId   String     @db.ObjectId
  product     Product    @relation(fields: [productId], references: [id])
  title       String
  description String?
  price       Float
  quantity    Int
  image       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ClientInventory {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  clientId         String               @db.ObjectId
  rating           Float                @default(0)
  availability     Boolean              @default(true)
  client           Client               @relation(fields: [clientId], references: [id])
  inventoryItemId  String               @db.ObjectId
  inventoryItem    InventoryItem        @relation(fields: [inventoryItemId], references: [id])
  agentInventoryId String               @db.ObjectId
  agentInventory   AgentInventory       @relation(fields: [agentInventoryId], references: [id])
  salesAgentId     String               @db.ObjectId
  salesAgent       SalesAgent           @relation(fields: [salesAgentId], references: [id])
  image            String?
  newName          String               @default("New Name")
  newDescription   String?
  salesPrice       Float                @default(0)
  discount         Int?                 @default(0)
  isOnOffer        Boolean              @default(false)
  isFlashDeal      Boolean              @default(false)
  isNewArrival     Boolean              @default(false)
  isDiscounted     Boolean              @default(false)
  isFeatured       Boolean              @default(false)
  startDealDate    DateTime?
  endDealDate      DateTime?
  quantity         Int
  buyingPrice      Float // Price at which the client buys the product from the agent
  sellingPrice     Float // Price at which the client sells the product to the consumer
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  logs             ClientInventoryLog[]

  @@unique([clientId, inventoryItemId]) // Composite unique constraint
}

model ClientInventoryLog {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  clientInventoryId String          @db.ObjectId
  clientInventory   ClientInventory @relation(fields: [clientInventoryId], references: [id])
  action            String // e.g., "allocated", "returned-to-agent", "returned-to-company"
  salesAgentId      String          @db.ObjectId
  salesAgent        SalesAgent      @relation(fields: [salesAgentId], references: [id])
  quantity          Int
  price             Float
  priceType         String // "buying" or "selling"
  totalPrice        Float
  status            String //completed, pending
  damaged           Int             @default(0)
  createdAt         DateTime        @default(now())
}

model AgentInventoryLog {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  agentInventoryId String         @db.ObjectId
  agentInventory   AgentInventory @relation(fields: [agentInventoryId], references: [id])
  totalPrice       Float
  action           String // e.g., "client-return", "company-return"
  clientId         String?        @db.ObjectId
  client           Client?        @relation(fields: [clientId], references: [id])
  quantity         Int
  damaged          Int            @default(0)
  createdAt        DateTime       @default(now())
}

model SalesSummary {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId    String
  totalCommission Float
  totalSales      Float
  updatedAt       DateTime @updatedAt
}

model EventLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventType String
  entityId  String
  message   String
  createdAt DateTime @default(now())
}

model Request {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  productId       String        @db.ObjectId
  product         Product       @relation(fields: [productId], references: [id], name: "ProductRequests")
  requestedById   String        @db.ObjectId // References either a Client or a SalesAgent
  requestedByType RequesterType // Enum to indicate the type of requester
  quantity        Int
  totalPrice      Float         @default(0)
  status          Status        @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  salesAgentId    String?       @db.ObjectId // Optional, if a sales agent is involved
  salesAgent      SalesAgent?   @relation(fields: [salesAgentId], references: [id])
  companyId       String?       @db.ObjectId
  company         Company?      @relation(fields: [companyId], references: [id])
  ApprovedBy      User?         @relation(fields: [ApprovedById], references: [id])
  ApprovedById    String?       @db.ObjectId
}

// Enum for requestedByType
enum RequesterType {
  CLIENT
  SALES_AGENT
}

model Consumer {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String          @unique
  phone     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  orders    CustomerOrder[]
}

model CustomerOrder {
  id                    String      @id @default(auto()) @map("_id") @db.ObjectId
  clientId              String      @db.ObjectId
  client                Client      @relation(fields: [clientId], references: [id])
  consumerId            String      @db.ObjectId
  consumer              Consumer    @relation(fields: [consumerId], references: [id])
  items                 OrderItem[] // Relationship to multiple order items
  totalPrice            Float
  orderSource           OrderSource @default(WEBSITE)
  status                OrderStatus @default(PENDING)
  trackingNumber        String? // Optional tracking number
  estimatedArrival      DateTime? // Estimated delivery time
  deliveryStatus        String? // "Order Placed", "Processing", "Shipped", etc.
  deliveryPersonName    String? // Delivery person's name
  deliveryPersonContact String? // Delivery person's contact info
  shippingAddress       String? // Shipping address
  shippingMethod        String? // Shipping method (e.g., standard, express)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model OrderItem {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String        @db.ObjectId
  order     CustomerOrder @relation(fields: [orderId], references: [id])
  productId String        @db.ObjectId
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float // Price at the time of purchase
}

enum OrderStatus {
  PENDING
  COMPLETED
  RECURRING
  SHIPPED
  OUT_FOR_DELIVERY
  CANCELLED
}

enum OrderSource {
  WEBSITE
  IN_PERSON
  MOBILE
}
