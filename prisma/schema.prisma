// InvoiceStatus Enum for billing
enum BillingInvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

// Represents a financial invoice for services rendered to a patient.
model PatientInvoices {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  patientId String @db.ObjectId // Link to the User (patient)
  patient   User   @relation("PatientInvoices", fields: [patientId], references: [id])

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  amount      Float
  invoiceDate DateTime      @default(now())
  dueDate     DateTime? // Optional due date for payment
  status      InvoiceStatus @default(PENDING)
  items       Json[] // Store an array of objects or strings for invoice line items
  notes       String?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  BillingTransaction BillingTransaction[]

  @@index([patientId])
  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
  @@index([invoiceDate(sort: Desc)])
}

// Enum for Transaction types
enum TransactionType {
  SUBSCRIPTION
  REFUND
  ADD_ON_PURCHASE
}

// Enum for Transaction status
enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
  SUCCESS
}

// NEW: A separate model for all billing transactions
model BillingTransaction {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  userId          String            @db.ObjectId
  user            User              @relation(fields: [userId], references: [id])
  companyId       String            @db.ObjectId
  company         Company           @relation(fields: [companyId], references: [id])
  amount          Float
  currency        String            @default("USD")
  type            TransactionType
  status          TransactionStatus
  paymentMethod   String
  transactionDate DateTime          @default(now())
  description     String

  invoiceId String?          @db.ObjectId
  invoice   PatientInvoices? @relation(fields: [invoiceId], references: [id])

