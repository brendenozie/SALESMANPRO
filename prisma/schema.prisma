  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  FILL_IN_THE_BLANK
  MATCHING
  NUMERIC
}

// Enum for Course Material Type
enum CourseMaterialType {
  DOCUMENT // PDF, DOC, PPT
  VIDEO
  LINK // External website
  IMAGE
  AUDIO
  OTHER
}

// Course Material Model
// Stores links to various educational resources for a course.
model CourseMaterial {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  courseId     String             @db.ObjectId
  course       Course             @relation(fields: [courseId], references: [id])
  title        String
  description  String?
  fileUrl      String? // URL for downloadable files (PDFs, docs)
  linkUrl      String? // URL for external links (videos, websites)
  type         CourseMaterialType @default(DOCUMENT) // Enum: DOCUMENT, VIDEO, LINK, IMAGE, AUDIO
  // uploadedById String             @db.ObjectId // Educator who uploaded the material
  // uploadedBy   Educator           @relation("UploadedMaterial", fields: [uploadedById], references: [id])
  createdAt    DateTime?          @default(now())
  updatedAt    DateTime?          @updatedAt
  // Educator     Educator?          @relation(fields: [educatorId], references: [id])
  uploadedById String?            @db.ObjectId
  lesson       Lesson?            @relation(fields: [lessonId], references: [id])
  lessonId     String?            @db.ObjectId

  // educator   Educator? @relation(fields: [educatorId], references: [id])
  educatorId String? @db.ObjectId
  // educator   Educator? @relation(fields: [educatorId], references: [id])
  // educatorId String?   @db.ObjectId
  // educator   Educator? @relation(fields: [educatorId], references: [id])
  // educator   Educator? @relation(fields: [educatorId], references: [id])
  // educator   Educator? @relation(fields: [educatorId], references: [id])

  @@index([courseId, type])
  @@index([uploadedById])
  @@index([courseId])
}

// Discussion Topic Model
// Represents a discussion forum topic within a course or globally.
model DiscussionTopic {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  courseId String? @db.ObjectId // Optional: if topic is specific to a course
  course   Course? @relation(fields: [courseId], references: [id])
  title    String
  content  String? // Initial post content

  createdById String   @db.ObjectId // User (Educator or Student) who created the topic
  createdBy   Educator @relation("CreatedDiscussionTopic", fields: [createdById], references: [id])

  posts     DiscussionPost[] // All posts within this topic
  createdAt DateTime?        @default(now())
  updatedAt DateTime?        @updatedAt

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  @@index([courseId])
  @@index([createdById])
  @@index([companyId])
}

// Discussion Post Model
// Represents an individual post or reply within a discussion topic.
model DiscussionPost {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  topicId     String           @db.ObjectId
  topic       DiscussionTopic  @relation(fields: [topicId], references: [id])
  parentId    String?          @db.ObjectId // Optional: For replies to other posts
  parent      DiscussionPost?  @relation("ReplyToPost", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Self-referencing
  content     String
  createdById String           @db.ObjectId // User (Educator or Student) who created the post
  createdBy   User             @relation("CreatedDiscussionPost", fields: [createdById], references: [id])
  replies     DiscussionPost[] @relation("ReplyToPost") // Replies to this post
  createdAt   DateTime?        @default(now())
  updatedAt   DateTime?        @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  DiscussionComment DiscussionComment[]

  @@index([topicId])
  @@index([parentId])
  @@index([createdById])
  @@index([companyId])
}

model DiscussionComment {
  id     String         @id @default(auto()) @map("_id") @db.ObjectId
  postId String         @db.ObjectId
  post   DiscussionPost @relation(fields: [postId], references: [id])

  // commentId    String?             @db.ObjectId // For replies to other comments
  // comment      DiscussionComment?  @relation("ReplyToComment", fields: [commentId], references: [id])

  content String

  createdById String @db.ObjectId // User (Educator or Student) who created the comment
  createdBy   User   @relation("CreatedDiscussionComment", fields: [createdById], references: [id])

  // replies DiscussionComment[] @relation("ReplyToComment") // Replies to this comment

  createdAt           DateTime? @default(now())
  updatedAt           DateTime? @updatedAt
  // DiscussionComment   DiscussionComment? @relation("ReplyToComment", fields: [discussionCommentId], references: [id])
  discussionCommentId String?   @db.ObjectId

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  @@index([postId])
  // @@index([commentId])
  @@index([createdById])
  @@index([discussionCommentId])
  @@index([companyId])
}

// Department Model
// Represents an academic or administrative department within the school.
model Department {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String // e.g., "Mathematics", "English", "Administration"
  description String?

  headId String?   @db.ObjectId // Optional: Link to the User (Educator/Admin) who heads the department
  head   Educator? @relation("DepartmentHead", fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  educators Educator[] // Educators belonging to this department
  courses   Course[] // Courses offered by this department

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  Company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@unique([companyId, name])
  @@index([name])
  @@index([companyId])
}

// Grade Model
// Represents a student's grade for a specific course or exam.
model Grade {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  studentId String  @db.ObjectId
  student   Student @relation(fields: [studentId], references: [id])

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  examId String? @db.ObjectId // Optional: Grade might not be tied to a specific exam
  exam   Exam?   @relation(fields: [examId], references: [id])

  courseAssignmentId String?           @db.ObjectId // Optional: Grade might not be tied to a specific exam
  courseAssignment   CourseAssignment? @relation(fields: [courseAssignmentId], references: [id])

  score       Float
  gradeValue  String? // e.g., "A", "B+", "Pass"
  gradeStatus GradeStatus? // Enum: PASSED, FAILED, PENDING
  comments    String?

  academicYearId String?       @db.ObjectId
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  termId String? @db.ObjectId
  term   Term?   @relation(fields: [termId], references: [id])

  recordedById String?   @db.ObjectId // Educator who recorded this grade
  recordedBy   Educator? @relation("recordedBy", fields: [recordedById], references: [id])

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  // NEW FIELD: Link to the academic level the student was in when this grade was recorded
  // This is crucial for historical reporting by academic level.
  academicLevelAtTimeOfGradingId String?        @db.ObjectId
  academicLevelAtTimeOfGrading   AcademicLevel? @relation("gradesEarned", fields: [academicLevelAtTimeOfGradingId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // @@unique([studentId, courseId, examId])
  // @@unique([studentId, courseId, courseAssignmentId])
  @@index([studentId, courseId, examId]) // For efficient lookup of a student's grade for a specific course/exam
  @@index([studentId, courseId, courseAssignmentId]) // For efficient lookup of a student's grade for a specific course assignment
  @@index([courseId])
  @@index([examId])
  @@index([recordedById])
  @@index([companyId])
  @@index([academicLevelAtTimeOfGradingId]) // Add index for efficient querying by academic level
  @@index([courseAssignmentId]) // Add index for efficient querying by academic level
}

enum GradeStatus {
  PASSED
  FAILED
  PENDING
}

model UserActivity {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  userId               String               @db.ObjectId
  user                 User                 @relation(fields: [userId], references: [id])
  activityType         String // e.g., "LOGIN", "PRODUCT_VIEW", "ORDER_PLACED"
  details              Json? // JSON object for additional context
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime?            @default(now())
  marketplaceListings  marketplaceListings? @relation(fields: [marketplaceListingId], references: [id])
  marketplaceListingId String?              @db.ObjectId

  @@index([userId])
  @@index([activityType])
  @@index([marketplaceListingId])
}

model ProductMetrics {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  metricType String // e.g., "VIEW_COUNT", "ADD_TO_CART_COUNT", "PURCHASE_COUNT"
  value      Float
  date       DateTime // Date for which the metric is recorded

  createdAt            DateTime?            @default(now())
  updatedAt            DateTime?            @updatedAt
  marketplaceListings  marketplaceListings? @relation(fields: [marketplaceListingId], references: [id])
  marketplaceListingId String?              @db.ObjectId

  @@index([productId])
  @@index([metricType])
  @@index([date])
  @@index([marketplaceListingId])
}

// New model for managing Projects
model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus @default(ONGOING) // Define ProjectStatus enum below
  budget      Float?
  companyId   String?       @db.ObjectId // Link to Company if projects are company-specific
  company     Company?      @relation(fields: [companyId], references: [id])
  mediaUrls   String?

  // Relationships
  tasks     Task[]
  events    Event[]
  donations Donation[] // Link donations to projects
  members   ProjectMember[] // Many-to-many relationship with Users for project members

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Enum for Project Status
enum ProjectStatus {
  PLANNING
  ONGOING
  COMPLETED
  ARCHIVED
  CANCELLED
}

// Join table for Project Members (Many-to-Many between Project and User)
model ProjectMember {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  projectId String @db.ObjectId
  userId    String @db.ObjectId
  role      String // e.g., "Manager", "Contributor", "Viewer"

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId]) // Ensures a user can only have one role per project
  @@index([projectId])
  @@index([userId])
}

// New model for managing Donation Campaigns
model Campaign {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  goalAmount    Float?
  currentAmount Float?         @default(0) // Track how much has been raised
  status        CampaignStatus @default(ACTIVE) // Define CampaignStatus enum below

  donations Donation[] // Link donations to campaigns

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Enum for Campaign Status
enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

// New model for managing Donations
model Donation {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  donorId            String         @db.ObjectId
  donor              Donor          @relation(fields: [donorId], references: [id])
  amount             Float
  currency           String         @default("USD")
  donationDate       DateTime       @default(now())
  paymentMethod      String? // e.g., "Credit Card", "M-Pesa", "Bank Transfer"
  notes              String?
  status             DonationStatus @default(SUCCESS) // Define DonationStatus enum below
  acknowledgmentSent Boolean        @default(false)

  // Optional relationships to projects and campaigns
  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  campaignId String?   @db.ObjectId
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  transactionId String? @unique // Optional: ID from payment gateway

  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId

  @@index([donorId])
  @@index([projectId])
  @@index([campaignId])
  // @@index([transactionId])
  @@index([userId])
  @@index([status])
}

// Enum for Donation Status
enum DonationStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

