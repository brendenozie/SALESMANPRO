// ============================================================
// LIBRARY MANAGEMENT MODELS
// ============================================================

model LibraryCategory {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String        @unique
  companyId    String        @db.ObjectId
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  libraryBooks LibraryBook[]

  @@index([companyId])
}

model LibraryBook {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  author       String
  isbn         String?              @unique
  publisher    String?
  categoryId   String               @db.ObjectId
  category     LibraryCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status       LibraryBookStatus    @default(AVAILABLE)
  location     String? // Shelf/Section location
  companyId    String               @db.ObjectId
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  issuances    LibraryIssuance[]
  reservations LibraryReservation[]

  // New Inventory Fields
  shelfLocation String   @default("Unassigned")
  integrity     Int      @default(100) // 0-100 percentage
  condition     String   @default("Good") // Mint, Good, Fair, Poor
  lastAudit     DateTime @default(now())

  @@index([companyId])
  @@index([status])
}

enum LibraryMemberStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model LibraryMember {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Connect to existing profiles
  studentId String?  @unique @db.ObjectId
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  educatorId String?   @unique @db.ObjectId
  educator   Educator? @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  memberId String              @unique // The "LIB-XXXX" barcode/ID
  status   LibraryMemberStatus @default(ACTIVE)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  libraryIssuances    LibraryIssuance[]
  libraryReservations LibraryReservation[]

  @@index([companyId])
}

model LibraryIssuance {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  bookId          String                @db.ObjectId
  book            LibraryBook           @relation(fields: [bookId], references: [id], onDelete: Restrict)
  companyId       String                @db.ObjectId
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  issuedDate      DateTime              @default(now())
  isDamaged       Boolean               @default(false)
  dueDate         DateTime
  returnDate      DateTime?
  status          LibraryIssuanceStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  fines           LibraryFine[]
  libraryMember   LibraryMember?        @relation(fields: [libraryMemberId], references: [id])
  libraryMemberId String?               @db.ObjectId

  @@index([bookId])
  @@index([companyId])
  @@index([status])
}

model LibraryFine {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  issuanceId String            @db.ObjectId
  issuance   LibraryIssuance   @relation(fields: [issuanceId], references: [id], onDelete: Cascade)
  amount     Float
  reason     String?
  status     LibraryFineStatus @default(PENDING)
  paidDate   DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([issuanceId])
  @@index([status])
}

model LibraryReservation {
  id              String                   @id @default(auto()) @map("_id") @db.ObjectId
  bookId          String                   @db.ObjectId
  book            LibraryBook              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reservationDate DateTime                 @default(now())
  expiryDate      DateTime
  status          LibraryReservationStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  libraryMember   LibraryMember?           @relation(fields: [libraryMemberId], references: [id])
  libraryMemberId String?                  @db.ObjectId

  @@index([bookId])
  @@index([status])
}

model LibrarySupplierCategory {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String  @unique
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  librarySuppliers LibrarySupplier[]

  @@index([companyId])
}

model LibrarySupplier {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  categoryId   String?                  @db.ObjectId
  category     LibrarySupplierCategory? @relation(fields: [categoryId], references: [id])
  address      String?
  contactEmail String                   @unique
  phone        String?
  leadTime     String                   @default("7 Days")
  reliability  Int                      @default(100) // Percentage 0-100
  status       String                   @default("Active") // Active, Under Review, Inactive

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model LibraryAcquisition {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title    String
  qty      Int
  cost     Float
  vendor   String
  status   String  @default("Requested") // Requested, Processing, In Transit, Received
  category String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ============================================================
// TRANSPORT MANAGEMENT MODELS
// ============================================================

model TransportVehicle {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  registration    String                 @unique
  make            String
  model           String
  mileage         Float?                 @default(0) // Total mileage of the vehicle
  year            Int? // Manufacturing year of the vehicle
  type            TransportVehicleType
  status          TransportVehicleStatus @default(ACTIVE)
  capacity        Int // Number of passengers
  companyId       String                 @db.ObjectId
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  routes          TransportRoute[]
  maintenances    TransportMaintenance[]
  fuelLogs        TransportFuelLog[]
  transportShifts TransportShift[]
  deliveries      Delivery[]
  incidents       TransportIncident[]

  @@index([companyId])
  @@index([status])
  @@index([type])
}

model TransportRoute {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  startPoint      String
  endPoint        String
  stops           Json? // Array of stop locations
  companyId       String                @db.ObjectId
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId       String?               @db.ObjectId // Default vehicle for this route
  vehicle         TransportVehicle?     @relation(fields: [vehicleId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  assignments     TransportAssignment[]
  transportShifts TransportShift[]
  deliveries      Delivery[]

  @@index([companyId])
  @@index([vehicleId])
}

model TransportMaintenance {
  id            String                     @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId     String                     @db.ObjectId
  vehicle       TransportVehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  description   String
  scheduledDate DateTime
  completedDate DateTime?
  cost          Float?
  status        TransportMaintenanceStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

model TransportFuelLog {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId String           @db.ObjectId
  vehicle   TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime         @default(now())
  quantity  Float // Liters
  cost      Float
  odometer  Float? // Reading at time of refueling
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([vehicleId])
  @@index([date])
}

model TransportAssignment {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  routeId   String         @db.ObjectId
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  userId    String         @db.ObjectId // Student or staff member
  user      User           @relation("TransportAssignments", fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime       @default(now())
  endDate   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([routeId])
  @@index([userId])
}

model TransportShift {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  startTime DateTime
  endTime   DateTime
  status    String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED

  routeId String         @db.ObjectId
  route   TransportRoute @relation(fields: [routeId], references: [id])

  driverId String          @db.ObjectId
  driver   TransportDriver @relation(fields: [driverId], references: [id])

  vehicleId String           @db.ObjectId
  vehicle   TransportVehicle @relation(fields: [vehicleId], references: [id])

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId

  @@index([companyId, startTime])
  @@index([driverId])
  @@index([vehicleId])
}

model TransportDriver {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNo       String    @unique
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  idImgUrl        String? // URL to driver's ID image
  licenseImgUrl   String? // URL to driver's license image
  licenseExpiry   DateTime?
  experienceYears Int       @default(0)
  loginCode       String?   @unique // For driver app login

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  transportShifts TransportShift[]
  deliveries      Delivery[]
  incidents       TransportIncident[]

  @@index([companyId])
  @@index([status])
}

// ============================================================
// HOSTEL MANAGEMENT MODELS
// ============================================================

model HostelBlock {
  id         String               @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  type       HostelBlockType
  companyId  String               @db.ObjectId
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId String?              @db.ObjectId
  property   marketplaceListings? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  rooms      HostelRoom[]

  @@index([companyId])
  @@index([type])
}

model HostelRoom {
  id                  String                     @id @default(auto()) @map("_id") @db.ObjectId
  blockId             String                     @db.ObjectId
  block               HostelBlock                @relation(fields: [blockId], references: [id], onDelete: Cascade)
  roomNumber          String
  capacity            Int
  type                HostelRoomType
  rentPerMonth        Float                      @default(0)
  isAvailable         Boolean                    @default(true)
  floor               Int?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  allocations         HostelAllocation[]
  maintenanceRequests HostelMaintenanceRequest[]
  hostelFees          HostelFee[]

  @@unique([blockId, roomNumber])
  @@index([blockId])
  @@index([type])
}

enum HostelMemberStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model HostelMember {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Connect to existing profiles
  studentId String?  @unique @db.ObjectId
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  educatorId String?   @unique @db.ObjectId
  educator   Educator? @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  consumerId String?   @unique @db.ObjectId
  consumer   Consumer? @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  memberId String             @unique // The "LIB-XXXX" barcode/ID
  status   HostelMemberStatus @default(ACTIVE)

  accountBalance Float @default(0) // Tracks advance payments

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  hostelAllocations HostelAllocation[]
  hostelVisitors    HostelVisitor[]
  hostelFees        HostelFee[]

  @@index([companyId])
}

model HostelAllocation {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  roomId         String                 @db.ObjectId
  room           HostelRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate      DateTime               @default(now())
  endDate        DateTime?
  status         HostelAllocationStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  hostelMember   HostelMember?          @relation(fields: [hostelMemberId], references: [id])
  hostelMemberId String?                @db.ObjectId

  @@index([roomId])
  @@index([hostelMemberId])
  @@index([status])
}

model HostelMaintenanceRequest {
  id           String                           @id @default(auto()) @map("_id") @db.ObjectId
  roomId       String                           @db.ObjectId
  room         HostelRoom                       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reportedBy   String                           @db.ObjectId // User who reported
  reporter     User                             @relation("HostelMaintenanceRequests", fields: [reportedBy], references: [id], onDelete: Cascade)
  category     String
  description  String
  priority     HostelMaintenanceRequestPriority @default(MEDIUM)
  status       HostelMaintenanceRequestStatus   @default(PENDING)
  resolvedDate DateTime?
  notes        String?
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt

  @@index([roomId])
  @@index([reportedBy])
  @@index([status])
  @@index([priority])
}

model HostelVisitor {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  contactNumber String?
  relation      String

  // Relations
  studentId String?  @db.ObjectId
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Identity & Security
  idType     String // National ID, Passport, etc.
  idNumber   String?
  idImageUrl String?

  // Timing & Status
  status   String    @default("ACTIVE") // ACTIVE, CHECKED_OUT
  checkIn  DateTime  @default(now())
  checkOut DateTime?

  educatorId String?   @db.ObjectId
  educator   Educator? @relation(fields: [educatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostelMember   HostelMember? @relation(fields: [hostelMemberId], references: [id])
  hostelMemberId String?       @db.ObjectId

  @@index([studentId])
  @@index([companyId])
  @@index([checkIn])
}

model HostelStaff {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  staffId     String    @unique // The "Badge Number" (e.g., STF-001)
  name        String
  phoneNumber String
  role        StaffRole @default(WARDEN)
  shiftLabel  String // e.g., "Day (08:00 - 16:00)"
  isOnDuty    Boolean   @default(false)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  // Relations
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([role])
}

enum StaffRole {
  WARDEN
  SECURITY
  CLEANER
  MAINTENANCE
}

enum FeeStatus {
  PAID
  OVERDUE
  PARTIAL
  PENDING
}

model HostelFee {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String @unique // e.g., INV-2026-01
  companyId     String @db.ObjectId

  hostelMemberId String       @db.ObjectId
  hostelMember   HostelMember @relation(fields: [hostelMemberId], references: [id], onDelete: Cascade)

  roomId String     @db.ObjectId
  room   HostelRoom @relation(fields: [roomId], references: [id])

  rentAmount  Float
  messAmount  Float
  totalAmount Float

  amountPaid Float     @default(0) // Tracks how much of THIS invoice is paid
  status     FeeStatus @default(PENDING) // PAID, OVERDUE, PARTIAL, PENDING

  dueDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([hostelMemberId])
  @@index([status])
}

// ============================================================
// STAFF MANAGEMENT (HR) MODELS
// ============================================================

model StaffLeave {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  userId       String           @db.ObjectId
  user         User             @relation("StaffLeaves", fields: [userId], references: [id], onDelete: Cascade)
  companyId    String           @db.ObjectId
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveType    StaffLeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       StaffLeaveStatus @default(PENDING)
  approvedBy   String?          @db.ObjectId
  approver     User?            @relation("ApprovedLeaves", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedDate DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([approvedBy])
}

model StaffPayroll {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  userId      String             @db.ObjectId
  user        User               @relation("StaffPayrolls", fields: [userId], references: [id], onDelete: Cascade)
  companyId   String             @db.ObjectId
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  month       Int // 1-12
  year        Int
  basicSalary Float
  allowances  Float              @default(0)
  deductions  Float              @default(0)
  netSalary   Float
  status      StaffPayrollStatus @default(DRAFT)
  paymentDate DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  salaryHistory SalaryHistory[] // Relation to history

  @@unique([userId, month, year])
  @@index([userId])
  @@index([companyId])
  @@index([status])
}

// 1. Leave Policy: Defines how many days are allowed per type (Annual, Sick, etc.)
model LeavePolicy {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String @db.ObjectId
  leaveType   String // e.g., "ANNUAL", "SICK", "MATERNITY"
  daysAllowed Int    @default(21)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, leaveType])
}

// 2. Leave Request: The core transaction model
model LeaveRequest {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @db.ObjectId
  userId    String @db.ObjectId

  type          String // ANNUAL, SICK, etc.
  startDate     DateTime
  endDate       DateTime
  daysRequested Int
  reason        String?
  status        LeaveStatus @default(PENDING) // PENDING, APPROVED, DECLINED

  // Backup coverage
  backupStaffId String?       @db.ObjectId
  backupStaff   StaffProfile? @relation("BackupCoverage", fields: [backupStaffId], references: [id])

  adminNote String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
}

// 3. Leave Freeze: Prevents requests during specific periods
model LeaveFreeze {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String   @db.ObjectId
  label           String // e.g., "End of Year Exams"
  startDate       DateTime
  endDate         DateTime
  departmentScope String   @default("ALL") // "ALL" or specific Dept Name

  createdAt DateTime @default(now())
}

model SalaryHistory {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  staffProfileId String       @db.ObjectId
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id])

  previousSalary Float
  newSalary      Float
  changeReason   String? // e.g., "Annual Promotion", "Market Adjustment"
  changedBy      String   @db.ObjectId // Admin User ID
  effectiveDate  DateTime @default(now())

  createdAt      DateTime      @default(now())
  staffPayroll   StaffPayroll? @relation(fields: [staffPayrollId], references: [id])
  staffPayrollId String?       @db.ObjectId

  @@index([staffProfileId])
}

model StaffPerformanceReview {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  employeeId   String                 @db.ObjectId // User being reviewed
  employee     User                   @relation("EmployeePerformanceReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String                 @db.ObjectId // User conducting the review
  reviewer     User                   @relation("ReviewerPerformanceReviews", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewDate   DateTime               @default(now())
  reviewPeriod String // e.g., "Q1 2024", "Annual 2024"
  rating       StaffPerformanceRating
  strengths    String?
  weaknesses   String?
  comments     String?
  goals        String? // Future goals
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([employeeId])
  @@index([reviewerId])
}

// Enums for standardizing data
enum StaffAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

enum StaffAttendanceMethod {
  BIOMETRIC
  GEO_FENCE
  MANUAL_OVERRIDE
  WEB_PORTAL
}

model StaffAttendanceRecord {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  date         DateTime // Canonical date (e.g., 2024-05-20 00:00:00)
  checkInTime  DateTime?
  checkOutTime DateTime?
  imageUrl     String? // URL to the captured image at check-in/out
  lat          Float? // Latitude for geofencing
  lng          Float? // Longitude for geofencing

  accuracy Float? // Accuracy of the geofence location in meters

  status StaffAttendanceStatus @default(PRESENT)
  method StaffAttendanceMethod @default(WEB_PORTAL)

  // Storage for manual entry details
  isManual  Boolean @default(false)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // One attendance record per user per day
  @@index([companyId, date])
}

// Optional: Detailed audit trail for every single clock action
model StaffAttendanceAuditLog {
  id        String                @id @default(auto()) @map("_id") @db.ObjectId
  userId    String                @db.ObjectId
  companyId String                @db.ObjectId
  type      String // "IN" or "OUT"
  timestamp DateTime
  method    StaffAttendanceMethod
  note      String?
  adminId   String?               @db.ObjectId // Who performed the override
}

model candidate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  phone     String?
  position  String
  resumeUrl String?
  status    String   @default("Applied") // Applied, Interviewing, Offered, Rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])
}

