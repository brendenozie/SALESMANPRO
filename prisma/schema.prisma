// Submission Model (Student's assignment submission)
model AssignmentSubmission {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  assignmentId String           @db.ObjectId // Foreign key to CourseAssignment
  assignment   CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade) // CRITICAL: onDelete: Cascade

