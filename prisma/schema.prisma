model TransportVehicle {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  registration    String                 @unique
  make            String
  model           String
  type            TransportVehicleType
  status          TransportVehicleStatus @default(ACTIVE)
  capacity        Int // Number of passengers
  companyId       String                 @db.ObjectId
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  routes          TransportRoute[]
  maintenances    TransportMaintenance[]
  fuelLogs        TransportFuelLog[]
  transportShifts TransportShift[]

  @@index([companyId])
  @@index([status])
  @@index([type])
}

model TransportRoute {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  startPoint      String
  endPoint        String
  stops           Json? // Array of stop locations
  companyId       String                @db.ObjectId
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId       String?               @db.ObjectId // Default vehicle for this route
  vehicle         TransportVehicle?     @relation(fields: [vehicleId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  assignments     TransportAssignment[]
  transportShifts TransportShift[]

  @@index([companyId])
  @@index([vehicleId])
}

model TransportMaintenance {
  id            String                     @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId     String                     @db.ObjectId
  vehicle       TransportVehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  description   String
  scheduledDate DateTime
  completedDate DateTime?
  cost          Float?
  status        TransportMaintenanceStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

model TransportFuelLog {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId String           @db.ObjectId
  vehicle   TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime         @default(now())
  quantity  Float // Liters
  cost      Float
  odometer  Float? // Reading at time of refueling
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([vehicleId])
  @@index([date])
}

model TransportAssignment {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  routeId   String         @db.ObjectId
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  userId    String         @db.ObjectId // Student or staff member
  user      User           @relation("TransportAssignments", fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime       @default(now())
  endDate   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([routeId])
  @@index([userId])
}

model TransportShift {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  startTime DateTime
  endTime   DateTime
  status    String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED

  routeId String         @db.ObjectId
  route   TransportRoute @relation(fields: [routeId], references: [id])

  driverId String          @db.ObjectId
  driver   TransportDriver @relation(fields: [driverId], references: [id])

  vehicleId String           @db.ObjectId
  vehicle   TransportVehicle @relation(fields: [vehicleId], references: [id])

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId

  @@index([companyId, startTime])
  @@index([driverId])
  @@index([vehicleId])
}

model TransportDriver {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNo       String    @unique
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  idImgUrl        String? // URL to driver's ID image
