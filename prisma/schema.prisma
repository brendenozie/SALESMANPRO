// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum ROLE {
  USER
  CONSUMER
  AGENT
  CLIENT
  ADMIN
  STUDENT
  EDUCATOR
  HEADTEACHER
  PARENT
  JUNIOR
  SENIOR
  SOPHOMORE
  FRESHMAN
  WRITER
  STAFF
}

enum StudentLevelStatus {
  JUNIOR
  SENIOR
  SOPHOMORE
  FRESHMAN
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @db.ObjectId
  role         ROLE?    @default(USER)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  createdAt DateTime? @default(now())
  read      Boolean   @default(false)
  Company   Company?  @relation(fields: [companyId], references: [id])
  companyId String?   @db.ObjectId
}

model CompanyCategory {
  id      String    @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  icon    String?
  image   String?
  status  String
  Company Company[]
}

// Category model with self-relations for hierarchy (categories & subcategories)
model ProductCategory {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  icon            String?
  image           String?
  slug            String    @unique
  description     String
  longDescription String
  seoTitle        String
  seoDescription  String
  metaKeywords    String[]
  sortOrder       Int
  visible         Boolean
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  createdBy       String
  updatedBy       String
  status          String
  allBrands       String[]
  tags            String[]

  // Hierarchy pointers
  subcategories Json // Store subcategories as a JSON array

  // Media & SEO assets
  imageAlt    String
  thumbnail   String?
  bannerImage String?

  // Localization
  localization Json

  // Dynamic fields
  productCount   Int
  isFeatured     Boolean
  showInHomepage Boolean

  // Custom attributes
  attributes Json

  Product             Product[]
  marketplaceListings marketplaceListings[]
  StoreCategory       StoreCategory[]
  Company             Company?              @relation(fields: [companyId], references: [id])
  companyId           String?               @db.ObjectId
  Podcast             Podcast[]
}

/// Associates a Company with a ProductCategory,
/// plus any store-specific settings.
model StoreCategory {
  company    Company         @relation(fields: [companyId], references: [id])
  companyId  String          @db.ObjectId
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId String          @db.ObjectId

  // Store-specific overrides:
  displayName String? // e.g. “Gadgets” instead of “Tech Gadgets”
  icon        String? // override the global icon
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)

  id String @id @default(auto()) @map("_id") @db.ObjectId // Add a single primary key

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // You still store each category’s children in JSON:
  items     Json? // e.g. [ { id: "...", name: "...", slug: "...", … }, … ]
  allBrands Json? // e.g. [ { id: "...", name: "...", slug: "...", … }, … ]

  // @@id([companyId, categoryId])
  @@unique([companyId, categoryId]) // Use a unique constraint instead
  @@index([companyId, sortOrder]) // speed up ordering queries
}

model Company {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  tagline     String? // short marketing line
  description String?

  hasWebsite Boolean? @default(false)

  companyCategoryId String?          @db.ObjectId
  companyCategory   CompanyCategory? @relation(fields: [companyCategoryId], references: [id])
  category          String
  logoUrl           String?
  bannerUrl         String?

  contactEmail String
  contactPhone String?
  site         String? @default("default")
  address      String?
  geoLocation  Json? // { lat: number, lng: number }
  openingHours Json? // { mon: "9–5", tue: "...", … }
  domain       String? @unique
  currency     String  @default("KES")
  locale       String  @default("en-US")

  pricingTiers Json[] // ServicePricingTier name, description, price, duration, features[]

  themeSettings Json? // colors, fonts, layout toggles
  seo           SEO?  @relation(fields: [sEOId], references: [id]) // SEO settings

  // existing relations
  user   User?   @relation(name: "companyAdmin", fields: [userId], references: [id])
  userId String? @db.ObjectId

  // inventory InventoryItem[]

  productRequests Request[]
  Target          Target[]
  commissions     Commission[]
  commissionsRate CommissionRate[]

  // adminUserId String? @db.ObjectId // Optional: Link to the initial admin user of the company
  // adminUser   User?   @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  deletedAt DateTime?
  sEOId     String?   @db.ObjectId

  analyticsConfig   AnalyticsConfig? @relation(fields: [analyticsConfigId], references: [id])
  analyticsConfigId String?          @db.ObjectId

  paymentSettings   PaymentSettings? @relation(fields: [paymentSettingsId], references: [id])
  paymentSettingsId String?          @db.ObjectId

  shippingSettings   ShippingSettings? @relation(fields: [shippingSettingsId], references: [id])
  shippingSettingsId String?           @db.ObjectId

  awards  Json?
  metrics Json?
  stats   Json?

  StoreCategory StoreCategory[]

  PageSection  PageSection[]
  Collection   Collection[]
  socialLinks  SocialLink[] // structured social profiles
  policies     Policy[] // structured, editable policies
  faqs         FAQ[] // common questions
  testimonials Testimonial[] // customer quotes
  promotions   Promotion[] // site-wide deals
  Announcement Announcement[]
  Conversation Conversation[]

  productCategories ProductCategory[]

  marketplaceListings marketplaceListings[]
  Product             Product[]

  customerOrders CustomerOrder[]
  inventoryItems InventoryItem[]

  salesAgents SalesAgent[]
  clients     Client[]
  consumers   Consumer[]
  educators   Educator[]
  students    Student[]
  parents     Parent[]
  HeadTeacher HeadTeacher[]

  academicLevels AcademicLevel[]
  courses        Course[]
  departments    Department[]

  blogs    Blog[]
  seoBlogs SeoBlog[]

  notifications Notification[]

  heroSlides Banner[]
  appPromos  AppPromo[]

  events           Event[]
  tasks            Task[]
  locations        Locations[]
  discussionTopics DiscussionTopic[]

  attendanceRecords AttendanceRecord[]

  exams                           Exam[]
  grades                          Grade[] // Grades are now directly linked to a company
  classSchedules                  ClassSchedule[]
  EducatorAcademicLevelAssignment EducatorAcademicLevelAssignment[]
  CourseEducatorAssignment        CourseEducatorAssignment[]
  CourseAcademicLevel             CourseAcademicLevel[]
  CourseEnrollment                CourseEnrollment[]
  CourseAssignment                CourseAssignment[]
  AssignmentSubmission            AssignmentSubmission[]
  EventRegistration               EventRegistration[]
  DiscussionPost                  DiscussionPost[]
  DiscussionComment               DiscussionComment[]
  Project                         Project[]
  Doctor                          Doctor[]
  Writer                          Writer[]
  Podcast                         Podcast[]
  Donor                           Donor[]
  CompanyLocation                 CompanyLocation[]
  Inquiry                         Inquiry[]
  Showing                         Showing[]
  OfferContract                   OfferContract[]
  Appointment                     Appointment[]
  staffMembers                    StaffProfile[]
  services                        Service[]
  prescriptions                   Prescription[]
  PatientInvoices                 PatientInvoices[]
}

enum CategoryStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model SocialLink {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  company   Company       @relation(fields: [companyId], references: [id])
  companyId String        @db.ObjectId
  channel   SocialChannel
  url       String
}

model Policy {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  company   Company    @relation(fields: [companyId], references: [id])
  companyId String     @db.ObjectId
  type      PolicyType
  title     String?
  content   String
}

model FAQ {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId
  question  String
  answer    String
  order     Int     @default(0)
}

model Testimonial {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId
  author    String
  quote     String
  avatarUrl String?
  rating    Int? // 1–5 stars
  order     Int     @default(0)
}

model Banner {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  imageUrl        String
  productImageUrl String?
  headline        String?
  subline         String?
  ctaText         String?
  ctaLink         String?
  badgeText       String?
  price           String?
  endsAt          DateTime?
  order           Int       @default(0)
}

model Promotion {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   String    @db.ObjectId
  code        String?
  title       String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  ctaText     String?
  ctaLink     String?
  bannerUrl   String?
}

model AnalyticsConfig {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  googleTag   String?
  facebookTag String?

  hotjarSiteId String?

  isActive Boolean @default(false)

  Company Company[]
}

model PaymentSettings {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  stripeKey           String?
  paypalKey           String?
  mpesaShortcode      String?
  mpesaConsumerKey    String?
  mpesaConsumerSecret String?
  mpesaCallbackUrl    String?
  Company             Company[]
}

model ShippingSettings {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  carrierName        String?
  trackingUrl        String?
  regions            Json?
  enablePickup       Boolean?
  pickupInstructions String?
  Company            Company[]
}

model PageSection {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  company   Company     @relation(fields: [companyId], references: [id])
  companyId String      @db.ObjectId
  type      SectionType
  order     Int         @default(0)
  settings  Json // e.g. { background: "dark", padding: "xl" }
  content   Json // e.g. { headline: "...", blocks: [ ... ] }
  createdAt DateTime?   @default(now())
  updatedAt DateTime?   @updatedAt
}

enum SectionType {
  Hero
  FeatureGrid
  TestimonialCarousel
  BlogPreview
  CustomHtml
  About
  Services
  Awards
  HealthTips
  Features
  HowItWorks
  Pricing
  CTA
  Metrics
  Stats
  // …add more as needed
}

enum SocialChannel {
  TWITTER
  INSTAGRAM
  FACEBOOK
  LINKEDIN
}

enum PolicyType {
  SHIPPING
  RETURNS
  PRIVACY
  TERMS
}

model Locations {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  Company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId
}

model AppPromo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String?  @db.ObjectId
  company     Company? @relation(fields: [companyId], references: [id])
  headline    String
  subheading  String
  buttons     Json // e.g. [{ label: "Download", href: "...", icon: "apple" }]
  screenshots String[] // array of image URLs
}

// Use your actual enum definitions if they exist in your schema.prisma
// For demonstration, I'm assuming 'ListingStatus' is defined elsewhere.
// If not, you'll need to define it:
enum ListingStatus {
  ACTIVE
  PENDING
  SOLD
  INACTIVE
  DRAFT
  REJECTED
  BUY
  RENT
  RENTED
}

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  longDescription String? // Added: From General Details section
  category        String? // Consider making this an enum or relation if fixed categories
  subCategory     Json? // Consider a specific model if structure is fixed
  subCategoryName String? // Added: From General Details
  images          Json[] // Store URLs or paths
  video           String?
  tags            String[] // Array of strings for search/filtering
  brand           String?

  // Company relation
  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  // Product Category relation
  productCategoryId String?          @db.ObjectId
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id])

  // Inventory & Request Management
  inventoryItems      InventoryItem[]
  requests            Request[]             @relation("ProductRequests")
  commissions         Commission[]
  Target              Target[]
  CommissionRate      CommissionRate?
  marketplaceListings marketplaceListings[]

  // General Specifications (from General Details)
  model      String?
  color      String[] // Array of colors (e.g., ["Red", "Blue"])
  size       String[] // Array of sizes (e.g., ["S", "M", "L"])
  weight     String[] // e.g., "5 kg"
  condition  String? // e.g., "New", "Used", "Refurbished"
  dimensions String? // e.g., "10x5x2 cm" - Renamed from 'dimension' for consistency
  material   String[] // Array for multiple materials, or a single String for one

  // Pricing & Quantity
  quantity     Int    @default(1) // Default to 1
  costPrice    Float  @default(0)
  sellingPrice Float  @default(0)
  discount     Int    @default(0) // Percentage (0-100)
  finalPrice   Float  @default(0) // Price after discount
  profitMargin Float  @default(0) // Calculated profit margin
  pricingTiers Json[] // Added: For complex pricing structures (e.g., [{ quantity: 5, price: 9.99 }])

  // Deal Specifics
  isOnOffer    Boolean @default(false)
  isFlashDeal  Boolean @default(false)
  isDiscounted Boolean @default(false)

  startDealDate DateTime?
  endDealDate   DateTime?

  // Flags
  isAvailable  Boolean @default(true)
  isNewArrival Boolean @default(false)
  isFeatured   Boolean @default(false)

  // Vehicle Specifics (Engine & Performance, Ownership & Pricing)
  make String?
  trim String?
  type String?

  mileage    String? // e.g., "50000 km"
  engineType String? // e.g., "V6", "Inline-4"
  engineSize Float? // e.g., 3.5 (for 3.5L) - Changed to Float
  horsepower Int? // Added: Horsepower (e.g., 250) - Changed to Int

  torque       Int? // Added: Torque (e.g., 280) - Changed to Int
  fuelType     String? // Added: e.g., "Petrol", "Electric"
  fuelEconomy  String? // Added: e.g., "7.5 L/100km", "32 MPG"
  transmission String? // e.g., "Automatic", "Manual"
  drivetrain   String? // e.g., "FWD", "RWD", "AWD"

  vin            String? // Vehicle Identification Number
  logbookStatus  String? // e.g., "Available", "Missing"
  serviceHistory String? // e.g., "Full", "Partial", "None"
  negotiable     Boolean @default(false) // Pricing option

  financingAvailable Boolean @default(false) // Sales feature
  tradeIn            Boolean @default(false) // Sales feature
  features           Json[] // Array of miscellaneous vehicle features (e.g., safety, tech)

  // New Ownership & Pricing fields
  previousOwners    Int? // Added: Number of previous owners - Changed to Int
  tireCondition     String? // Added: e.g., "New", "Good", "Fair", "Poor"
  accidentalHistory Boolean? @default(false) // Added: Has reported accidental history

  // Books Specifics
  author    String?
  publisher String?
  isbn      String?

  // Fashion Specifics
  fabricComposition String?
  careInstructions  String?

  // Home Appliances Specifics
  energyRating        String?
  warrantyPeriod      String?
  applianceDimensions String? // To avoid conflict, renamed from 'dimensions'

  // Beauty Products Specifics
  ingredients       String?
  usageInstructions String?
  expirationDate    DateTime?

  // Options & Amenities
  option    Json[] // Generic options (e.g., for configurable products)
  amenities String[] // Specific for properties/services

  // Property Specifics
  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id])
  propertyTypeId String?       @db.ObjectId

  area      String? // e.g., "1500 sqft"
  bedrooms  Json[] // Updated to support multiple bedroom types
  studios   Json[] // Updated to support multiple bedroom types
  bathrooms String?

  // Service & Scheduling Specifics
  serviceSchedule String?
  year            Int? // Changed to Int (e.g., vehicle model year, or year of service)

  availabilityStart DateTime? // For services/rentals
  availabilityEnd   DateTime? // For services/rentals

  // Location & Contact
  location     Json? // GeoJSON format { type: "Point", coordinates: [lng, lat] }
  locationName String?
  latitude     Float?
  longitude    Float?

  contact     String? // General contact number
  contactName String?
  email       String?

  // Marketplace & Fulfillment
  delivery          Boolean  @default(false)
  paymentOption     String   @default("AT SHOP")
  showOnGhuba       Boolean? @default(true)
  digitalUrl        String?
  autoDeliver       Boolean? @default(false)
  hourlyRate        Float?
  minimumHours      Int?
  minNoticePeriod   String?
  maxBookingAhead   String?
  totalCapacity     Int?
  deliveryMethod    String?
  fulfillmentStatus String? // Consider an enum
  providerRating    Float? // e.g., 4.5 stars
  bookingSlots      Json[] // Store complex booking slot data as JSON

  // Admin & Auditing
  status         ListingStatus    @default(ACTIVE) // Assuming ListingStatus enum exists
  Collection     Collection?      @relation(fields: [collectionId], references: [id])
  collectionId   String?          @db.ObjectId
  CollectionItem CollectionItem[]
  Review         Review[]
  Question       Question[]
  RecentlyViewed RecentlyViewed[]
  WishlistItem   WishlistItem[]
  ProductMetrics ProductMetrics[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Additional fields from original schema, check if still relevant or duplicated
  tax          Float? @default(0)
  shippingCost Float? @default(0)

  // Relations that might need to be defined elsewhere in schema.prisma
  myLocation Location?   @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locationId String?     @db.ObjectId
  OrderItem  OrderItem[]

  // Indexes for performance
  @@index([name])
  @@index([finalPrice])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([status])
  @@index([companyId]) // Good for fetching products by company
  @@index([productCategoryId]) // Good for filtering by category
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  user          User          @relation(fields: [userId], references: [id])
  userId        String        @db.ObjectId
  order         CustomerOrder @relation(fields: [orderId], references: [id])
  orderId       String        @db.ObjectId
  amount        Float
  status        PaymentStatus
  transactionId String        @unique
  createdAt     DateTime?     @default(now())
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

model Appointment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId

  doctorId String? @db.ObjectId // Foreign key to Doctor model (or User with Doctor role)
  doctor   Doctor? @relation(fields: [doctorId], references: [id]) // Relation to Doctor
  service  String? // Description of the service (e.g., "General Check-up")

  date      DateTime
  status    AppointmentStatus
  createdAt DateTime?         @default(now())
  OrderItem OrderItem[]

  // Company relation
  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([doctorId]) // Add index for efficient lookup by doctor
}

model PropertyType {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  name                String                @unique
  description         String?
  products            Product[]
  createdAt           DateTime?             @default(now())
  updatedAt           DateTime?             @updatedAt
  marketplaceListings marketplaceListings[]
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Blog {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  company     Company    @relation(fields: [companyId], references: [id])
  companyId   String     @db.ObjectId
  title       String     @unique
  slug        String     @unique
  content     String
  isFeature   Boolean    @default(false)
  excerpt     String? //@db.VarChar(300) // Short summary
  coverImage  String? // URL to the blog's cover image
  categories  String[] // Array of category names
  tags        String[] // Array of relevant tags
  author      Json? // name profileImage
  seo         SeoBlog?
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  views       Int        @default(0)
  likes       Int        @default(0)
  comments    Comment[]
  createdAt   DateTime?  @default(now())
  updatedAt   DateTime?  @updatedAt
}

model SeoBlog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  keywords    String[]
  blogId      String   @unique @db.ObjectId
  blog        Blog     @relation(fields: [blogId], references: [id])
  Company     Company? @relation(fields: [companyId], references: [id])
  companyId   String?  @db.ObjectId
}

model SEO {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  keywords    String[]
  Company     Company[]
}

model Comment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  user      String
  comment   String
  createdAt DateTime? @default(now())
  blogId    String    @db.ObjectId
  blog      Blog      @relation(fields: [blogId], references: [id])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Task {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  taskName String

  dueTime String

  icon String?

  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(PENDING) // Enum: PENDING, IN_PROGRESS, COMPLETED, CANCELED
  priority    TaskPriority @default(MEDIUM) // Enum: LOW, MEDIUM, HIGH

  assignedToId String? @db.ObjectId // User assigned to the task
  assignedTo   User?   @relation(name: "assignedTo", fields: [assignedToId], references: [id])

  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  createdById String @db.ObjectId // User who created the task
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([companyId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

//One on One relationship with user

model Client {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  // This establishes the one-to-one link to the User model
  userId String @unique @db.ObjectId
  user   User   @relation("ClientProfile", fields: [userId], references: [id])

  // Fields specific to the Client role
  salesAgentId      String?             @db.ObjectId
  salesAgent        SalesAgent?         @relation(fields: [salesAgentId], references: [id])
  createdAt         DateTime?           @default(now())
  updatedAt         DateTime?           @updatedAt
  AgentInventoryLog AgentInventoryLog[]
  ClientInventory   ClientInventory[]
  Return            Return[]

  // --- NEW FIELDS FOR CLIENT MANAGEMENT ---
  inquiryCount           Int?      @default(0)
