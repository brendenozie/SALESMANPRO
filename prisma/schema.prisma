  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([submissionId])
  @@index([questionId])
}

// Announcement Model
// Defines a structured announcement event.
// Announcement Model
// Defines a structured announcement event.
model Announcement {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  title   String
  summary String? // A short summary of the announcement
  content String? // Full content of the announcement

  // publishedAt: When the announcement becomes visible. No default if it can be scheduled.
  publishedAt DateTime

  // expiresAt: When the announcement is no longer visible. Made nullable to allow permanent announcements.
  expiresAt DateTime?

  authorId String @db.ObjectId // User (Admin or Educator) who created the announcement
  author   User   @relation("UserAnnouncements", fields: [authorId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  companyId String  @db.ObjectId // Link to Company for multi-tenancy
  company   Company @relation(fields: [companyId], references: [id])

  status AnnouncementStatus @default(PENDING) // Current status of the announcement

  // NEW: Announcement Type (e.g., General, Event, Policy Update)
  type AnnouncementType @default(GENERAL)

  // NEW: Announcement Audience (e.g., ALL, ACADEMIC_LEVEL, STUDENT)
  audience AnnouncementAudience @default(ALL)

  // Audience Targeting Fields (arrays of IDs - populated based on 'audience' selection)
  // These are optional and will be used by application logic to filter visibility.
  targetAcademicLevelIds String[] @db.ObjectId // IDs of AcademicLevels targeted (if audience is ACADEMIC_LEVEL)
  targetCourseIds        String[] @db.ObjectId // IDs of Courses targeted (if audience is COURSE)
  targetEducatorIds      String[] @db.ObjectId // IDs of Educators targeted (if audience is EDUCATOR)
  targetStudentIds       String[] @db.ObjectId // IDs of specific Students targeted (if audience is STUDENT)
  targetDepartmentIds    String[] @db.ObjectId // NEW: IDs of Departments targeted (if audience is DEPARTMENT)
  targetParentIds        String[] @db.ObjectId // NEW: IDs of Parents targeted (if audience is PARENT)

  // Indexes for common queries
  @@index([companyId])
  @@index([authorId])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([type])
  @@index([audience]) // New index for filtering by audience
  @@index([status]) // New index for filtering by audience
  @@index([companyId, status, publishedAt(sort: Desc)])
}

// Enum for Announcement Status
enum AnnouncementStatus {
  PENDING // Draft or scheduled
  PUBLISHED // Actively visible
  ARCHIVED // No longer visible, but kept for historical records
}

// NEW: Enum for Announcement Type
enum AnnouncementType {
  GENERAL // For general announcements
  ACADEMIC // Related to academic matters (e.g., exams, curriculum)
  EVENT // For school events (e.g., sports day, parent-teacher meeting)
  HOLIDAY // For holiday announcements
  ALERT // For urgent notifications (e.g., school closure, emergency)
  NEWS // For company/school news or updates
  POLICY_UPDATE // For updates to school policies
  FEEDBACK // For collecting feedback from users
  SURVEY // For conducting surveys among users
  OTHER // For any other type of announcement not covered above
}

// NEW: Enum for Announcement Audience
enum AnnouncementAudience {
  ALL // Visible to all users in the company
  ACADEMIC_LEVEL // Visible to all students and educators in specific academic levels
  COURSE // Visible to all students and educators in specific courses
  EDUCATOR // Visible only to specific educators
  STUDENT // Visible only to specific students
  DEPARTMENT // Visible to all users in specific departments
  STAFF // Visible only to staff members (e.g., admins, educators)
  PARENT // Visible to parents of students
}

// Event Model
// Represents a scheduled event within the company/school.
model Event {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  summary     String? // A short summary of the event
  description String? // Full detailed description of the event

  startDateTime DateTime // Start date and time of the event
  endDateTime   DateTime? // End date and time of the event (nullable for single-point events)

  location          String? // Physical location or "Online"
  onlineMeetingLink String? // URL for online meetings (e.g., Zoom, Google Meet)

  imageUrl String? // URL to an image for the event
  videoUrl String? // URL to a video for the event

  productCategoryId String?          @db.ObjectId
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id])
  category          String? // Consider enum or relation
  subCategory       Json? // Consider specific model if structure is fixed
  subCategoryName   String? // Matches Product model

  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  eventType   EventType   @default(GENERAL) // Categorization of the event
  eventStatus EventStatus @default(SCHEDULED) // Current status of the event

  // Organizer/Author of the event (can be a User like Admin or Educator)
  organizerId String @db.ObjectId
  organizer   User   @relation("OrganizedEvents", fields: [organizerId], references: [id])

  // Multi-tenancy
  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  // Audience Targeting (similar to Announcements)
  audience               EventAudience @default(ALL)
  targetAcademicLevelIds String[]      @db.ObjectId // IDs of AcademicLevels targeted
  targetCourseIds        String[]      @db.ObjectId // IDs of Courses targeted
  targetEducatorIds      String[]      @db.ObjectId // IDs of Educators targeted
  targetStudentIds       String[]      @db.ObjectId // IDs of specific Students targeted
  targetDepartmentIds    String[]      @db.ObjectId // IDs of Departments targeted
  targetParentIds        String[]      @db.ObjectId // IDs of Parents targeted

  // Registration & Capacity
  isRegistrationRequired Boolean @default(false)
  maxCapacity            Int? // Maximum number of attendees
  // currentAttendees: This would typically be a count from a separate 'EventRegistration' model
  // or a computed field, not directly stored here to avoid race conditions.

  // Cost/Payment
  isPaid Boolean @default(false)
  price  Float? // Price of the event if isPaid is true

  // Contact Information
  contactPerson String?
  contactEmail  String?
  contactPhone  String?

  createdAt         DateTime?           @default(now())
  updatedAt         DateTime?           @updatedAt
  EventRegistration EventRegistration[]

  tickets         EventTicket[]
  ticketPurchases EventTicketPurchase[]
  ticketAttendees EventTicketAttendee[]

  // Indexes for efficient querying
  @@index([companyId])
  @@index([organizerId])
  @@index([startDateTime])
  @@index([eventStatus])
  @@index([eventType])
  @@index([audience])
  @@index([projectId])
  @@index([isPaid])
}

// Enum for Event Type
enum EventType {
  GENERAL // General school event, not specific to academics/sports
  ACADEMIC // Related to academic activities (e.g., study groups, academic competitions)
  SPORTS // Sports events (e.g., games, tryouts)
  CULTURAL // Cultural events (e.g., plays, concerts, art exhibitions)
  MEETING // Staff meetings, parent meetings, etc.
  WORKSHOP // Training sessions, skill-building workshops
  ORIENTATION // New student/parent orientation
  FUNDRAISER // Fundraising events
  OTHER // Any other type not covered
}

// Enum for Event Status
enum EventStatus {
  DRAFT // Event is being created and not yet finalized
  SCHEDULED // Event is planned and active
  POSTPONED // Event has been delayed to a later date/time
  CANCELLED // Event has been cancelled
  COMPLETED // Event has already occurred
}

// Enum for Event Audience (similar to AnnouncementAudience)
enum EventAudience {
  ALL // Visible to all users in the company
  ACADEMIC_LEVEL // Visible to all students and educators in specific academic levels
  COURSE // Visible to all students and educators in specific courses
  EDUCATOR // Visible only to specific educators
  STUDENT // Visible only to specific students
  DEPARTMENT // Visible to all users in specific departments
  STAFF // Visible only to staff members (e.g., admins, educators)
  PARENT // Visible to parents of students
}

// EventRegistration Model
// Tracks individual user registrations for events.
model EventRegistration {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade) // Cascade delete if event is removed

  userId String @db.ObjectId // The user who registered (can be Student, Parent, Educator, etc.)
  user   User   @relation("EventRegistrations", fields: [userId], references: [id])

  registeredAt DateTime           @default(now())
  status       RegistrationStatus @default(REGISTERED) // e.g., REGISTERED, ATTENDED, CANCELLED

  // Optional: If you need to track specific student for a parent registration
  studentId String?  @db.ObjectId
  student   Student? @relation(fields: [studentId], references: [id])

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  // Add more fields as needed, e.g., paymentStatus, notes, etc.

  @@unique([eventId, userId]) // A user can only register for an event once
  @@index([eventId])
  @@index([userId])
  @@index([studentId])
  @@index([companyId])
  @@index([status])
  @@index([companyId, eventId, status])
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  WAITLISTED
}

// =========================================================
// EVENT TICKETS
// =========================================================

model EventTicket {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relations
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  // Ticket Info
  name        String // VIP, Regular, Early Bird
  description String?

  ticketType EventTicketType @default(REGULAR)

  // Pricing
  price          Float
  currency       String @default("KES")
  originalPrice  Float?
  discountAmount Float?

  // Inventory
  quantityTotal Int
  quantitySold  Int @default(0)

  // Limits
  minPerOrder Int  @default(1)
  maxPerOrder Int?

  // Sales window
  salesStartDate DateTime?
  salesEndDate   DateTime?

  // Visibility
  isActive  Boolean @default(true)
  isVisible Boolean @default(true)

  // Optional Benefits
  perks String[]

  // Checkin
  requiresApproval Boolean @default(false)

  // Metadata
  colorHex String?
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases EventTicketPurchase[]
  attendees EventTicketAttendee[]

  @@index([eventId])
  @@index([companyId])
  @@index([ticketType])
  @@index([isActive])
  @@index([salesStartDate])
  @@index([salesEndDate])
}

// =========================================================
// TICKET PURCHASES
// =========================================================

model EventTicketPurchase {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  ticketId String      @db.ObjectId
  ticket   EventTicket @relation(fields: [ticketId], references: [id])

  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id])

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  // Buyer
  buyerId String? @db.ObjectId
  buyer   User?   @relation(fields: [buyerId], references: [id])

  buyerName  String
  buyerEmail String
  buyerPhone String?

  // Order
  quantity    Int
  unitPrice   Float
  totalAmount Float

  currency String @default("KES")

  // Payment
  paymentStatus TicketPaymentStatus @default(PENDING)
  paymentMethod String?

  transactionId     String?
  checkoutReference String?

  // Ticket delivery
  isCheckedIn Boolean @default(false)

  purchaseDate DateTime @default(now())

  attendees EventTicketAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([eventId])
  @@index([buyerId])
  @@index([paymentStatus])
  @@index([companyId])
}

// =========================================================
// INDIVIDUAL ISSUED TICKETS
