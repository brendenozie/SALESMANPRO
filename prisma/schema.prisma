// Class Schedule Model (for educator's classes/lectures and school timetabling)
model ClassSchedule {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  educatorId String   @db.ObjectId
  educator   Educator @relation(fields: [educatorId], references: [id])

  dayOfWeek String
  startTime DateTime // Time of the class (e.g., '1970-01-01T10:00:00.000Z' - only time component matters, date part is ignored)
  endTime   DateTime // End time of the class (e.g., '1970-01-01T11:30:00.000Z' - only time component matters, date part is ignored)

  topic       String?
  meetingLink String? // Link to video conferencing (e.g., Zoom, Google Meet)

  // NEW: Link to Company for multi-tenancy
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  AttendanceRecord AttendanceRecord[]

  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId String?    @db.ObjectId

  academicLevelId String?        @db.ObjectId
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])

  // Unique constraint: An educator can only have one class scheduled at a specific date and time within a company.
  // This helps prevent accidental double-booking for the same educator.
  @@unique([companyId, educatorId, dayOfWeek, startTime])
  @@index([courseId]) // For efficient lookup of schedules by course
  @@index([companyId]) // For efficient lookup of all schedules for a company
  @@index([dayOfWeek])
  @@index([educatorId])
  @@index([classroomId])
}

// Enum for Attendance Status
enum AttendanceStatus {
  PRESENT
  ABSENT
  TARDY
  EXCUSED
}

// Attendance Record Model
// Records a student's attendance for a specific class schedule session or a general day.

// Class Attendance Model
model AttendanceRecord {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  studentId String  @db.ObjectId
  student   Student @relation(fields: [studentId], references: [id])

  classScheduleId String?        @db.ObjectId // Optional: Link to a specific scheduled class session
  classSchedule   ClassSchedule? @relation(fields: [classScheduleId], references: [id])

  academicLevelId String?        @db.ObjectId // NEW: Optional: Link to a specific Academic Level if not tied to a ClassSchedule
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])

  classroomId String?    @db.ObjectId // NEW: Optional: Link to a specific Classroom if not tied to a ClassSchedule
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  courseId String? @db.ObjectId // NEW: Optional: Link to a specific Course if not tied to a ClassSchedule
  course   Course? @relation(fields: [courseId], references: [id])

  date   DateTime // Date of the attendance record (consider making it specific to a point in time if needed)
  status AttendanceStatus // Enum: PRESENT, ABSENT, TARDY, EXCUSED
  reason String? // Optional: Reason for absence/tardy/excused

  recordedById String   @db.ObjectId // User (Educator or Admin) who recorded attendance
  recordedBy   Educator @relation("RecordedAttendance", fields: [recordedById], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  Company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId

  @@unique([academicLevelId, classroomId, studentId, date])
  @@index([studentId, date])
  @@index([classScheduleId])
  @@index([academicLevelId]) // NEW INDEX
  @@index([courseId]) // NEW INDEX
  @@index([studentId])
  @@index([recordedById])
  @@index([companyId])
  @@index([status]) // NEW INDEX
}

model ExamCategory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  exams Exam[] // Relation to Exam model

  @@unique([companyId, name]) // A company cannot have two exam categories with the same name
  @@index([companyId])
}

// Exam Model
// Defines a structured examination or assessment event.
model Exam {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?

  courseId            String?          @db.ObjectId
  course              Course?          @relation(fields: [courseId], references: [id])
  date                DateTime // Date of the exam (e.g., '2025-07-01T00:00:00.000Z' for the specific day)
  startTime           DateTime? // Time of the exam (e.g., '1970-01-01T09:00:00.000Z')
  endTime             DateTime? // End time of the exam (e.g., '1970-01-01T10:30:00.000Z')
  location            String? // e.g., "School Hall A", "Online" - can be used for physical location or "Online"
  notes               String? // Special instructions for students
  type                ExamType         @default(UNIT_TEST) // Enum: QUIZ, MIDTERM, FINAL, etc.
  totalPoints         Float            @default(100)
  isPublished         Boolean          @default(false) // If results are visible to students
  createdByEducatorId String           @db.ObjectId // Educator who created the exam
  createdByEducator   Educator         @relation(fields: [createdByEducatorId], references: [id])
  submissions         ExamSubmission[]

  // Fields for online exams
  isOnline        Boolean        @default(false) // Whether this is an online exam
  durationMinutes Int? // Duration of the exam once started (in minutes)
  autoGrade       Boolean        @default(false) // Whether the exam can be automatically graded (e.g., for MCQs)
  questions       ExamQuestion[] // Relation to ExamQuestion model

  academicLevelId String?        @db.ObjectId
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])

  academicYearId String?       @db.ObjectId
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  termId String? @db.ObjectId
  term   Term?   @relation(fields: [termId], references: [id])

  // Link to Company for multi-tenancy
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  classroomId String?    @db.ObjectId
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  grades Grade[] // Grades associated with this exam
  weight Float   @default(50) // e.g., this exam is 50% of the total grade

  createdAt      DateTime?     @default(now())
  updatedAt      DateTime?     @updatedAt
  examCategory   ExamCategory? @relation(fields: [examCategoryId], references: [id])
  examCategoryId String?       @db.ObjectId

  // Suggested unique constraint: One exam per course at a specific date and start time within a company
  @@unique([companyId, courseId, date, startTime])
  @@index([createdByEducatorId])
  @@index([companyId]) // For efficient lookup of all exams for a company
}

// ExamQuestion Model
// Represents a single question within an online examination.
model ExamQuestion {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  examId       String @db.ObjectId
  exam         Exam   @relation(fields: [examId], references: [id], onDelete: Cascade) // Cascade delete questions with exam
  questionText String

  // NEW FIELDS for image and video
  imageUrl String? // URL to an image associated with the question
  videoUrl String? // URL to a video associated with the question

  questionType  QuestionType // Enum: MULTIPLE_CHOICE, TRUE_FALSE, SHORT_ANSWER, ESSAY
  options       String[] // For multiple choice: array of possible answers (JSON string array)
  correctAnswer String? // For auto-grading: stores the correct answer(s) as a string (e.g., "option_A_id", or a JSON string for complex answers)
  points        Float        @default(1)
  order         Int // Order of the question in the exam

  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt
  examAnswers ExamAnswer[]

  @@index([examId])
  @@index([order])
}

// ExamSubmission Model (Recommended Update for Online Exam Answers)
model ExamSubmission {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  examId    String  @db.ObjectId
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade) // Ensure cascade delete
  studentId String  @db.ObjectId
  student   Student @relation(fields: [studentId], references: [id])

  submissionUrl String? // Link to submitted file/document

  submittedAt DateTime @default(now())
  score       Float? // Final score for the submission
  feedback    String?

  reviewedById String?   @db.ObjectId // Educator who reviewed it
  reviewedBy   Educator? @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Field for online exam answers
  answers Json? // Stores the student's answers in a flexible JSON format

  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt
  examAnswers ExamAnswer[]

  @@unique([examId, studentId]) // A student can only submit one exam per exam
  @@index([examId])
  @@index([studentId])
  @@index([reviewedById])
}

model ExamAnswer {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  examSubmissionId String         @db.ObjectId
  examSubmission   ExamSubmission @relation(fields: [examSubmissionId], references: [id], onDelete: Cascade)
  examQuestionId   String         @db.ObjectId
  examQuestion     ExamQuestion   @relation(fields: [examQuestionId], references: [id])
  answerText       String? // Student's answer text
  selectedOptions  String[] // For multiple choice: array of selected options
  pointsAwarded    Float? // Points awarded for this question

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([examSubmissionId])
  @@index([examQuestionId])
}

// Enums used in the models
enum ExamType {
  HOMEWORK
  PROJECT
  QUIZ
  UNIT_TEST
