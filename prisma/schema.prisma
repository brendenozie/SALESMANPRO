// FeeItem Model: Defines the templates for different fee components
// These are the "rules" for what fees exist and to whom they apply.
model FeeItem {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  name            String  @unique // e.g., "Tuition Fee", "Science Lab Fee", "Sports Club Fee"
  description     String?
  defaultAmount   Float // The standard amount for this fee item
  // How this fee applies (e.g., "Class", "Course", "AcademicLevel", "All")
  // This helps in determining which students a fee applies to.
  applicableTo    String // Values like: "CLASS", "COURSE", "ACADEMIC_LEVEL", "ALL"
  applicableValue String? // e.g., "Grade 10A", "Physics 101", "SENIOR". Null if applicableTo "ALL"
  academicYear    String? // Optional: If this fee item is specific to a year (e.g., "2024/2025 Tuition")
  term            String? // Optional: If this fee item is specific to a term (e.g., "Term 1 Lab Fee")
  isMandatory     Boolean @default(true) // Whether this fee is mandatory for those it applies to

  @@map("feeItems") // MongoDB collection name for fee items
}

// StudentFeeRecord Model (UPDATED)
// This model now represents a student's fee summary for a specific academic period (term/year).
// It tracks the *applied* fee items and the payment history for that period.
model StudentFeeRecord {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String  @db.ObjectId // Foreign key to Student model
  student      Student @relation(fields: [studentId], references: [id]) // Relation to the Student model
  academicYear String // The academic year this fee record pertains to (e.g., "2024/2025")
  term         String // The term this fee record pertains to (e.g., "Term 1")

  // We remove totalFeesDue and balanceDue from here.
  // totalFeesDue will be calculated by summing amounts in 'appliedFeeItems'.
  // balanceDue will be calculated as (calculated totalFeesDue - amountPaid).

  amountPaid      Float   @default(0.0) // Total amount paid against this specific fee record
  paymentStatus   String // "Paid", "Partially Paid", "Unpaid", "Overpaid" - calculated status
  lastPaymentDate String? // YYYY-MM-DD: Date of the most recent payment
  dueDate         String? // YYYY-MM-DD: The official due date for this fee record

  invoiceNumber String? // Optional: Reference to an external invoice system or internal invoice number

  // NEW: Store the actual fee items applied to this specific record as a snapshot.
  // Each item in this array will be a JSON object like:
  // { feeItemId: string, name: string, amount: float, description?: string, isMandatory?: boolean }
  // This allows for per-student adjustments or if base FeeItem templates change later.
  appliedFeeItems Json[] @default([])

  // Existing: Array of embedded JSON objects for individual payment transactions.
  // Each item in this array will be a JSON object like:
  // { paymentId: string, amount: float, date: string, method: string, receiptNumber?: string }
  payments Json[] @default([])

  // Ensure uniqueness: A student should have only one fee record for a given academic year and term.
  @@unique([studentId, academicYear, term])
  @@map("studentFeeRecords") // MongoDB collection name for student fee records
}

