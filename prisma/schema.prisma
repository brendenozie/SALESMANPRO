  staffId     String    @unique // The "Badge Number" (e.g., STF-001)
  name        String
  phoneNumber String
  role        StaffRole @default(WARDEN)
  shiftLabel  String // e.g., "Day (08:00 - 16:00)"
  isOnDuty    Boolean   @default(false)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  // Relations
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([role])
}

enum StaffRole {
  WARDEN
  SECURITY
  CLEANER
  MAINTENANCE
}

// ============================================================
// STAFF MANAGEMENT (HR) MODELS
// ============================================================

model StaffLeave {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  userId       String           @db.ObjectId
  user         User             @relation("StaffLeaves", fields: [userId], references: [id], onDelete: Cascade)
  companyId    String           @db.ObjectId
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveType    StaffLeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       StaffLeaveStatus @default(PENDING)
  approvedBy   String?          @db.ObjectId
  approver     User?            @relation("ApprovedLeaves", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedDate DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([approvedBy])
}

model StaffPayroll {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  userId      String             @db.ObjectId
  user        User               @relation("StaffPayrolls", fields: [userId], references: [id], onDelete: Cascade)
  companyId   String             @db.ObjectId
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  month       Int // 1-12
  year        Int
  basicSalary Float
  allowances  Float              @default(0)
  deductions  Float              @default(0)
  netSalary   Float
  status      StaffPayrollStatus @default(DRAFT)
  paymentDate DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model StaffPerformanceReview {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  employeeId   String                 @db.ObjectId // User being reviewed
  employee     User                   @relation("EmployeePerformanceReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String                 @db.ObjectId // User conducting the review
  reviewer     User                   @relation("ReviewerPerformanceReviews", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewDate   DateTime               @default(now())
  reviewPeriod String // e.g., "Q1 2024", "Annual 2024"
  rating       StaffPerformanceRating
  strengths    String?
  weaknesses   String?
  comments     String?
  goals        String? // Future goals
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([employeeId])
  @@index([reviewerId])
}

// Enums for standardizing data
enum StaffAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

enum StaffAttendanceMethod {
  BIOMETRIC
  GEO_FENCE
  MANUAL_OVERRIDE
  WEB_PORTAL
}

model StaffAttendanceRecord {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  date         DateTime // Canonical date (e.g., 2024-05-20 00:00:00)
  checkInTime  DateTime?
  checkOutTime DateTime?

  status StaffAttendanceStatus @default(PRESENT)
  method StaffAttendanceMethod @default(WEB_PORTAL)

  // Storage for manual entry details
  isManual  Boolean @default(false)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // One attendance record per user per day
  @@index([companyId, date])
}

// Optional: Detailed audit trail for every single clock action
model StaffAttendanceAuditLog {
  id        String                @id @default(auto()) @map("_id") @db.ObjectId
  userId    String                @db.ObjectId
  companyId String                @db.ObjectId
  type      String // "IN" or "OUT"
  timestamp DateTime
  method    StaffAttendanceMethod
  note      String?
  adminId   String?               @db.ObjectId // Who performed the override
}

