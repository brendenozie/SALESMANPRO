// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ROLES {
  USER
  CONSUMER
  AGENT
  CLIENT
  ADMIN
  SUPER_ADMIN
  STUDENT
  EDUCATOR
  HEADTEACHER
  PARENT
  JUNIOR
  SENIOR
  SOPHOMORE
  FRESHMAN
  WRITER
  STAFF
  MODERATOR
  PATIENT
  DOCTOR
  PATRON
  EXPERT
  STAFF_MEMBER
  SERVICE_PROVIDER
  RIDER
  SCHOOL_DRIVER
  STORE_DRIVER
  SUPPLIER
}

enum StudentLevelStatus {
  JUNIOR
  SENIOR
  SOPHOMORE
  FRESHMAN
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @db.ObjectId
  role         ROLES?   @default(USER)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  createdAt DateTime? @default(now())
  read      Boolean   @default(false)
  Company   Company?  @relation(fields: [companyId], references: [id])
  companyId String?   @db.ObjectId

  @@index([companyId])
}

model CompanyCategory {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  icon     String?
  image    String?
  status   String
  variants Variant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]

  @@index([name])
  @@index([status])
  @@index([createdAt])
}

model Variant {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  link                String
  description         String?
  tag                 String?         @default("Standard")
  desktopPreviewImage String?
  mobilePreviewImage  String?
  categoryId          String          @db.ObjectId
  category            CompanyCategory @relation(fields: [categoryId], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([name])
  @@index([createdAt])
  @@index([categoryId, name])
}

// Category model with self-relations for hierarchy (categories & subcategories)
model ProductCategory {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  icon            String?
  image           String?
  slug            String    @unique
  description     String
  longDescription String
  seoTitle        String
  seoDescription  String
  metaKeywords    String[]
  sortOrder       Int       @default(0)
  visible         Boolean   @default(false)
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  createdBy       String
  updatedBy       String
  status          String
  allBrands       String[]
  tags            String[]

  // Hierarchy pointers
  subcategories Json // Store subcategories as a JSON array

  // Media & SEO assets
  imageAlt    String
  thumbnail   String?
  bannerImage String?

  // Localization
  localization Json

  // Dynamic fields
  productCount   Int
  isFeatured     Boolean @default(false)
  showInHomepage Boolean @default(false)

  // Custom attributes
  attributes Json

  Product             Product[]
  marketplaceListings marketplaceListings[]
  StoreCategory       StoreCategory[]
  Company             Company?              @relation(fields: [companyId], references: [id])
  companyId           String?               @db.ObjectId
  Podcast             Podcast[]

  events Event[]

  @@index([name])
  @@index([createdAt])
  @@index([companyId])
  @@index([tags])
  @@index([metaKeywords])
  @@index([allBrands])
  @@index([status])
  @@index([visible])
  @@index([companyId, visible])
  @@index([companyId, showInHomepage])
  @@index([companyId, status, visible])
}

/// Associates a Company with a ProductCategory,
/// plus any store-specific settings.
model StoreCategory {
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?          @db.ObjectId

  displayName String?
  icon        String?
  image       String?
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)

  id String @id @default(auto()) @map("_id") @db.ObjectId

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Store the selected subcategory objects directly as JSON
  subcategories Json?

  // Store the selected brand names as a JSON array
  allBrands Json? // e.g., ["Nike", "Adidas"]

  @@unique([companyId, categoryId])
  @@index([companyId, sortOrder])
  @@index([companyId])
  @@index([categoryId])
  @@index([allBrands])
  @@index([companyId, visible, sortOrder])
}

