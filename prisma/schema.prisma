  shelfLocation String   @default("Unassigned")
  integrity     Int      @default(100) // 0-100 percentage
  condition     String   @default("Good") // Mint, Good, Fair, Poor
  lastAudit     DateTime @default(now())

  @@index([companyId])
  @@index([status])
}

