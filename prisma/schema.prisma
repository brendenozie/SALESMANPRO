model Commission {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId     String         @db.ObjectId
  productId        String         @db.ObjectId
  product          Product        @relation(fields: [productId], references: [id])
  commissionRate   Float // Rate (percentage or fixed) based on criteria
  commissionEarned Float // Calculated based on the chosen criteria
  basedOn          CommissionType @default(COST) // Define whether based on COST or QUANTITY
  createdAt        DateTime?      @default(now())
  updatedAt        DateTime?      @updatedAt

  transactionDate DateTime         @default(now())
  status          CommissionStatus @default(PENDING) // Enum: PENDING, PAID, CANCELLED
  notes           String?

  Company          Company?        @relation(fields: [companyId], references: [id])
  companyId        String?         @db.ObjectId
  CommissionRate   CommissionRate? @relation(fields: [commissionRateId], references: [id])
  commissionRateId String?         @db.ObjectId
  SalesAgent       SalesAgent      @relation("AgentCommissions", fields: [salesAgentId], references: [id])

  @@unique([salesAgentId, productId]) // Composite unique constraint
  @@index([salesAgentId, status])
  @@index([salesAgentId])
  @@index([productId])
  @@index([companyId])
  @@index([commissionRateId])
  @@index([status])
}

enum CommissionType {
  COST // Commission based on total sales value
  QUANTITY // Commission based on quantity sold
  FIXED // Fixed amount per sale
  PERCENTAGE // Percentage of the sale amount
}

enum CommissionStatus {
  PENDING
  COMPLETED
  DENIED
}

