// ======================================================
// HUBS / WAREHOUSES
// ======================================================

model Hub {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  name    String
  address String
  lat     Float?
  lng     Float?

  createdAt DateTime   @default(now())
  Delivery  Delivery[]

  @@index([companyId])
}

model Delivery {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  trackingNumber String         @unique
  status         DeliveryStatus @default(PENDING)

  // Relation to the User model for the rider
  riderId   String? @db.ObjectId
  riderName String?
  rider     User?   @relation("RiderDeliveries", fields: [riderId], references: [id])

  customerName    String?
  customerContact String?
  customerEmail   String?

  // 💡 NEW: Summary fields to help the rider see the "Trip" at a glance
  totalWeight         Float?
  estimatedTravelTime Int? // in minutes
  totalDistanceKm     Float?

  hubId String? @db.ObjectId
  hub   Hub?    @relation(fields: [hubId], references: [id])

  // Fleet & Customer relations
  vehicleId       String?           @db.ObjectId
  vehicle         TransportVehicle? @relation(fields: [vehicleId], references: [id])
  routeId         String?           @db.ObjectId
  route           TransportRoute?   @relation(fields: [routeId], references: [id])
  driverProfileId String?           @db.ObjectId
  driverProfile   TransportDriver?  @relation(fields: [driverProfileId], references: [id])
  consumerId      String?           @db.ObjectId
  consumer        Consumer?         @relation(fields: [consumerId], references: [id])

  pickupAddress   String?
  deliveryAddress String?
  latlngPickup    String? // e.g., "37.7749,-122.4194"
  latlngDelivery  String? // e.g., "37.7749,-122.4194"

  deliveryInstructions String?

  // Optional fields for package details
  packageType        String?
  packageWeightKg    Float?
  packageDimensions  String? // e.g., "10x5x8 cm"
  packageQuantity    Int?    @default(1)
  // Optional fields for better tracking and management
  packageValue       Float? // Value of the package for insurance purposes
  packageInsurance   Float? // Insurance value for the package
  packageTrackingUrl String? // URL for tracking the package

  packageDescription String?
  weightKg           Float?
  deliveryFee        Float?
  tip                Float?    @default(0.0)
  totalAmount        Float?
  notes              String?
  // scheduledFor is the date and time when the delivery is scheduled to occur
  scheduledFor       DateTime?

  createdAt DateTime @default(now())

  CustomerOrders CustomerOrder[] @relation("DeliveryToOrders")

  stops     DeliveryStop[]
  tracking  DeliveryTracking[]
  proofs    DeliveryProof[]
  incidents TransportIncident[]

  @@index([companyId])
  @@index([riderId])
  @@index([vehicleId])
  @@index([driverProfileId])
  @@index([consumerId])
  @@index([status])
}

// ======================================================
// DELIVERY STOPS (MULTI-DROP)
// ======================================================

enum DeliveryStatus {
  DRAFT
  PENDING
  REQUESTED
  QUOTED
  PENDING_PAYMENT
  CONFIRMED
  SCHEDULED
  DRIVER_ASSIGNED
  ASSIGNED
  DRIVER_EN_ROUTE_TO_PICKUP
  ARRIVED_AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  INPROGRESS
  ARRIVED_AT_DESTINATION
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
  FAILED_PICKUP
  FAILED_DELIVERY
  RESCHEDULED
  RETURNED
  ON_HOLD
}

enum StopStatus {
  PENDING
  ARRIVED
  DELIVERED
  FAILED
  SKIPPED
}

enum ProofType {
  PHOTO
  SIGNATURE
  OTP
}

enum RiderStatus {
  OFFLINE
  ONLINE
  IDLE
  ON_DELIVERY
  BREAK
}

model DeliveryStop {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id])

  orderId String
  order   CustomerOrder @relation(fields: [orderId], references: [id])

  sequence Int

  customerName String?
  phone        String?

  address String
  lat     Float?
  lng     Float?

  status StopStatus @default(PENDING)

  etaMinutes Int?

  arrivedAt   DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  failureReason String?

  proofs DeliveryProof[]

  @@index([deliveryId])
  @@index([sequence])
}

// ======================================================
// LIVE GPS TRACKING
// ======================================================

model DeliveryTracking {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id])

  riderId String?
  rider   User?   @relation(fields: [riderId], references: [id])

  lat Float
  lng Float

  speedKph Float?
  heading  Float?

  batteryLevel Int?

  status       String?
  locationName String?
  note         String?

  recordedAt DateTime @default(now())

  @@index([deliveryId])
  @@index([recordedAt])
}

// ======================================================
// PROOF OF DELIVERY
// ======================================================

model DeliveryProof {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  stopId String?
  stop   DeliveryStop? @relation(fields: [stopId], references: [id])

  deliveryId String?   @db.ObjectId
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])

  type ProofType

  imageUrl       String?
  signatureUrl   String?
  otpCode        String?
  recipientName  String?
  recipientPhone String?
  lat            Float?
  lng            Float?

  notes String?

  createdAt DateTime @default(now())

  @@index([stopId])
  @@index([deliveryId])
}

// ======================================================
// RETURNS / FAILED ATTEMPTS
// ======================================================

model DeliveryException {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  deliveryId String  @db.ObjectId
  stopId     String? @db.ObjectId
  orderId    String? @db.ObjectId

  reason String
  notes  String?

  createdAt DateTime @default(now())

  @@index([deliveryId])
}

model TransportIncident {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String   @db.ObjectId
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId  String?  @db.ObjectId
  vehicle    TransportVehicle? @relation(fields: [vehicleId], references: [id])
  driverId   String?  @db.ObjectId
  driver     TransportDriver?  @relation(fields: [driverId], references: [id])
  deliveryId String?  @db.ObjectId
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])
  type       String
  severity   String   @default("Medium")
  status     String   @default("Under Investigation")
  date       DateTime @default(now())
  location   String?
  notes      String?
  hasVideo   Boolean  @default(false)
  hasPhotos  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([deliveryId])
  @@index([status])
}

model Idempotency {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  locked    Boolean  @default(false)
  response  Json?

  @@index([createdAt], name: "idempotency_createdAt_idx")
}

