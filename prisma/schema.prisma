// Relevant parts of your schema.prisma
// Add this enum if it doesn't exist
enum ExpertStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model Expert {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  userId           String?      @unique @db.ObjectId // One-to-one with User
  user             User?        @relation(fields: [userId], references: [id], onDelete: Cascade) // onDelete: Cascade for user deletion
  companyId        String       @db.ObjectId
  company          Company      @relation(fields: [companyId], references: [id])
  specialty        String
  experienceYears  Int?
  travelsCompleted Int?
  photoUrl         String? // Use this for photo
  bio              String?
  contactEmail     String?
  contactPhone     String?
  status           ExpertStatus @default(ACTIVE)

  expertise Expertise[] // Array of expertise enums

  image String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  FinanceAppointment FinanceAppointment[] @relation("Expert")
  cases              Case[]               @relation("AssignedTo") // A user can be assigned to many cases

  // @@index([userId])
  @@index([companyId])
  @@index([status])
}

model Package {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  price      String
  frequency  String
  features   String[]
  status     PackageStatus @default(ACTIVE)
  isFeatured Boolean       @default(false)

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  subscriptionCompanies SubscriptionCompany[]

  @@index([status])
}

enum PackageStatus {
  ACTIVE
  INACTIVE
  FEATURED
  DRAFT
  ARCHIVED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  HIDDEN
}

// Testimonial model: Represents a client testimonial
model Testimonial {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  quote       String
  authorId    String?           @db.ObjectId
  author      User?             @relation(fields: [authorId], references: [id])
  authorName  String?
  authorTitle String? // e.g., "Founder & CEO"
  status      TestimonialStatus @default(PENDING)

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  avatarUrl String?
  rating    Int? // 1–5 stars
  order     Int     @default(0)

  @@index([companyId])
  @@index([status])
}

// FAQ model: Represents a Frequently Asked Question
model FAQ {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  question String
  answer   String
  order    Int    @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([companyId])
}

// Settings model: For user-specific preferences
model Settings {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @unique @db.ObjectId
  user              User    @relation(fields: [userId], references: [id])
  newClientNotify   Boolean @default(true)
  invoicePaidNotify Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@index([userId])
}

// schema.prisma

model Destination {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String   @unique // A URL-friendly name for better SEO and unique links
  country         String
  continent       String // Categorize destinations by continent
  description     String
  longDescription String? // A more detailed description for a dedicated page
  images          String[] // List of image URLs for a gallery
  bannerImage     String // A specific, high-quality image for a hero section
  activities      String[] // List of key activities or attractions (e.g., "Hiking", "Surfing")
  bestTimeToVisit String? // A string to describe the ideal season
  averageRating   Float? // User rating (e.g., 4.5)

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  locationId String   @db.ObjectId
  location   Location @relation(fields: [locationId], references: [id])

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  TourPackage   TourPackage? @relation(fields: [tourPackageId], references: [id])
  tourPackageId String?      @db.ObjectId
  Booking       Booking[]
  // @@index([slug])

  @@index([companyId])
  @@index([locationId])
  @@index([tourPackageId])
  @@index([images])
}

// TourPackage model: Represents a travel package or tour.
model TourPackage {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String        @unique
  description     String
  longDescription String?
  duration        String // e.g., "7 Days, 6 Nights"
  price           Float
  status          PackageStatus @default(DRAFT)
  imageUrl        String
  images          String[]

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  // Many-to-many relationship with Destination
  destinations Destination[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Location   Location? @relation(fields: [locationId], references: [id])
  locationId String?   @db.ObjectId
  Booking    Booking[]
  // @@index([slug])

  @@index([locationId])
  @@index([images])
  @@index([status])
}

