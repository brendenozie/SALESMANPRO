// Case model: Represents a specific case for a client
model Case {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String?
  clientId         String     @db.ObjectId
  client           Client     @relation(fields: [clientId], references: [id])
  assignedToUserId String     @db.ObjectId
  assignedTo       Expert     @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  caseType         CaseType   @default(FINANCE)
  status           CaseStatus @default(PENDING)
  notes            String?
  companyId        String     @db.ObjectId
  company          Company    @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToUserId])
  @@index([status])
}

model Document {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  fileUrl    String
  mimeType   String
  fileSize   Int
  uploaderId String   @db.ObjectId
  uploader   User     @relation(fields: [uploaderId], references: [id])
  companyId  String?  @db.ObjectId
  company    Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Appointment model: Represents a scheduled meeting between a client and an expert
model FinanceAppointment {
  id       String            @id @default(auto()) @map("_id") @db.ObjectId
  clientId String            @db.ObjectId
  client   Client            @relation(fields: [clientId], references: [id])
  expertId String            @db.ObjectId
  expert   Expert            @relation("Expert", fields: [expertId], references: [id])
  date     DateTime
  notes    String?
  status   AppointmentStatus @default(SCHEDULED)

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([expertId])
  @@index([status])
}

// Invoice model: Represents a financial invoice for a client
model Invoice {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  clientId      String        @db.ObjectId
  client        Client        @relation(fields: [clientId], references: [id])
  invoiceNumber String        @unique
  amount        Float
  issueDate     DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)
  notes         String?

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

