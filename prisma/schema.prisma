  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([courseId])
  @@index([reviewedById])
}

// Announcement Model
// Defines a structured announcement event.
// Announcement Model
// Defines a structured announcement event.
model Announcement {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  title   String
  summary String? // A short summary of the announcement
  content String? // Full content of the announcement

  // publishedAt: When the announcement becomes visible. No default if it can be scheduled.
  publishedAt DateTime

  // expiresAt: When the announcement is no longer visible. Made nullable to allow permanent announcements.
  expiresAt DateTime?

  authorId String @db.ObjectId // User (Admin or Educator) who created the announcement
  author   User   @relation("UserAnnouncements", fields: [authorId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  companyId String  @db.ObjectId // Link to Company for multi-tenancy
  company   Company @relation(fields: [companyId], references: [id])

  status AnnouncementStatus @default(PENDING) // Current status of the announcement

  // NEW: Announcement Type (e.g., General, Event, Policy Update)
  type AnnouncementType @default(GENERAL)

  // NEW: Announcement Audience (e.g., ALL, ACADEMIC_LEVEL, STUDENT)
  audience AnnouncementAudience @default(ALL)

  // Audience Targeting Fields (arrays of IDs - populated based on 'audience' selection)
  // These are optional and will be used by application logic to filter visibility.
  targetAcademicLevelIds String[] @db.ObjectId // IDs of AcademicLevels targeted (if audience is ACADEMIC_LEVEL)
  targetCourseIds        String[] @db.ObjectId // IDs of Courses targeted (if audience is COURSE)
  targetEducatorIds      String[] @db.ObjectId // IDs of Educators targeted (if audience is EDUCATOR)
  targetStudentIds       String[] @db.ObjectId // IDs of specific Students targeted (if audience is STUDENT)
  targetDepartmentIds    String[] @db.ObjectId // NEW: IDs of Departments targeted (if audience is DEPARTMENT)
  targetParentIds        String[] @db.ObjectId // NEW: IDs of Parents targeted (if audience is PARENT)

  // Indexes for common queries
  @@index([companyId])
  @@index([authorId])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([type])
  @@index([audience]) // New index for filtering by audience
}

// Enum for Announcement Status
enum AnnouncementStatus {
  PENDING // Draft or scheduled
  PUBLISHED // Actively visible
  ARCHIVED // No longer visible, but kept for historical records
}

// NEW: Enum for Announcement Type
enum AnnouncementType {
  GENERAL // For general announcements
  ACADEMIC // Related to academic matters (e.g., exams, curriculum)
  EVENT // For school events (e.g., sports day, parent-teacher meeting)
  HOLIDAY // For holiday announcements
  ALERT // For urgent notifications (e.g., school closure, emergency)
  NEWS // For company/school news or updates
  POLICY_UPDATE // For updates to school policies
  FEEDBACK // For collecting feedback from users
  SURVEY // For conducting surveys among users
  OTHER // For any other type of announcement not covered above
}

// NEW: Enum for Announcement Audience
enum AnnouncementAudience {
  ALL // Visible to all users in the company
  ACADEMIC_LEVEL // Visible to all students and educators in specific academic levels
  COURSE // Visible to all students and educators in specific courses
  EDUCATOR // Visible only to specific educators
  STUDENT // Visible only to specific students
  DEPARTMENT // Visible to all users in specific departments
  STAFF // Visible only to staff members (e.g., admins, educators)
  PARENT // Visible to parents of students
}

// Event Model
// Represents a scheduled event within the company/school.
model Event {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  summary     String? // A short summary of the event
  description String? // Full detailed description of the event

  startDateTime DateTime // Start date and time of the event
  endDateTime   DateTime? // End date and time of the event (nullable for single-point events)

  location          String? // Physical location or "Online"
  onlineMeetingLink String? // URL for online meetings (e.g., Zoom, Google Meet)

  imageUrl String? // URL to an image for the event
  videoUrl String? // URL to a video for the event

  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  eventType   EventType   @default(GENERAL) // Categorization of the event
  eventStatus EventStatus @default(SCHEDULED) // Current status of the event

  // Organizer/Author of the event (can be a User like Admin or Educator)
  organizerId String @db.ObjectId
  organizer   User   @relation("OrganizedEvents", fields: [organizerId], references: [id])

  // Multi-tenancy
  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  // Audience Targeting (similar to Announcements)
  audience               EventAudience @default(ALL)
  targetAcademicLevelIds String[]      @db.ObjectId // IDs of AcademicLevels targeted
  targetCourseIds        String[]      @db.ObjectId // IDs of Courses targeted
  targetEducatorIds      String[]      @db.ObjectId // IDs of Educators targeted
  targetStudentIds       String[]      @db.ObjectId // IDs of specific Students targeted
  targetDepartmentIds    String[]      @db.ObjectId // IDs of Departments targeted
  targetParentIds        String[]      @db.ObjectId // IDs of Parents targeted

  // Registration & Capacity
  isRegistrationRequired Boolean @default(false)
  maxCapacity            Int? // Maximum number of attendees
  // currentAttendees: This would typically be a count from a separate 'EventRegistration' model
  // or a computed field, not directly stored here to avoid race conditions.

  // Cost/Payment
  isPaid Boolean @default(false)
  price  Float? // Price of the event if isPaid is true

  // Contact Information
  contactPerson String?
  contactEmail  String?
  contactPhone  String?

  createdAt         DateTime?           @default(now())
  updatedAt         DateTime?           @updatedAt
  EventRegistration EventRegistration[]

  // Indexes for efficient querying
  @@index([companyId])
  @@index([organizerId])
  @@index([startDateTime])
  @@index([eventStatus])
  @@index([eventType])
  @@index([audience])
}

// Enum for Event Type
enum EventType {
  GENERAL // General school event, not specific to academics/sports
  ACADEMIC // Related to academic activities (e.g., study groups, academic competitions)
  SPORTS // Sports events (e.g., games, tryouts)
  CULTURAL // Cultural events (e.g., plays, concerts, art exhibitions)
  MEETING // Staff meetings, parent meetings, etc.
  WORKSHOP // Training sessions, skill-building workshops
  ORIENTATION // New student/parent orientation
  FUNDRAISER // Fundraising events
  OTHER // Any other type not covered
}

// Enum for Event Status
enum EventStatus {
  SCHEDULED // Event is planned and active
  POSTPONED // Event has been delayed to a later date/time
  CANCELLED // Event has been cancelled
  COMPLETED // Event has already occurred
}

// Enum for Event Audience (similar to AnnouncementAudience)
enum EventAudience {
  ALL // Visible to all users in the company
  ACADEMIC_LEVEL // Visible to all students and educators in specific academic levels
  COURSE // Visible to all students and educators in specific courses
  EDUCATOR // Visible only to specific educators
  STUDENT // Visible only to specific students
  DEPARTMENT // Visible to all users in specific departments
  STAFF // Visible only to staff members (e.g., admins, educators)
  PARENT // Visible to parents of students
}

// EventRegistration Model
// Tracks individual user registrations for events.
model EventRegistration {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade) // Cascade delete if event is removed

  userId String @db.ObjectId // The user who registered (can be Student, Parent, Educator, etc.)
  user   User   @relation("EventRegistrations", fields: [userId], references: [id])

  registeredAt DateTime           @default(now())
  status       RegistrationStatus @default(REGISTERED) // e.g., REGISTERED, ATTENDED, CANCELLED

  // Optional: If you need to track specific student for a parent registration
  studentId String?  @db.ObjectId
  student   Student? @relation(fields: [studentId], references: [id])

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  // Add more fields as needed, e.g., paymentStatus, notes, etc.

  @@unique([eventId, userId]) // A user can only register for an event once
  @@index([eventId])
  @@index([userId])
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  WAITLISTED
}

// Class Schedule Model (for educator's classes/lectures and school timetabling)
model ClassSchedule {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  educatorId String   @db.ObjectId
  educator   Educator @relation(fields: [educatorId], references: [id])

  dayOfWeek String
  startTime DateTime // Time of the class (e.g., '1970-01-01T10:00:00.000Z' - only time component matters, date part is ignored)
  endTime   DateTime // End time of the class (e.g., '1970-01-01T11:30:00.000Z' - only time component matters, date part is ignored)

  topic       String?
  meetingLink String? // Link to video conferencing (e.g., Zoom, Google Meet)

  // NEW: Link to Company for multi-tenancy
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  AttendanceRecord AttendanceRecord[]

  // Unique constraint: An educator can only have one class scheduled at a specific date and time within a company.
  // This helps prevent accidental double-booking for the same educator.
  @@unique([companyId, educatorId, dayOfWeek, startTime])
  @@index([courseId]) // For efficient lookup of schedules by course
  @@index([companyId]) // For efficient lookup of all schedules for a company
  @@index([dayOfWeek])
}

// Enum for Attendance Status
enum AttendanceStatus {
  PRESENT
  ABSENT
  TARDY
  EXCUSED
}

// Attendance Record Model
// Records a student's attendance for a specific class schedule session or a general day.

// Class Attendance Model
model AttendanceRecord {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  studentId String  @db.ObjectId
  student   Student @relation(fields: [studentId], references: [id])

  classScheduleId String?        @db.ObjectId // Optional: Link to a specific scheduled class session
  classSchedule   ClassSchedule? @relation(fields: [classScheduleId], references: [id])

  academicLevelId String?        @db.ObjectId // NEW: Optional: Link to a specific Academic Level if not tied to a ClassSchedule
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])

  courseId String? @db.ObjectId // NEW: Optional: Link to a specific Course if not tied to a ClassSchedule
  course   Course? @relation(fields: [courseId], references: [id])

  date   DateTime // Date of the attendance record (consider making it specific to a point in time if needed)
  status AttendanceStatus // Enum: PRESENT, ABSENT, TARDY, EXCUSED
  reason String? // Optional: Reason for absence/tardy/excused

  recordedById String   @db.ObjectId // User (Educator or Admin) who recorded attendance
  recordedBy   Educator @relation("RecordedAttendance", fields: [recordedById], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  Company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId

  @@index([studentId, date])
  @@index([classScheduleId])
  @@index([academicLevelId]) // NEW INDEX
  @@index([courseId]) // NEW INDEX
}

// Exam Model
// Defines a structured examination or assessment event.
model Exam {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  description         String?
  courseId            String           @db.ObjectId
  course              Course           @relation(fields: [courseId], references: [id])
  date                DateTime // Date of the exam (e.g., '2025-07-01T00:00:00.000Z' for the specific day)
  startTime           DateTime? // Time of the exam (e.g., '1970-01-01T09:00:00.000Z')
  endTime             DateTime? // End time of the exam (e.g., '1970-01-01T10:30:00.000Z')
  location            String? // e.g., "School Hall A", "Online" - can be used for physical location or "Online"
  notes               String? // Special instructions for students
  type                ExamType         @default(UNIT_TEST) // Enum: QUIZ, MIDTERM, FINAL, etc.
  totalPoints         Float            @default(100)
  isPublished         Boolean          @default(false) // If results are visible to students
  createdByEducatorId String           @db.ObjectId // Educator who created the exam
  createdByEducator   Educator         @relation(fields: [createdByEducatorId], references: [id])
  submissions         ExamSubmission[]

  // Fields for online exams
  isOnline        Boolean        @default(false) // Whether this is an online exam
  durationMinutes Int? // Duration of the exam once started (in minutes)
  autoGrade       Boolean        @default(false) // Whether the exam can be automatically graded (e.g., for MCQs)
  questions       ExamQuestion[] // Relation to ExamQuestion model

  // Link to Company for multi-tenancy
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  grades Grade[] // Grades associated with this exam

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Suggested unique constraint: One exam per course at a specific date and start time within a company
  @@unique([companyId, courseId, date, startTime])
  @@index([createdByEducatorId])
  @@index([companyId]) // For efficient lookup of all exams for a company
}

// ExamQuestion Model
// Represents a single question within an online examination.
model ExamQuestion {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  examId       String @db.ObjectId
  exam         Exam   @relation(fields: [examId], references: [id], onDelete: Cascade) // Cascade delete questions with exam
  questionText String

  // NEW FIELDS for image and video
  imageUrl String? // URL to an image associated with the question
  videoUrl String? // URL to a video associated with the question

  questionType  QuestionType // Enum: MULTIPLE_CHOICE, TRUE_FALSE, SHORT_ANSWER, ESSAY
  options       String[] // For multiple choice: array of possible answers (JSON string array)
  correctAnswer String? // For auto-grading: stores the correct answer(s) as a string (e.g., "option_A_id", or a JSON string for complex answers)
  points        Float        @default(1)
  order         Int // Order of the question in the exam

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([examId])
  @@index([order])
}

// ExamSubmission Model (Recommended Update for Online Exam Answers)
model ExamSubmission {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  examId    String  @db.ObjectId
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade) // Ensure cascade delete
  studentId String  @db.ObjectId
  student   Student @relation(fields: [studentId], references: [id])

  submissionUrl String? // Link to submitted file/document

  submittedAt DateTime @default(now())
  score       Float? // Final score for the submission
  feedback    String?

  reviewedById String?   @db.ObjectId // Educator who reviewed it
  reviewedBy   Educator? @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Field for online exam answers
  answers Json? // Stores the student's answers in a flexible JSON format

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([examId, studentId]) // A student can only submit one exam per exam
  @@index([examId])
  @@index([studentId])
  @@index([reviewedById])
}

// Enums used in the models
enum ExamType {
  HOMEWORK
  PROJECT
  QUIZ
  UNIT_TEST
  MIDTERM
  FINAL
  ASSIGNMENT_BASED // If some assignments are considered exams
  PRACTICE
  PRACTICAL
  ESSAY_SUBMISSION // For exams that are primarily essay submissions
  PROJECT_ASSESSMENT // For exams that are project-based
  OTHER
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  FILL_IN_THE_BLANK
  MATCHING
  NUMERIC
}

// Enum for Course Material Type
enum CourseMaterialType {
  DOCUMENT // PDF, DOC, PPT
  VIDEO
  LINK // External website
  IMAGE
  AUDIO
  OTHER
}

// Course Material Model
// Stores links to various educational resources for a course.
model CourseMaterial {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  courseId     String             @db.ObjectId
  course       Course             @relation(fields: [courseId], references: [id])
  title        String
  description  String?
  fileUrl      String? // URL for downloadable files (PDFs, docs)
  linkUrl      String? // URL for external links (videos, websites)
  type         CourseMaterialType @default(DOCUMENT) // Enum: DOCUMENT, VIDEO, LINK, IMAGE, AUDIO
  uploadedById String             @db.ObjectId // Educator who uploaded the material
  uploadedBy   Educator           @relation("UploadedMaterial", fields: [uploadedById], references: [id])
  createdAt    DateTime?          @default(now())
  updatedAt    DateTime?          @updatedAt
  Educator     Educator?          @relation(fields: [educatorId], references: [id])
  educatorId   String?            @db.ObjectId

  @@index([courseId, type])
  @@index([uploadedById])
}

// Discussion Topic Model
// Represents a discussion forum topic within a course or globally.
model DiscussionTopic {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  courseId String? @db.ObjectId // Optional: if topic is specific to a course
  course   Course? @relation(fields: [courseId], references: [id])
  title    String
  content  String? // Initial post content

  createdById String   @db.ObjectId // User (Educator or Student) who created the topic
  createdBy   Educator @relation("CreatedDiscussionTopic", fields: [createdById], references: [id])

  posts     DiscussionPost[] // All posts within this topic
  createdAt DateTime?        @default(now())
  updatedAt DateTime?        @updatedAt

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  @@index([courseId])
  @@index([createdById])
  @@index([companyId])
}

// Discussion Post Model
// Represents an individual post or reply within a discussion topic.
model DiscussionPost {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  topicId     String           @db.ObjectId
  topic       DiscussionTopic  @relation(fields: [topicId], references: [id])
  parentId    String?          @db.ObjectId // Optional: For replies to other posts
  parent      DiscussionPost?  @relation("ReplyToPost", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Self-referencing
  content     String
  createdById String           @db.ObjectId // User (Educator or Student) who created the post
  createdBy   User             @relation("CreatedDiscussionPost", fields: [createdById], references: [id])
  replies     DiscussionPost[] @relation("ReplyToPost") // Replies to this post
  createdAt   DateTime?        @default(now())
  updatedAt   DateTime?        @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  DiscussionComment DiscussionComment[]

  @@index([topicId])
  @@index([parentId])
  @@index([createdById])
}

model DiscussionComment {
  id     String         @id @default(auto()) @map("_id") @db.ObjectId
  postId String         @db.ObjectId
  post   DiscussionPost @relation(fields: [postId], references: [id])

  // commentId    String?             @db.ObjectId // For replies to other comments
  // comment      DiscussionComment?  @relation("ReplyToComment", fields: [commentId], references: [id])

  content String

  createdById String @db.ObjectId // User (Educator or Student) who created the comment
  createdBy   User   @relation("CreatedDiscussionComment", fields: [createdById], references: [id])

  // replies DiscussionComment[] @relation("ReplyToComment") // Replies to this comment

  createdAt           DateTime? @default(now())
  updatedAt           DateTime? @updatedAt
  // DiscussionComment   DiscussionComment? @relation("ReplyToComment", fields: [discussionCommentId], references: [id])
  discussionCommentId String?   @db.ObjectId

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  @@index([postId])
  // @@index([commentId])
  @@index([createdById])
}

// Department Model
// Represents an academic or administrative department within the school.
model Department {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String // e.g., "Mathematics", "English", "Administration"
  description String?

  headId String?   @db.ObjectId // Optional: Link to the User (Educator/Admin) who heads the department
  head   Educator? @relation("DepartmentHead", fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  educators Educator[] // Educators belonging to this department
  courses   Course[] // Courses offered by this department

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  Company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  @@unique([companyId, name])
  @@index([name])
}

// Grade Model
// Represents a student's grade for a specific course or exam.
model Grade {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  studentId String  @db.ObjectId
  student   Student @relation(fields: [studentId], references: [id])

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  examId String? @db.ObjectId // Optional: Grade might not be tied to a specific exam
  exam   Exam?   @relation(fields: [examId], references: [id])

  courseAssignmentId String?           @db.ObjectId // Optional: Grade might not be tied to a specific exam
  courseAssignment   CourseAssignment? @relation(fields: [courseAssignmentId], references: [id])

  score       Float
  gradeValue  String? // e.g., "A", "B+", "Pass"
  gradeStatus GradeStatus? // Enum: PASSED, FAILED, PENDING
  comments    String?

  recordedById String?   @db.ObjectId // Educator who recorded this grade
  recordedBy   Educator? @relation("recordedBy", fields: [recordedById], references: [id])

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  // NEW FIELD: Link to the academic level the student was in when this grade was recorded
  // This is crucial for historical reporting by academic level.
  academicLevelAtTimeOfGradingId String        @db.ObjectId
  academicLevelAtTimeOfGrading   AcademicLevel @relation("gradesEarned", fields: [academicLevelAtTimeOfGradingId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([studentId])
  @@index([courseId])
