enum WhatsAppConversationStatus {
  OPEN
  PENDING
  WAITING_FOR_CUSTOMER
  WAITING_FOR_AGENT
  RESOLVED
  CLOSED
}

enum WhatsAppConversationMode {
  AI
  HUMAN
  HYBRID
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppSenderType {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  INTERACTIVE
  BUTTON
  LIST
  TEMPLATE
  REACTION
  UNKNOWN
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model WhatsAppAccount {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @db.ObjectId
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessAccountId String?
  phoneNumberId String @unique
  phoneNumber String?
  displayName String?
  accessTokenEncrypted String?
  accessTokenIv        String?
  accessTokenTag       String?
  appId String?
  appSecretEncrypted String?
  appSecretIv        String?
  appSecretTag       String?
  webhookVerifyTokenEncrypted String?
  webhookVerifyTokenIv        String?
  webhookVerifyTokenTag       String?
  environment WhatsAppEnvironment @default(PRODUCTION)
  status WhatsAppAccountStatus @default(DISCONNECTED)
  isActive Boolean @default(true)
  lastConnectedAt DateTime?
  lastWebhookAt   DateTime?
  lastError       String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts      WhatsAppContact[]
  conversations WhatsAppConversation[]
  messages      WhatsAppMessage[]
  templates     WhatsAppTemplate[]
  webhookEvents WhatsAppWebhookEvent[]
  campaigns     WhatsAppCampaign[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([businessAccountId])
  @@index([companyId, isDefault])
}

enum WhatsAppEnvironment {
  DEVELOPMENT
  SANDBOX
  PRODUCTION
}

enum WhatsAppAccountStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  ERROR
  SUSPENDED
}

model WhatsAppContact {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountId String?          @db.ObjectId
  account   WhatsAppAccount? @relation(fields: [accountId], references: [id])

  // WhatsApp identity
  waId        String
  phoneNumber String

  name      String?
  firstName String?
  lastName  String?

  profileName    String?
  profilePicture String?

  email String?

  // Optional link to your existing User
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  // Customer preferences
  language String? @default("en")

  optedIn    Boolean   @default(false)
  optedInAt  DateTime?
  optedOutAt DateTime?

  blocked   Boolean   @default(false)
  blockedAt DateTime?

  lastSeenAt    DateTime?
  lastMessageAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations WhatsAppConversation[]
  messages      WhatsAppMessage[]
  campaigns     WhatsAppCampaignRecipient[]
  return        Return?                     @relation(fields: [returnId], references: [id])
  returnId      String?                     @db.ObjectId

  @@unique([companyId, waId])
  @@index([companyId])
  @@index([phoneNumber])
  @@index([userId])
  @@index([lastMessageAt])
}

enum WhatsAppConversationState {
  GENERAL
  ORDER
  APPOINTMENT
  PAYMENT
  SUPPORT
  SALES
  BOOKING
  FEEDBACK
  INQUIRY
  COMPLAINT
  FOLLOW_UP
  PROMOTION
  OTHER
}

model WhatsAppConversation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ============================================================
  // TENANCY
  // ============================================================

  companyId String? @db.ObjectId

  company Company? @relation(fields: [companyId], references: [id])

  // ============================================================
  // WHATSAPP IDENTITY
  // ============================================================

  phoneNumber String

  waId String?

  customerName  String?
  customerEmail String?

  // ============================================================
  // CONVERSATION STATE
  // ============================================================

  state String? @default("GENERAL")

  status WhatsAppConversationStatus @default(OPEN)

  mode WhatsAppConversationMode @default(AI)

  interactionStatus OrderInteractionStatus @default(ACTIVE)

  subject String?

  // ============================================================
  // AI STATE
  // ============================================================

  aiEnabled Boolean @default(true)

  aiPaused Boolean @default(false)

  humanHandoff Boolean @default(false)

  aiSummary String?

  aiIntent String?

  aiSentiment String?

  aiConfidence Float?

  context Json?

  cart Json?

  customerProfile Json?

  // ============================================================
  // WHATSAPP 24-HOUR WINDOW
  // ============================================================

  lastCustomerMessageAt DateTime?

  lastBusinessMessageAt DateTime?

  customerWindowExpiresAt DateTime?

  // ============================================================
  // AGENT ASSIGNMENT
  // ============================================================

  assignedUserId String? @db.ObjectId
  assignedUser   User?   @relation("WhatsAppConversationAssignee", fields: [assignedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  assignedAgentId String? @db.ObjectId

  assignedAgent WhatsAppAgent? @relation(fields: [assignedAgentId], references: [id])

  // ============================================================
  // TIMESTAMPS
  // ============================================================

  startedAt DateTime @default(now())

  closedAt DateTime?

  lastMessageAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ============================================================
  // RELATIONS
  // ============================================================

  messages WhatsAppMessage[]

  orders CustomerOrder[]

  aiActions AIAction[]

  whatsAppAIToolCalls WhatsAppAIToolCall[]

  appointments Appointment[]

  // ============================================================
  // INDEXES
  // ============================================================
  WhatsAppAccount   WhatsAppAccount? @relation(fields: [whatsAppAccountId], references: [id])
  whatsAppAccountId String?          @db.ObjectId
  WhatsAppContact   WhatsAppContact? @relation(fields: [whatsAppContactId], references: [id])
  whatsAppContactId String?          @db.ObjectId

  @@unique([companyId, phoneNumber])
  @@index([companyId])
  @@index([phoneNumber])
  @@index([waId])
  // @@index([companyId, phoneNumber])
  @@index([interactionStatus])
  @@index([status])
  @@index([assignedUserId])
  @@index([assignedAgentId])
  @@index([lastMessageAt])
}

model WhatsAppMessage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ============================================================
  // RELATIONS
  // ============================================================

  conversationId String @db.ObjectId

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  companyId String? @db.ObjectId

  company Company? @relation(fields: [companyId], references: [id])

  accountId String? @db.ObjectId

  account WhatsAppAccount? @relation(fields: [accountId], references: [id])

  contactId String? @db.ObjectId

  contact WhatsAppContact? @relation(fields: [contactId], references: [id])

  // ============================================================
  // META MESSAGE ID
  // ============================================================

  whatsappMessageId String?

  externalMessageId String?

  // ============================================================
  // MESSAGE
  // ============================================================

  direction WhatsAppMessageDirection

  senderType WhatsAppSenderType

  type WhatsAppMessageType @default(TEXT)

  text String?

  // ============================================================
  // MEDIA
  // ============================================================

  mediaId String?

  mediaUrl String?

  mediaMimeType String?

  mediaCaption String?

  mediaFilename String?

  // ============================================================
  // LOCATION
  // ============================================================

  latitude Float?

  longitude Float?

  locationName String?

  locationAddress String?

  // ============================================================
  // INTERACTIVE
  // ============================================================

  interactiveType String?

  interactivePayload Json?

  // ============================================================
  // TEMPLATE
  // ============================================================

  templateId String? @db.ObjectId

  template WhatsAppTemplate? @relation(fields: [templateId], references: [id])

  templateName String?

  // ============================================================
  // AI
  // ============================================================

  isAI Boolean @default(false)

  aiModel String?

  aiPromptTokens Int?

  aiCompletionTokens Int?

  aiTotalTokens Int?

  aiConfidence Float?

  aiIntent String?

  aiToolUsed String?

  processedByAI Boolean @default(false)

  aiActions AIAction[]

  processingError String?

  // ============================================================
  // DELIVERY
  // ============================================================

  status WhatsAppMessageStatus @default(QUEUED)

  errorCode String?

  errorMessage String?

  sentAt DateTime?

  deliveredAt DateTime?

  readAt DateTime?

  failedAt DateTime?

  // ============================================================
  // THREADING / METADATA
  // ============================================================

  replyToMessageId String?

  payload Json?

  metadata Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ============================================================
  // AI TOOL CALLS
  // ============================================================

  whatsAppAIToolCalls WhatsAppAIToolCall[]

  // ============================================================
  // INDEXES
  // ============================================================

  @@unique([accountId, whatsappMessageId])
  @@index([conversationId, createdAt])
  @@index([companyId])
  @@index([accountId])
  @@index([contactId])
  @@index([externalMessageId])
  @@index([whatsappMessageId])
  @@index([direction])
  @@index([status])
  @@index([processedByAI])
  @@index([createdAt])
}

model WhatsAppAIConfig {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @unique @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  // AI provider
