/// Associates a Company with a specific Location,
/// allowing for company-specific overrides and settings for that location.
model CompanyLocation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Foreign keys to Company and Location
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId

  location   Location @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locationId String   @db.ObjectId

  // Company-specific overrides for the inherited location details.
  // If a field is null here, it means the Company uses the value from the base Location model.
  displayName          String? // e.g., "Acme Corp Headquarters" (overrides base location name)
  addressLine1Override String?
  addressLine2Override String?
  cityOverride         String?
  stateOverride        String?
  postalCodeOverride   String?
  countryOverride      String?
  latitudeOverride     Float?
  longitudeOverride    Float?

  // Company-specific settings for this location association
  sortOrder Int     @default(0)
  visible   Boolean @default(true) // Is this location visible for THIS company?

  // Audit fields
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Ensures a company can only have one specific entry for a given base location.
  @@unique([companyId, locationId])
  // Speeds up queries for a company's locations, ordered.
  @@index([companyId, sortOrder])
  @@index([companyId])
  @@index([locationId])
}

