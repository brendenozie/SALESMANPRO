// ============================================================
// FEE MANAGEMENT MODELS
// ============================================================

model FeeStructure {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId String             @db.ObjectId
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  year      String // Academic year, e.g., "2024/2025"
  term      String? // e.g., "Term 1", "Semester 1", or null for annual
  amount    Float // Total amount for this structure
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  items     FeeStructureItem[]

  @@unique([companyId, name, year, term])
  @@index([companyId])
}

model FeeStructureItem {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  feeStructureId String       @db.ObjectId
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  name           String // e.g., "Tuition", "Lab Fee", "Sports Fee"
  amount         Float
  isOptional     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([feeStructureId])
}

// ============================================================
// INVENTORY & ASSETS MODELS
// ============================================================

model Asset {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  category      AssetCategory
  purchaseDate  DateTime
  purchaseValue Float
  currentValue  Float?
  status        AssetStatus     @default(ACTIVE)
  companyId     String          @db.ObjectId
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serialNumber  String?
  location      String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tracking      AssetTracking[]

  @@index([companyId])
  @@index([category])
  @@index([status])
}

model AssetTracking {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  assetId     String              @db.ObjectId
  asset       Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action      AssetTrackingAction
  date        DateTime            @default(now())
  performedBy String?             @db.ObjectId // User ID who performed the action
  performer   User?               @relation("AssetTrackingPerformer", fields: [performedBy], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([assetId])
  @@index([action])
  @@index([date])
  @@index([performedBy])
}

model InventoryAudit {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String               @db.ObjectId
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditDate   DateTime
  conductedBy String               @db.ObjectId // User ID
  conductor   User                 @relation("InventoryAuditConductor", fields: [conductedBy], references: [id], onDelete: Restrict)
  status      InventoryAuditStatus @default(SCHEDULED)
  findings    String? // Summary of findings
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([auditDate])
  @@index([conductedBy])
}

// sales engine

model Lead {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  phone            String             @unique
  name             String?
  email            String?
  city             String?
  businessType     String?
  hasWebsite       Boolean?
  stage            String             @default("cold")
  tag              String?
  lastMessageAt    DateTime?
  createdAt        DateTime           @default(now())
  companyId        String             @db.ObjectId
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations    LeadConversation[]
  deals            Deal[]
  automationStatus String             @default("idle") // idle, queued, sent, failed
  lastPingAt       DateTime?
  scriptVersion    String? // A, B, or C
}

model LeadConversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId    String   @db.ObjectId
  message   String
  direction String // in | out
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model Deal {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId    String   @db.ObjectId
  price     Int
  monthly   Int
  plan      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model Expense {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseId     String   @unique // e.g., "EXP-4022"
  category      String   // Utilities, Maintenance, Rent, Salaries, Marketing, Fuel, Supplies, etc.
  description   String
  vendor        String
  amount        Float
  taxAmount     Float?   @default(0)
  paymentMethod String?  @default("CASH") // CASH, MPESA, BANK, CARD
  reference     String?
  costCenter    String?  @default("Operations")
  approvedBy    String?
  isRecurring   Boolean  @default(false)
  status        String   @default("Pending Approval") // Paid, Pending Approval, Processing, Approved, Rejected
  date          DateTime @default(now())
  receiptUrl    String?  // For the voucher/document button
  notes         String?
  companyId     String   @db.ObjectId
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, date])
  @@index([companyId, status])
  @@map("expenses")
}

// ============================================================
// CENTRAL AI PLATFORM MODELS & ENUMS
// ============================================================

enum AICapability {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  EMBEDDING
  AGENT
  WHATSAPP
  PRODUCT_CONTENT
  MARKETPLACE_CONTENT
  ANALYSIS
  SOCIAL_MARKETING
}

enum AICreditTransactionType {
  PURCHASE
  USAGE
  PROMOTIONAL
  REFUND
  ADJUSTMENT
  BONUS
  RESERVATION
  RELEASE
}

enum AICreditTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum AIGenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model AICreditTransaction {
  id              String                    @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String                    @db.ObjectId
  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String?                   @db.ObjectId
  user            User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount          Float                     // Positive for credit additions, negative for deductions
  type            AICreditTransactionType   @default(USAGE)
  status          AICreditTransactionStatus @default(COMPLETED)
  description     String
  idempotencyKey  String?                   @unique
  referenceId     String?                   // Payment ID, GenerationJob ID, or Usage ID
  balanceAfter    Float?
  metadata        Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([userId])
  @@index([type])
  @@index([status])
}

model AIUsage {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String       @db.ObjectId
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String?      @db.ObjectId
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  capability      AICapability @default(TEXT)
  provider        String       // OPENAI, GROQ, GEMINI, STABILITY, DALL_E, etc.
  model           String
  promptTokens    Int          @default(0)
  completionTokens Int         @default(0)
  totalTokens     Int          @default(0)
  inputUnits      Float        @default(0) // Token count, image count, video duration (secs)
  outputUnits     Float        @default(0)
  creditsCost     Float        @default(0)
  estimatedCost   Float        @default(0) // Fiat provider cost estimation
  source          String       @default("WEB") // WEB, WHATSAPP, API, AGENT, WORKER
  feature         String?      // e.g. "product_description", "marketplace_listing", "image_generation", "video_generation"
  status          String       @default("SUCCESS") // SUCCESS, FAILED, PARTIAL
  errorMessage    String?
  executionTimeMs Int?
  metadata        Json?
  idempotencyKey  String?
  createdAt       DateTime     @default(now())

  @@index([companyId])
  @@index([companyId, capability])
  @@index([companyId, createdAt])
  @@index([provider])
  @@index([feature])
  @@index([createdAt])
}

model AIGenerationJob {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String             @db.ObjectId
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String?            @db.ObjectId
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  capability      AICapability       @default(IMAGE)
  provider        String
  model           String
  action          String             // e.g. "GENERATE_IMAGE", "GENERATE_VIDEO", "PRODUCT_ENHANCE"
  status          AIGenerationStatus @default(QUEUED)
  prompt          String?
  negativePrompt  String?
  options         Json?              // aspect ratio, duration, quality, style, etc.
  inputAssets     Json?              // reference images, product ID, listing ID, etc.
  outputAssets    Json?              // generated media URLs, text content, video URLs
  mediaAssetId    String?            @db.ObjectId
  creditsReserved Float              @default(0)
  creditsConsumed Float              @default(0)
  progress        Int                @default(0)
  error           String?
  providerJobId   String?
  idempotencyKey  String?            @unique
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([userId])
  @@index([capability])
  @@index([status, createdAt])
}

model AIPackage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique // Starter, Growth, Professional, Enterprise
  credits     Int
  price       Float    // Price in USD / default currency
  currency    String   @default("USD")
  description String?
  badge       String?  // "Most Popular", "Best Value", "Starter Kit"
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  features    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([isPopular])
}

model PlatformAIProvider {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  provider              String         @unique // OPENAI, GEMINI, GROQ, etc.
  name                  String
  enabled               Boolean        @default(true)
  apiKeyEncrypted       String?
  apiKeyIv              String?
  apiKeyTag             String?
  connectionStatus      String         @default("NOT_CONFIGURED") // ACTIVE, ERROR, NOT_CONFIGURED
  lastVerifiedAt        DateTime?
  supportedCapabilities AICapability[]
  metadata              Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([enabled])
}

model PlatformAIModel {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  modelId            String       @unique // e.g. "gpt-4o-mini", "gemini-2.0-flash", "llama-3.3-70b-versatile"
  provider           String       // OPENAI, GEMINI, GROQ
  displayName        String
  description        String?
  capability         AICapability
  enabled            Boolean      @default(true)
  isDefault          Boolean      @default(false)
  inputCreditCost    Float        @default(1)
  outputCreditCost   Float        @default(2)
  fixedCreditCost    Float?
  maxTokens          Int?
  contextWindow      Int?
  supportsVision     Boolean      @default(false)
  supportsStreaming  Boolean      @default(true)
  supportsJsonSchema Boolean      @default(true)
  priority           Int          @default(0)
  fallbackModelId    String?
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([provider])
  @@index([capability])
  @@index([enabled])
}

model PlatformAIServiceConfig {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  serviceKey      String       @unique // e.g. "PRODUCT_DESCRIPTION", "PRODUCT_SEO", "IMAGE_GENERATION", "WHATSAPP_AI", "STORE_SETUP_AI"
  displayName     String
  description     String?
  capability      AICapability
  enabled         Boolean      @default(true)
  primaryModelId  String
  fallbackModelId String?
  creditCost      Float?
  maxTokens       Int?
  temperature     Float?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([capability])
  @@index([enabled])
}

model AIAuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  action     String   // e.g. "PROVIDER_CONFIGURED", "PROVIDER_ENABLED", "MODEL_ACTIVATED", "CREDIT_ADJUSTMENT"
  actorId    String?  @db.ObjectId
  actorEmail String?
  target     String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorEmail])
  @@index([createdAt])
}

// ============================================================
// SOCIAL MEDIA AI & MARKETING PLATFORM MODELS & ENUMS
// ============================================================

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
