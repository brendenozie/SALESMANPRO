model SubscriptionPayment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  subscriptionId String              @db.ObjectId
  subscription   SubscriptionCompany @relation(fields: [subscriptionId], references: [id])

  amount   Float
  currency String @default("USD")
  status   String // SUCCESS | FAILED | PENDING | REFUNDED | DISPUTED
  type     String // INITIAL | RENEWAL | UPGRADE | DOWNGRADE | PRORATION | REFUND

  gateway        String? // PAYSTACK | STRIPE | MPESA
  gatewayRef     String? // transaction reference from gateway
  gatewayMessage String? // optional "Insufficient funds", "Completed", etc.

  paidAt      DateTime?
  nextBilling DateTime?

  meta Json? // full gateway payload (Paystack event, Stripe webhook, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([type])
}

// A Patient is a specialized type of User
model Patient {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @unique @db.ObjectId
  user   User   @relation("patient", fields: [userId], references: [id])

  // Patient-specific info
  dateOfBirth DateTime?
  address     Json? // Store address details as JSON
  contactInfo Json? // Store phone, emergency contact as JSON

  appointments  Appointment[]
  prescriptions Prescription[]
  diagnoses     Diagnosis[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // @@index([userId])
}

// A medical diagnosis for a patient
model Diagnosis {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  doctorId  String  @db.ObjectId
  doctor    Doctor  @relation(fields: [doctorId], references: [id])
  patientId String  @db.ObjectId
  patient   Patient @relation(fields: [patientId], references: [id])
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  diagnosis String
  notes     String?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  // @@index([PAID])

  @@index([doctorId])
  @@index([patientId])
  @@index([companyId])
}

// InvoiceStatus Enum for billing
enum BillingInvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

// Represents a financial invoice for services rendered to a patient.
model PatientInvoices {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  patientId String @db.ObjectId // Link to the User (patient)
  patient   User   @relation("PatientInvoices", fields: [patientId], references: [id])

  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  amount      Float
  invoiceDate DateTime      @default(now())
  dueDate     DateTime? // Optional due date for payment
  status      InvoiceStatus @default(PENDING)
  items       Json[] // Store an array of objects or strings for invoice line items
  notes       String?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  BillingTransaction BillingTransaction[]

  @@index([patientId])
  @@index([companyId])
  @@index([status])
}

// Enum for Transaction types
enum TransactionType {
  SUBSCRIPTION
  REFUND
  ADD_ON_PURCHASE
}

// Enum for Transaction status
enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
  SUCCESS
}

// NEW: A separate model for all billing transactions
model BillingTransaction {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  userId          String            @db.ObjectId
  user            User              @relation(fields: [userId], references: [id])
  companyId       String            @db.ObjectId
  company         Company           @relation(fields: [companyId], references: [id])
  amount          Float
  currency        String            @default("USD")
  type            TransactionType
  status          TransactionStatus
  paymentMethod   String
  transactionDate DateTime          @default(now())
  description     String

  invoiceId String?          @db.ObjectId
  invoice   PatientInvoices? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([invoiceId])
  @@index([status])
}

// --- New Schema for Video Management ---

// A central model for all video assets.
// This allows a single video to be referenced by multiple other models
// (e.g., a Product, a Blog post, an ExamQuestion)
// New model to serve as a container for a group of videos
model VideoAlbum {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  tags        String[]

  // A single video album can have multiple videos
  videos Video[]

  // Relations for ownership
  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Content   Content[]
  Blog      Blog[]

  @@index([companyId])
  @@index([userId])
  @@index([tags])
}

// Refactored Video model
// This model now only stores information specific to an individual video
model Video {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  title        String?
  url          String? // The S3 URL of the video file
  description  String?
  thumbnailUrl String? // The URL of the video's thumbnail image
  duration     String? // Duration of the video in seconds
  views        Int         @default(0)
  status       VideoStatus @default(DRAFT)

  // Each video belongs to one VideoAlbum
  albumId String     @db.ObjectId
  album   VideoAlbum @relation(fields: [albumId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  tags      String[]

  // Add index for faster lookups
  // Add index for faster lookups
  @@index([albumId])
  @@index([companyId])
  @@index([userId])
  @@index([status])
}

// Enum for the video's lifecycle status
enum VideoStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum ContentStatus {
  Draft
  Scheduled
  Published
  Archived
}

// Add this enum if it doesn't exist, or ensure it includes VIDEO
enum ContentType {
  VIDEO
  ARTICLE
  IMAGE_GALLERY
  VIRTUAL_TOUR
  // 3D_MODEL
  INTERACTIVE_3D
  // 360_VIDEO
}

model Content {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  excerpt      String?
  description  String? // Use this for a longer description if needed
  contentUrl   String? // For video URL (e.g., YouTube embed URL)
  thumbnailUrl String? // For video thumbnail URL
  contentType  ContentType @default(VIDEO) // Set default to VIDEO for virtual tours
  category     String? // e.g., "Nature", "History", "Wildlife"
  duration     String? // e.g., "5 min", "7 min"
  location     String? // ADD THIS FIELD for location
  tags         String[] // For additional keywords/tags
  companyId    String      @db.ObjectId
  company      Company     @relation(fields: [companyId], references: [id])
  published    Boolean     @default(false) // Whether the tour is live

  type        String? // e.g., "Article", "PhotoAlbum", "VideoAlbum"
  status      ContentStatus @default(Draft)
  publishDate DateTime?
  author      User?         @relation(fields: [authorId], references: [id])
  authorId    String?       @db.ObjectId

  // New relations for albums
  photoAlbum   PhotoAlbum? @relation(fields: [photoAlbumId], references: [id])
  photoAlbumId String?     @db.ObjectId

  videoAlbum   VideoAlbum? @relation(fields: [videoAlbumId], references: [id])
  videoAlbumId String?     @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([photoAlbumId])
  @@index([videoAlbumId])
  @@index([companyId])
  @@index([tags])
  @@index([status])
}

// New model to serve as a container for a group of photos
model PhotoAlbum {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  tags        String[]

  // A single photo album can have multiple photos
  photos Photo[]

  // Relations for ownership
  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Content   Content[]
  Blog      Blog[]

  @@index([companyId])
  @@index([userId])
  @@index([tags])
}

// Refactored Photo model
// This model now only stores information specific to an individual image
model Photo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl    String // The S3 or cloud storage URL of the photo file
  altText     String? // For accessibility and SEO
  title       String?
  description String?
  tags        String[]

  // Each photo belongs to one PhotoAlbum
  albumId String     @db.ObjectId
  album   PhotoAlbum @relation(fields: [albumId], references: [id])

  Company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId])
  @@index([companyId])
  @@index([userId])
}

// Model for managing sponsors and partners
model Sponsor {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  companyName  String
