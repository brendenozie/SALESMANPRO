// ============================================================
// FEE MANAGEMENT MODELS
// ============================================================

model FeeStructure {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId String             @db.ObjectId
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  year      String // Academic year, e.g., "2024/2025"
  term      String? // e.g., "Term 1", "Semester 1", or null for annual
  amount    Float // Total amount for this structure
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  items     FeeStructureItem[]

  @@unique([companyId, name, year, term])
  @@index([companyId])
}

model FeeStructureItem {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  feeStructureId String       @db.ObjectId
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  name           String // e.g., "Tuition", "Lab Fee", "Sports Fee"
  amount         Float
  isOptional     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([feeStructureId])
}

// ============================================================
// INVENTORY & ASSETS MODELS
// ============================================================

model Asset {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  category      AssetCategory
  purchaseDate  DateTime
  purchaseValue Float
  currentValue  Float?
  status        AssetStatus     @default(ACTIVE)
  companyId     String          @db.ObjectId
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serialNumber  String?
  location      String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tracking      AssetTracking[]

  @@index([companyId])
  @@index([category])
  @@index([status])
}

model AssetTracking {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  assetId     String              @db.ObjectId
  asset       Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action      AssetTrackingAction
  date        DateTime            @default(now())
  performedBy String?             @db.ObjectId // User ID who performed the action
  performer   User?               @relation("AssetTrackingPerformer", fields: [performedBy], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([assetId])
  @@index([action])
  @@index([date])
  @@index([performedBy])
}

model InventoryAudit {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String               @db.ObjectId
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditDate   DateTime
  conductedBy String               @db.ObjectId // User ID
  conductor   User                 @relation("InventoryAuditConductor", fields: [conductedBy], references: [id], onDelete: Restrict)
  status      InventoryAuditStatus @default(SCHEDULED)
  findings    String? // Summary of findings
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([auditDate])
  @@index([conductedBy])
}

// sales engine

model Lead {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  phone            String             @unique
  name             String?
  email            String?
  city             String?
  businessType     String?
  hasWebsite       Boolean?
  stage            String             @default("cold")
  tag              String?
  lastMessageAt    DateTime?
  createdAt        DateTime           @default(now())
  companyId        String             @db.ObjectId
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations    LeadConversation[]
  deals            Deal[]
  automationStatus String             @default("idle") // idle, queued, sent, failed
  lastPingAt       DateTime?
  scriptVersion    String? // A, B, or C
}

model LeadConversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId    String   @db.ObjectId
  message   String
  direction String // in | out
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model Deal {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId    String   @db.ObjectId
  price     Int
  monthly   Int
  plan      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}
