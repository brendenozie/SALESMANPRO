// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Consumer          Consumer?   @relation(fields: [userId], references: [id])
  SalesAgent        SalesAgent? @relation(fields: [userId], references: [id])
  Client            Client?     @relation(fields: [userId], references: [id])
  Student           Student?    @relation(fields: [studentId], references: [id])
  studentId         String?     @db.ObjectId
  EducatorProfile   Educator?   @relation(fields: [educatorProfileId], references: [id])
  educatorProfileId String?     @db.ObjectId

  @@unique([provider, providerAccountId])
}

enum ROLE {
  USER
  AGENT
  CLIENT
  ADMIN
  STUDENT
  EDUCATOR
  HEADTEACHER
}

model Session {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken      String      @unique
  expires           DateTime
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String      @db.ObjectId
  role              ROLE?       @default(USER)
  Consumer          Consumer?   @relation(fields: [consumerId], references: [id])
  consumerId        String?     @db.ObjectId
  SalesAgent        SalesAgent? @relation(fields: [salesAgentId], references: [id])
  salesAgentId      String?     @db.ObjectId
  Client            Client?     @relation(fields: [clientId], references: [id])
  clientId          String?     @db.ObjectId
  Student           Student?    @relation(fields: [studentId], references: [id])
  studentId         String?     @db.ObjectId
  EducatorProfile   Educator?   @relation(fields: [educatorProfileId], references: [id])
  educatorProfileId String?     @db.ObjectId
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model CompanyCategory {
  id      String    @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  icon    String?
  image   String?
  status  String
  Company Company[]
}

// Category model with self-relations for hierarchy (categories & subcategories)
model ProductCategory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  icon            String?
  image           String?
  slug            String   @unique
  description     String
  longDescription String
  seoTitle        String
  seoDescription  String
  metaKeywords    String[]
  sortOrder       Int
  visible         Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  updatedBy       String
  status          String
  allBrands       String[]
  tags            String[]

  // Hierarchy pointers
  subcategories Json // Store subcategories as a JSON array

  // Media & SEO assets
  imageAlt    String
  thumbnail   String?
  bannerImage String?

  // Localization
  localization Json

  // Dynamic fields
  productCount   Int
  isFeatured     Boolean
  showInHomepage Boolean

  // Custom attributes
  attributes Json

  Product            Product[]
  MarketplaceListing MarketplaceListing[]
  StoreCategory      StoreCategory[]
}

/// Associates a Company with a ProductCategory,
/// plus any store-specific settings.
model StoreCategory {
  company    Company         @relation(fields: [companyId], references: [id])
  companyId  String          @db.ObjectId
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId String          @db.ObjectId

  // Store-specific overrides:
  displayName String? // e.g. “Gadgets” instead of “Tech Gadgets”
  icon        String? // override the global icon
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)

  id String @id @default(auto()) @map("_id") @db.ObjectId // Add a single primary key
  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt

  // You still store each category’s children in JSON:
  items     Json? // e.g. [ { id: "...", name: "...", slug: "...", … }, … ]
  allBrands Json? // e.g. [ { id: "...", name: "...", slug: "...", … }, … ]

  // @@id([companyId, categoryId])
  @@unique([companyId, categoryId]) // Use a unique constraint instead
  @@index([companyId, sortOrder]) // speed up ordering queries
}

model Company {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  tagline     String? // short marketing line
  description String?

  hasWebsite Boolean? @default(false)

  companyCategoryId String?          @db.ObjectId
  companyCategory   CompanyCategory? @relation(fields: [companyCategoryId], references: [id])
  category          String
  logoUrl           String?
  bannerUrl         String?
  heroSlides        Banner[] // relational banners/slides
  contactEmail      String
  contactPhone      String?
  site              String?          @default("default")
  address           String?
  geoLocation       Json? // { lat: number, lng: number }
  openingHours      Json? // { mon: "9–5", tue: "...", … }
  domain            String?          @unique
  currency          String           @default("KES")
  locale            String           @default("en-US")
  socialLinks       SocialLink[] // structured social profiles
  policies          Policy[] // structured, editable policies
  faqs              FAQ[] // common questions
  testimonials      Testimonial[] // customer quotes
  promotions        Promotion[] // site-wide deals

  pricingTiers Json[] // ServicePricingTier name, description, price, duration, features[]

  themeSettings Json? // colors, fonts, layout toggles
  seo           SEO?  @relation(fields: [sEOId], references: [id]) // SEO settings

  StoreCategory StoreCategory[]

  // existing relations
  user            User?            @relation(fields: [userId], references: [id])
  userId          String?          @db.ObjectId
  salesAgents     SalesAgent[]
  products        Product[]
  inventory       InventoryItem[]
  clients         Client[]
  productRequests Request[]
  Target          Target[]
  commissions     Commission[]
  commissionsRate CommissionRate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  sEOId     String?   @db.ObjectId

  PageSection PageSection[]
  Collection  Collection[]

  MarketplaceListing MarketplaceListing[]

  analyticsConfig   AnalyticsConfig? @relation(fields: [analyticsConfigId], references: [id])
  analyticsConfigId String?          @db.ObjectId

  paymentSettings   PaymentSettings? @relation(fields: [paymentSettingsId], references: [id])
  paymentSettingsId String?          @db.ObjectId

  shippingSettings   ShippingSettings? @relation(fields: [shippingSettingsId], references: [id])
  shippingSettingsId String?           @db.ObjectId

  awards     Json?
  metrics    Json?
  stats      Json?
  AppPromo   AppPromo[]
  Blog       Blog[]
  Department Department[]
}

enum CategoryStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model SocialLink {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  company   Company       @relation(fields: [companyId], references: [id])
  companyId String        @db.ObjectId
  channel   SocialChannel
  url       String
}

model Policy {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  company   Company    @relation(fields: [companyId], references: [id])
  companyId String     @db.ObjectId
  type      PolicyType
  title     String?
  content   String
}

model FAQ {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId
  question  String
  answer    String
  order     Int     @default(0)
}

model Testimonial {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId
  author    String
  quote     String
  avatarUrl String?
  rating    Int? // 1–5 stars
  order     Int     @default(0)
}

model Banner {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  company         Company   @relation(fields: [companyId], references: [id])
  companyId       String    @db.ObjectId
  imageUrl        String
  productImageUrl String?
  headline        String?
  subline         String?
  ctaText         String?
  ctaLink         String?
  badgeText       String?
  price           String?
  endsAt          DateTime?
  order           Int       @default(0)
}

model Promotion {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   String    @db.ObjectId
  code        String?
  title       String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  ctaText     String?
  ctaLink     String?
  bannerUrl   String?
}

model AnalyticsConfig {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  googleTag   String?
  facebookTag String?
  Company     Company[]
}

model PaymentSettings {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  stripeKey           String?
  paypalKey           String?
  mpesaShortcode      String?
  mpesaConsumerKey    String?
  mpesaConsumerSecret String?
  mpesaCallbackUrl    String?
  Company             Company[]
}

model ShippingSettings {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  carrierName        String?
  trackingUrl        String?
  regions            Json?
  enablePickup       Boolean?
  pickupInstructions String?
  Company            Company[]
}

model PageSection {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  company   Company     @relation(fields: [companyId], references: [id])
  companyId String      @db.ObjectId
  type      SectionType
  order     Int         @default(0)
  settings  Json // e.g. { background: "dark", padding: "xl" }
  content   Json // e.g. { headline: "...", blocks: [ ... ] }
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum SectionType {
  Hero
  FeatureGrid
  TestimonialCarousel
  BlogPreview
  CustomHtml
  About
  Services
  Awards
  HealthTips
  Features
  HowItWorks
  Pricing
  CTA
  Metrics
  Stats
  // …add more as needed
}

enum SocialChannel {
  TWITTER
  INSTAGRAM
  FACEBOOK
  LINKEDIN
}

enum PolicyType {
  SHIPPING
  RETURNS
  PRIVACY
  TERMS
}

model Locations {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
}

model AppPromo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String?  @db.ObjectId
  company     Company? @relation(fields: [companyId], references: [id])
  headline    String
  subheading  String
  buttons     Json // e.g. [{ label: "Download", href: "...", icon: "apple" }]
  screenshots String[] // array of image URLs
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  category     String?
  subCategory  Json?
  images       Json[]
  video        String?
  tags         String[]
  profitMargin Float?   @default(0)
  brand        String?
  companyId    String?  @db.ObjectId
  company      Company? @relation(fields: [companyId], references: [id])

  productCategoryId  String?              @db.ObjectId
  productCategory    ProductCategory?     @relation(fields: [productCategoryId], references: [id])
  inventoryItems     InventoryItem[]
  requests           Request[]            @relation("ProductRequests")
  commissions        Commission[]
  Target             Target[]
  CommissionRate     CommissionRate?
  MarketplaceListing MarketplaceListing[]

  model     String?
  color     String[]
  size      String[]
  weight    String?
  condition String?
  dimension String?
  material  String[]

  // New fields for category-specific details:
  author    String? // For Books
  publisher String? // For Books
  isbn      String? // For Books

  fabricComposition String? // For Clothing/Fashion
  careInstructions  String? // For Clothing/Fashion

  energyRating        String? // For Home Appliances
  warrantyPeriod      String? // For Home Appliances
  applianceDimensions String? // For Home Appliances – renamed to avoid conflict with 'dimension'

  ingredients       String? // For Beauty Products
  usageInstructions String? // For Beauty Products
  expirationDate    DateTime? // For Beauty Products

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discount Int? @default(0)

  isAvailable  Boolean @default(true)
  isOnOffer    Boolean @default(false)
  isFlashDeal  Boolean @default(false)
  isNewArrival Boolean @default(false)
  isDiscounted Boolean @default(false)
  isFeatured   Boolean @default(false)

  startDealDate DateTime?
  endDealDate   DateTime?

  costPrice  Float
  salesPrice Float
  finalPrice Float? @default(0) //Price inclusive discount

  contact   String?
  location  Json? // GeoJSON format { type: "Point", coordinates: [lng, lat] }
  amenities String[]

  myLocation Location? @relation(fields: [locationId], references: [id])
  locationId String?   @db.ObjectId

  // 15. Property-specific
  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id])
  propertyTypeId String?       @db.ObjectId

  bathrooms String?
  area      String?
  bedrooms  Json? // Updated to support multiple bedroom types
  studios   Json? // Updated to support multiple bedroom types

  serviceSchedule String?
  // Marketplace-specific
  delivery        Boolean  @default(false)
  paymentOption   String   @default("AT SHOP")
  showOnGhuba     Boolean? @default(true)
  subCategoryName String?
  make            String?
  trim            String?
  type            String?
  mileage         String?
  engineType      String?
  engineSize      String?
  transmission    String?
  drivetrain      String?
  vin             String?
  logbookStatus   String?
  serviceHistory  String?

  // 11. Digital-Goods-specific
  digitalUrl  String?
  autoDeliver Boolean? @default(false)

  // 3. Vehicle Flags
  negotiable         Boolean? @default(false)
  financingAvailable Boolean? @default(false)
  tradeIn            Boolean? @default(false)

  // 5. Pricing Breakdown
  tax          Float? @default(0)
  shippingCost Float? @default(0)

  // 6. Availability Scheduling
  availabilityStart DateTime?
  availabilityEnd   DateTime?

  // 7. Structured Location / Contact
  email        String?
  locationName String?
  latitude     Float?
  longitude    Float?
  contactName  String?

  status         ListingStatus    @default(ACTIVE)
  Collection     Collection?      @relation(fields: [collectionId], references: [id])
  collectionId   String?          @db.ObjectId
  CollectionItem CollectionItem[]
  Review         Review[]
  Question       Question[]
  RecentlyViewed RecentlyViewed[]
  WishlistItem   WishlistItem[]

  @@index([name])
  @@index([finalPrice])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([status])
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  user          User          @relation(fields: [userId], references: [id])
  userId        String        @db.ObjectId
  order         CustomerOrder @relation(fields: [orderId], references: [id])
  orderId       String        @db.ObjectId
  amount        Float
  status        PaymentStatus
  transactionId String        @unique
  createdAt     DateTime      @default(now())
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

model Appointment {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  user      User              @relation(fields: [userId], references: [id])
  userId    String            @db.ObjectId
  date      DateTime
  status    AppointmentStatus
  createdAt DateTime          @default(now())
  OrderItem OrderItem[]
}

model PropertyType {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String               @unique
  description        String?
  products           Product[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  MarketplaceListing MarketplaceListing[]
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Blog {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  company     Company    @relation(fields: [companyId], references: [id])
  companyId   String     @db.ObjectId
  title       String     @unique
  slug        String     @unique
  content     String
  isFeature   Boolean    @default(false)
  excerpt     String? //@db.VarChar(300) // Short summary
  coverImage  String? // URL to the blog's cover image
  categories  String[] // Array of category names
  tags        String[] // Array of relevant tags
  author      Json? // name profileImage
  seo         SeoBlog?
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  views       Int        @default(0)
  likes       Int        @default(0)
  comments    Comment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SeoBlog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  keywords    String[]
  blogId      String   @unique @db.ObjectId
  blog        Blog     @relation(fields: [blogId], references: [id])
}

model SEO {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  keywords    String[]
  Company     Company[]
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      String
  comment   String
  createdAt DateTime @default(now())
  blogId    String   @db.ObjectId
  blog      Blog     @relation(fields: [blogId], references: [id])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ListingStatus {
  BUY
  RENT
  SOLD
  RENTED
  ACTIVE
  INACTIVE
}

model Task {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  taskName    String
  dueDate     DateTime  @db.Date
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @db.ObjectId
  dueTime     String
  description String?
  icon        String?
  status      String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

model Client {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  name              String?
  password          String?
  email             String              @unique
  phoneNumber       String?
  companyId         String              @db.ObjectId
  company           Company?            @relation(fields: [companyId], references: [id])
  salesAgentId      String?             @db.ObjectId
  salesAgent        SalesAgent?         @relation(fields: [salesAgentId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  communications    Communication[]     @relation("CommunicationReceiver")
  ClientInventory   ClientInventory[]
  AgentInventoryLog AgentInventoryLog[]
  emailVerified     DateTime?
  image             String?
  phone             String?
  username          String?
  bio               String?
  address           String?
  profilePicture    String?
  role              ROLE?               @default(CLIENT)
  accounts          Account[]
  sessions          Session[]
}

model Communication {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String     @db.ObjectId
  sender     SalesAgent @relation("CommunicationSender", fields: [senderId], references: [id])
  receiverId String     @db.ObjectId
  receiver   Client     @relation("CommunicationReceiver", fields: [receiverId], references: [id])
  subject    String?
  message    String
  createdAt  DateTime   @default(now())
}

model SalesAgent {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String?
  email              String               @unique
  image              String?
  accounts           Account[]
  sessions           Session[]
  phoneNumber        String?
  companyId          String?              @db.ObjectId
  company            Company?             @relation(fields: [companyId], references: [id])
  clients            Client[]
  productRequests    Request[]
  password           String?
  role               ROLE?                @default(AGENT)
  emailVerified      DateTime?
  phone              String?
  username           String?
  bio                String?
  address            String?
  profilePicture     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  commissions        Commission[]
  communications     Communication[]      @relation("CommunicationSender")
  Return             Return[]
  AgentInventory     AgentInventory[]
  Assignment         ProductAssignment[]
  Target             Target[]
  ClientInventory    ClientInventory[]
  ClientInventoryLog ClientInventoryLog[]
}

model User {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String              @unique
  password       String?
  role           ROLE?               @default(ADMIN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  accounts       Account[]
  sessions       Session[]
  tasks          Task[]
  auditLogs      AuditLog[]
  requests       Request[]
  returns        Return[]
  Assignment     ProductAssignment[]
  emailVerified  DateTime?
  image          String?
  phone          String?
  username       String?
  bio            String?
  address        String?
  profilePicture String?

  ProductReview         ProductReview[]
  ProductReviewLog      ProductReviewLog[]
  ProductReviewResponse ProductReviewResponse[]
  ProductReviewLike     ProductReviewLike[]
  ProductReviewDislike  ProductReviewDislike[]
  Company               Company[]
  Review                Review[]
  Question              Question[]
  RecentlyViewed        RecentlyViewed[]
  Wishlist              Wishlist[]
  Payment               Payment[]
  Appointment           Appointment[]
  Announcement          Announcement[]

  // If an admin can also post announcements, link directly from User
  announcements    Announcement[]     @relation("UserAnnouncements")
  DiscussionTopic  DiscussionTopic[]
  DiscussionPost   DiscussionPost[]
  AttendanceRecord AttendanceRecord[]

  // Opposite relation for DiscussionPost.createdBy
  CreatedDiscussionPost DiscussionPost[] @relation("CreatedDiscussionPost")

  Department Department[]

  // Opposite relation for DepartmentHead
  headedDepartments Department[] @relation("DepartmentHead")
}

enum Status {
  PENDING
  APPROVED
  DENIED
}

model Return {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  inventoryId   String        @db.ObjectId
  inventoryItem InventoryItem @relation(fields: [inventoryId], references: [id])
  returnedById  String        @db.ObjectId
  returnedBy    SalesAgent    @relation(fields: [returnedById], references: [id])
  ApprovedBy    User?         @relation(fields: [ApprovedById], references: [id])
  ApprovedById  String?       @db.ObjectId
  quantity      Int
  reason        String?
  status        Status        @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ProductAssignment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  ApprovedBy       User?         @relation(fields: [ApprovedById], references: [id])
  ApprovedById     String?       @db.ObjectId
  salesAgentId     String        @db.ObjectId
  salesAgent       SalesAgent    @relation(fields: [salesAgentId], references: [id])
  inventoryItemId  String        @db.ObjectId
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityAssigned Int
  reason           String? // Optional reason for assignment
  createdAt        DateTime      @default(now())
}

model InventoryItem {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  productId        String              @db.ObjectId
  product          Product             @relation(fields: [productId], references: [id])
  companyId        String              @db.ObjectId
  company          Company             @relation(fields: [companyId], references: [id])
  quantity         Int
  reorderThreshold Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  inventoryLogs    InventoryLog[]
  returns          Return[]
  AgentInventory   AgentInventory[]
  Assignment       ProductAssignment[]
  ClientInventory  ClientInventory[]
}

model InventoryLog {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  inventoryId   String        @db.ObjectId
  inventoryItem InventoryItem @relation(fields: [inventoryId], references: [id])
  damaged       Int           @default(0)
  action        String
  quantity      Int
  createdAt     DateTime      @default(now())
}

model AgentInventory {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId      String              @db.ObjectId
  salesAgent        SalesAgent          @relation(fields: [salesAgentId], references: [id])
  inventoryItemId   String              @db.ObjectId
