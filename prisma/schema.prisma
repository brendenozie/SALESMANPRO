  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  issuances    LibraryIssuance[]
  reservations LibraryReservation[]

