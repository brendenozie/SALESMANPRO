// Represents a customer's subscription to a specific plan.
model Subscription {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // on specific website we use userId to register subscriptions
  // but on main dashboards site we use companyId to register subscriptions

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  companyId String?  @db.ObjectId
  company   Company? @relation(fields: [companyId], references: [id])

  planId String? @db.ObjectId
  plan   Plan?   @relation(fields: [planId], references: [id])

  startDate       DateTime
  endDate         DateTime?
  status          SubscriptionStatus @default(ACTIVE)
  billingCycle    BillingCycle
  amount          Float
  paymentMethod   String?
  lastPaymentDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
  @@index([companyId])
  @@index([status])
}

model SubscriptionCompany {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  planId String? @db.ObjectId
  plan   Plan?   @relation(fields: [planId], references: [id])

  status       String // ACTIVE | INACTIVE | CANCELLED | EXPIRED | PAST_DUE
  billingCycle String  @default("MONTHLY") // MONTHLY | ANNUALLY
  amountPaid   Float?
  currency     String? @default("USD")

  startedAt         DateTime  @default(now())
  renewalDate       DateTime?
  endedAt           DateTime?
  trialEndsAt       DateTime?
  gracePeriodEndsAt DateTime?

  cancelAtPeriodEnd Boolean @default(false)

  // Paystack / Stripe / MPesa
  gateway               String?
  gatewaySubscriptionId String?
  gatewayCustomerId     String?

  meta Json?

  payments SubscriptionPayment[] // <--- LINK TO HISTORY

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  package   Package? @relation(fields: [packageId], references: [id])
  packageId String?  @db.ObjectId

  @@index([companyId])
  @@index([userId])
  @@index([status])
}

