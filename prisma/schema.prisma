  title       String
  description String?

  dueDate DateTime
  type    AssignmentType @default(HOMEWORK)

  createdById String   @db.ObjectId
  createdBy   Educator @relation(fields: [createdById], references: [id])

  maxGrade Float? // NEW: Added maxGrade to match API. Using Float for flexibility (e.g., 100.0, 85.5)
  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  submissions AssignmentSubmission[] // Relation to AssignmentSubmission (or Submission) model

  status AssignmentStatus @default(Draft)

  publishedAt DateTime @default(now())

