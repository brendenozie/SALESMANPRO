// Assignment Model
// Course Assignment Model
model CourseAssignment {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?

  dueDate DateTime
  type    AssignmentType @default(HOMEWORK)

  createdById String   @db.ObjectId
  createdBy   Educator @relation(fields: [createdById], references: [id])

  isPublished Boolean @default(false) // If results are visible to students

  maxGrade Float? // NEW: Added maxGrade to match API. Using Float for flexibility (e.g., 100.0, 85.5)
  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  academicYearId String?       @db.ObjectId
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  termId String? @db.ObjectId
  term   Term?   @relation(fields: [termId], references: [id])

  classroomId String?    @db.ObjectId
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  startTime DateTime? // When the assignment becomes available to students
  endTime   DateTime? // When the assignment is no longer accessible

  location     String? // Physical location or online link for submission
  instructions String? // Additional instructions for the assignment

  submissions AssignmentSubmission[] // Relation to AssignmentSubmission (or Submission) model

  // Fields for online exams
  isOnline        Boolean @default(false) // Whether this is an online exam
  durationMinutes Float? // Duration of the exam once started (in minutes)
  autoGrade       Boolean @default(false) // Whether the exam can be automatically graded (e.g., for MCQs)

  status AssignmentStatus @default(Draft)

  publishedAt DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  createdAt                 DateTime?                  @default(now())
  updatedAt                 DateTime?                  @updatedAt
  Grade                     Grade[]
  courseAssignmentQuestions CourseAssignmentQuestion[]
  lesson                    Lesson?                    @relation(fields: [lessonId], references: [id])
  lessonId                  String?                    @db.ObjectId

  weight Float @default(10) // e.g., this assignment is 10% of the total grade

  @@index([courseId])
  @@index([companyId])
  @@index([status])
}

//Course Assignment Question Model
model CourseAssignmentQuestion {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  assignmentId String           @db.ObjectId // Foreign key to CourseAssignment
  assignment   CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade) // CRITICAL: onDelete: Cascade

  questionText String
  questionType QuestionType // e.g., "multiple_choice", "short_answer", "essay"

  imageUrl      String? // Optional image for the question
  videoUrl      String? // Optional video for the question
  hint          String? // Optional hint for the question
  // 
  options       String[] // For multiple choice questions
  correctAnswer String? // For auto-grading (if applicable)
  points        Float? // Points allocated for this question
  order         Int // Order of the question in the exam

  createdAt                   DateTime?                    @default(now())
  updatedAt                   DateTime?                    @updatedAt
  assignmentQuestionResponses AssignmentQuestionResponse[]

  @@index([assignmentId])
}

// Submission Model (Student's assignment submission)
model AssignmentSubmission {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  assignmentId String           @db.ObjectId // Foreign key to CourseAssignment
  assignment   CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade) // CRITICAL: onDelete: Cascade

  studentId String  @db.ObjectId
  student   Student @relation(fields: [studentId], references: [id])

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  grade    Float?
  gradedAt DateTime?

  submissionContent String?
  submissionUrl     String? // Link to file storage or online document
  submittedAt       DateTime @default(now())

  comments     String?
  reviewedById String?   @db.ObjectId // Educator who reviewed it
  reviewedBy   Educator? @relation(fields: [reviewedById], references: [id])
