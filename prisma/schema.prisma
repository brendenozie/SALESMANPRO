  ENROLLED
  COMPLETED
  DROPPED
  IN_PROGRESS
}

enum AssignmentStatus {
  Draft
  Upcoming
  Published
  Archived
}

enum AssignmentType {
  HOMEWORK
  PROJECT
  QUIZ
  UNIT_TEST
  MIDTERM
  FINAL
  ASSIGNMENT_BASED // If some assignments are considered exams
  PRACTICE
  PRACTICAL
  ESSAY_SUBMISSION // For exams that are primarily essay submissions
  PROJECT_ASSESSMENT // For exams that are project-based
