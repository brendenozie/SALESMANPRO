  lessonsCompleted Int      @default(0)
  enrolledAt       DateTime @default(now())

  status EnrollmentStatus @default(ENROLLED) // Current status (e.g., ENROLLED, COMPLETED, DROPPED)

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?  @db.ObjectId // Academic levels are specific to a company/school

  // status    String   @default("ENROLLED") // e.g., "ENROLLED", "COMPLETED", "DROPPED"
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Removed `@@unique([studentId, courseId])` to allow for multiple enrollments in the same course
  // (e.g., student retakes a course, or enrolls in different terms/semesters).
  // Uniqueness for a specific term or class instance should be managed by application logic
  // or a more specific unique constraint if a 'termId' is added to this model.
  @@index([studentId])
  @@index([courseId])
}

// Add this enum definition to your schema.txt
enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
  IN_PROGRESS
}

enum AssignmentStatus {
  Draft
  Published
  Archived
}

enum AssignmentType {
  HOMEWORK
  PROJECT
  QUIZ
  UNIT_TEST
  MIDTERM
  FINAL
  ASSIGNMENT_BASED // If some assignments are considered exams
  PRACTICE
  PRACTICAL
