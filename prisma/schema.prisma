// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Consumer   Consumer?   @relation(fields: [userId], references: [id])
  SalesAgent SalesAgent? @relation(fields: [userId], references: [id])
  Client     Client?     @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

enum ROLE {
  USER
  AGENT
  CLIENT
  ADMIN
}

model Session {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String      @unique
  expires      DateTime
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String      @db.ObjectId
  role         ROLE?       @default(USER)
  Consumer     Consumer?   @relation(fields: [consumerId], references: [id])
  consumerId   String?     @db.ObjectId
  SalesAgent   SalesAgent? @relation(fields: [salesAgentId], references: [id])
  salesAgentId String?     @db.ObjectId
  Client       Client?     @relation(fields: [clientId], references: [id])
  clientId     String?     @db.ObjectId
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model Category {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  icon          String?
  image         String?
  status        String
  allBrands     String[]
  tags          String[]
  subcategories Json // Store subcategories as a JSON array
}

// Category model with self-relations for hierarchy (categories & subcategories)
model ProductCategory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  icon            String?
  image           String?
  slug            String   @unique
  description     String
  longDescription String
  seoTitle        String
  seoDescription  String
  metaKeywords    String[]
  sortOrder       Int
  visible         Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  updatedBy       String
  status          String
  allBrands       String[]
  tags            String[]

  // Hierarchy pointers
  subcategories Json // Store subcategories as a JSON array

  // Media & SEO assets
  imageAlt    String
  thumbnail   String?
  bannerImage String?

  // Localization
  localization Json

  // Dynamic fields
  productCount   Int
  isFeatured     Boolean
  showInHomepage Boolean

  // Custom attributes
  attributes Json

  Product            Product[]
  MarketplaceListing MarketplaceListing[]
  StoreCategory      StoreCategory[]
}

/// Associates a Company with a ProductCategory,
/// plus any store-specific settings.
model StoreCategory {
  company    Company         @relation(fields: [companyId], references: [id])
  companyId  String          @db.ObjectId
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId String          @db.ObjectId

  // Store-specific overrides:
  displayName String? // e.g. “Gadgets” instead of “Tech Gadgets”
  icon        String? // override the global icon
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)

  id String @id @default(auto()) @map("_id") @db.ObjectId // Add a single primary key
  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt

  // @@id([companyId, categoryId])
  @@unique([companyId, categoryId]) // Use a unique constraint instead
  @@index([companyId, sortOrder]) // speed up ordering queries
}

model Company {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String        @unique
  tagline      String? // short marketing line
  description  String?
  category     String
  logoUrl      String?
  bannerUrl    String?
  heroSlides   Banner[] // relational banners/slides
  contactEmail String
  contactPhone String?
  address      String?
  geoLocation  Json? // { lat: number, lng: number }
  openingHours Json? // { mon: "9–5", tue: "...", … }
  domain       String?       @unique
  currency     String        @default("KES")
  locale       String        @default("en-US")
  socialLinks  SocialLink[] // structured social profiles
  policies     Policy[] // structured, editable policies
  faqs         FAQ[] // common questions
  testimonials Testimonial[] // customer quotes
  promotions   Promotion[] // site-wide deals

  themeSettings Json? // colors, fonts, layout toggles
  seo           SEO?  @relation(fields: [sEOId], references: [id]) // SEO settings
  // analytics     AnalyticsConfig?  @relation(fields: [analyticsConfigId], references: [id])
  // payment       PaymentSettings?  @relation(fields: [paymentSettingsId], references: [id])

  StoreCategory StoreCategory[]

  // existing relations
  user            User?            @relation(fields: [userId], references: [id])
  userId          String?          @db.ObjectId
  salesAgents     SalesAgent[]
  products        Product[]
  inventory       InventoryItem[]
  clients         Client[]
  productRequests Request[]
  Target          Target[]
  commissions     Commission[]
  commissionsRate CommissionRate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  sEOId     String?   @db.ObjectId

  PageSection PageSection[]
  BlogPost    BlogPost[]
  Collection  Collection[]

  // ShippingSettings   ShippingSettings[]
  // AnalyticsConfig    AnalyticsConfig[]
  // PaymentSettings    PaymentSettings[]

  MarketplaceListing MarketplaceListing[]

  analyticsConfig   AnalyticsConfig? @relation(fields: [analyticsConfigId], references: [id])
  analyticsConfigId String?          @db.ObjectId

  paymentSettings   PaymentSettings? @relation(fields: [paymentSettingsId], references: [id])
  paymentSettingsId String?          @db.ObjectId

  shippingSettings   ShippingSettings? @relation(fields: [shippingSettingsId], references: [id])
  shippingSettingsId String?           @db.ObjectId

  awards   Json? // e.g. [{ name: String, iconUrl: String }]
  metrics  Json?
  stats    Json?
  AppPromo AppPromo[]
}

enum CategoryStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model SocialLink {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  company   Company       @relation(fields: [companyId], references: [id])
  companyId String        @db.ObjectId
  // channel   String // e.g. "twitter", "instagram"
  channel   SocialChannel
  url       String
}

model Policy {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  company   Company    @relation(fields: [companyId], references: [id])
  companyId String     @db.ObjectId
  // type      String // e.g. "shipping", "returns", "privacy"
  type      PolicyType
  title     String?
  content   String
}

model FAQ {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId
  question  String
  answer    String
  order     Int     @default(0)
}

model Testimonial {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId
  author    String
  quote     String
  avatarUrl String?
  rating    Int? // 1–5 stars
  order     Int     @default(0)
}

model Banner {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  companyId String  @db.ObjectId
  imageUrl  String
  headline  String?
  subline   String?
  ctaText   String?
  ctaLink   String?
  order     Int     @default(0)
}

model Promotion {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   String    @db.ObjectId
  code        String?
  title       String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  bannerUrl   String?
}

model AnalyticsConfig {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  googleTag   String?
  facebookTag String?
  Company     Company[]
}

model PaymentSettings {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  stripeKey           String?
  paypalKey           String?
  mpesaShortcode      String?
  mpesaConsumerKey    String?
  mpesaConsumerSecret String?
  mpesaCallbackUrl    String?
  Company             Company[]
}

model ShippingSettings {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  carrierName        String?
  trackingUrl        String?
  regions            Json?
  enablePickup       Boolean?
  pickupInstructions String?
  Company            Company[]
}

model PageSection {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  company   Company     @relation(fields: [companyId], references: [id])
  companyId String      @db.ObjectId
  type      SectionType
  order     Int         @default(0)
  settings  Json // e.g. { background: "dark", padding: "xl" }
  content   Json // e.g. { headline: "...", blocks: [ ... ] }
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum SectionType {
  Hero
  FeatureGrid
  TestimonialCarousel
  BlogPreview
  CustomHtml
  About
  Services
  Awards
  HealthTips
  Features
  HowItWorks
  Pricing
  CTA
  Metrics
  Stats
  // …add more as needed
}

enum SocialChannel {
  TWITTER
  INSTAGRAM
  FACEBOOK
  LINKEDIN
}

enum PolicyType {
  SHIPPING
  RETURNS
  PRIVACY
  TERMS
}

model Locations {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
}

model AppPromo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String?  @db.ObjectId
  company     Company? @relation(fields: [companyId], references: [id])
  headline    String
  subheading  String
  buttons     Json // e.g. [{ label: "Download", href: "...", icon: "apple" }]
  screenshots String[] // array of image URLs
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  category     String?
  subCategory  Json?
  images       Json[]
  video        String?
  tags         String[]
  profitMargin Float?   @default(0)
  brand        String?
  companyId    String?  @db.ObjectId
  company      Company? @relation(fields: [companyId], references: [id])

  productCategoryId  String?              @db.ObjectId
  productCategory    ProductCategory?     @relation(fields: [productCategoryId], references: [id])
  inventoryItems     InventoryItem[]
  requests           Request[]            @relation("ProductRequests")
  commissions        Commission[]
  Target             Target[]
  CommissionRate     CommissionRate?
  MarketplaceListing MarketplaceListing[]

  model     String?
  color     String[]
  size      String[]
  weight    String?
  condition String?
  dimension String?
  material  String[]

  // New fields for category-specific details:
  author    String? // For Books
  publisher String? // For Books
  isbn      String? // For Books

  fabricComposition String? // For Clothing/Fashion
  careInstructions  String? // For Clothing/Fashion

  energyRating        String? // For Home Appliances
  warrantyPeriod      String? // For Home Appliances
  applianceDimensions String? // For Home Appliances – renamed to avoid conflict with 'dimension'

  ingredients       String? // For Beauty Products
  usageInstructions String? // For Beauty Products
  expirationDate    DateTime? // For Beauty Products

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discount Int? @default(0)

  isAvailable  Boolean @default(true)
  isOnOffer    Boolean @default(false)
  isFlashDeal  Boolean @default(false)
  isNewArrival Boolean @default(false)
  isDiscounted Boolean @default(false)
  isFeatured   Boolean @default(false)

  startDealDate DateTime?
  endDealDate   DateTime?

  costPrice  Float
  salesPrice Float
  finalPrice Float? @default(0) //Price inclusive discount

  contact   String?
  location  Json? // GeoJSON format { type: "Point", coordinates: [lng, lat] }
  amenities String[]

  bedrooms Json? // Updated to support multiple bedroom types
  studios  Json? // Updated to support multiple bedroom types

  status         ListingStatus    @default(ACTIVE)
  Collection     Collection?      @relation(fields: [collectionId], references: [id])
  collectionId   String?          @db.ObjectId
  CollectionItem CollectionItem[]
  Review         Review[]
  Question       Question[]
  RecentlyViewed RecentlyViewed[]
  WishlistItem   WishlistItem[]

  @@index([name])
  @@index([finalPrice])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([status])
}

model BlogPost {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  company     Company    @relation(fields: [companyId], references: [id])
  companyId   String     @db.ObjectId
  title       String
  slug        String     @unique
  excerpt     String
  content     String // Markdown or HTML
  author      String?
  coverImage  String?
  tags        String[]
  publishedAt DateTime?
  status      PostStatus @default(DRAFT)
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Blog {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String     @unique
  slug        String     @unique
  content     String
  excerpt     String? //@db.VarChar(300) // Short summary
  coverImage  String? // URL to the blog's cover image
  categories  String[] // Array of category names
  tags        String[] // Array of relevant tags
  author      Author     @relation(fields: [authorId], references: [id])
  authorId    String     @db.ObjectId
  seo         SeoBlog?
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  views       Int        @default(0)
  likes       Int        @default(0)
  comments    Comment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Author {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  profileImage String?
  blogs        Blog[]
}

model SeoBlog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  keywords    String[]
  blogId      String   @unique @db.ObjectId
  blog        Blog     @relation(fields: [blogId], references: [id])
}

model SEO {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  keywords    String[]
  Company     Company[]
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      String
  comment   String
  createdAt DateTime @default(now())
  blogId    String   @db.ObjectId
  blog      Blog     @relation(fields: [blogId], references: [id])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ListingStatus {
  BUY
  RENT
  SOLD
  RENTED
  ACTIVE
  INACTIVE
}

model Task {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  taskName    String
  dueDate     DateTime  @db.Date
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @db.ObjectId
  dueTime     String
  description String?
  icon        String?
  status      String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

model Client {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  name              String?
  password          String?
  email             String              @unique
  phoneNumber       String?
  companyId         String              @db.ObjectId
  company           Company?            @relation(fields: [companyId], references: [id])
  salesAgentId      String?             @db.ObjectId
  salesAgent        SalesAgent?         @relation(fields: [salesAgentId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  communications    Communication[]     @relation("CommunicationReceiver")
  ClientInventory   ClientInventory[]
  AgentInventoryLog AgentInventoryLog[]
  emailVerified     DateTime?
  image             String?
  phone             String?
  username          String?
  bio               String?
  address           String?
  profilePicture    String?
  role              ROLE?               @default(CLIENT)
  accounts          Account[]
  sessions          Session[]
}

model Communication {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String     @db.ObjectId
  sender     SalesAgent @relation("CommunicationSender", fields: [senderId], references: [id])
  receiverId String     @db.ObjectId
  receiver   Client     @relation("CommunicationReceiver", fields: [receiverId], references: [id])
  subject    String?
  message    String
  createdAt  DateTime   @default(now())
}

model SalesAgent {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String?
  email              String               @unique
  image              String?
  accounts           Account[]
  sessions           Session[]
  phoneNumber        String?
  companyId          String?              @db.ObjectId
  company            Company?             @relation(fields: [companyId], references: [id])
  clients            Client[]
  productRequests    Request[]
  password           String?
  role               ROLE?                @default(AGENT)
  emailVerified      DateTime?
  phone              String?
  username           String?
  bio                String?
  address            String?
  profilePicture     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  commissions        Commission[]
  communications     Communication[]      @relation("CommunicationSender")
  Return             Return[]
  AgentInventory     AgentInventory[]
  Assignment         Assignment[]
  Target             Target[]
  ClientInventory    ClientInventory[]
  ClientInventoryLog ClientInventoryLog[]
}

model User {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  name                  String?
  email                 String                  @unique
  password              String?
  role                  ROLE?                   @default(ADMIN)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  accounts              Account[]
  sessions              Session[]
  // usersCategory         UsersCategory?          @relation(fields: [usersCategoryId], references: [id])
  // usersCategoryId       String?                 @db.ObjectId
  tasks                 Task[]
  auditLogs             AuditLog[]
  requests              Request[]
  returns               Return[]
  Assignment            Assignment[]
  emailVerified         DateTime?
  image                 String?
  phone                 String?
  username              String?
  bio                   String?
  address               String?
  profilePicture        String?
  ProductReview         ProductReview[]
  ProductReviewLog      ProductReviewLog[]
  ProductReviewResponse ProductReviewResponse[]
  ProductReviewLike     ProductReviewLike[]
  ProductReviewDislike  ProductReviewDislike[]
  Company               Company[]
  Review                Review[]
  Question              Question[]
  RecentlyViewed        RecentlyViewed[]
  Wishlist              Wishlist[]
}

enum Status {
  PENDING
  APPROVED
  DENIED
}

model Return {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  inventoryId   String        @db.ObjectId
  inventoryItem InventoryItem @relation(fields: [inventoryId], references: [id])
  returnedById  String        @db.ObjectId
  returnedBy    SalesAgent    @relation(fields: [returnedById], references: [id])
  ApprovedBy    User?         @relation(fields: [ApprovedById], references: [id])
  ApprovedById  String?       @db.ObjectId
  quantity      Int
  reason        String?
  status        Status        @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Assignment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  ApprovedBy       User?         @relation(fields: [ApprovedById], references: [id])
  ApprovedById     String?       @db.ObjectId
  salesAgentId     String        @db.ObjectId
  salesAgent       SalesAgent    @relation(fields: [salesAgentId], references: [id])
  inventoryItemId  String        @db.ObjectId
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityAssigned Int
  reason           String? // Optional reason for assignment
  createdAt        DateTime      @default(now())
}

model InventoryItem {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  productId        String            @db.ObjectId
  product          Product           @relation(fields: [productId], references: [id])
  companyId        String            @db.ObjectId
  company          Company           @relation(fields: [companyId], references: [id])
  quantity         Int
  reorderThreshold Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inventoryLogs    InventoryLog[]
  returns          Return[]
  AgentInventory   AgentInventory[]
  Assignment       Assignment[]
  ClientInventory  ClientInventory[]
}

model InventoryLog {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  inventoryId   String        @db.ObjectId
  inventoryItem InventoryItem @relation(fields: [inventoryId], references: [id])
  damaged       Int           @default(0)
  action        String
  quantity      Int
  createdAt     DateTime      @default(now())
}

model AgentInventory {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId      String              @db.ObjectId
  salesAgent        SalesAgent          @relation(fields: [salesAgentId], references: [id])
  inventoryItemId   String              @db.ObjectId
  inventoryItem     InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  quantity          Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  AgentInventoryLog AgentInventoryLog[]
  ClientInventory   ClientInventory[]
}

model CommissionRate {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  productId      String         @unique @db.ObjectId
  product        Product        @relation(fields: [productId], references: [id])
  salesAgentId   String? // Optional for agent-specific rates
  teamId         String? // Optional for team-specific rates
  commissionType CommissionType // Enum: FIXED or PERCENTAGE
  commissionRate Float
  startDate      DateTime       @default(now())
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  Company        Company?       @relation(fields: [companyId], references: [id])
  companyId      String?        @db.ObjectId
}

model Commission {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId     String           @db.ObjectId
  salesAgent       SalesAgent       @relation(fields: [salesAgentId], references: [id])
  productId        String           @db.ObjectId
  product          Product          @relation(fields: [productId], references: [id])
  commissionRate   Float // Rate (percentage or fixed) based on criteria
  commissionEarned Float // Calculated based on the chosen criteria
  basedOn          CommissionType   @default(COST) // Define whether based on COST or QUANTITY
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  status           CommissionStatus @default(PENDING)
  Company          Company?         @relation(fields: [companyId], references: [id])
  companyId        String?          @db.ObjectId

  @@unique([salesAgentId, productId]) // Composite unique constraint
  @@index([salesAgentId, status])
}

enum CommissionType {
  COST // Commission based on total sales value
  QUANTITY // Commission based on quantity sold
}

enum CommissionStatus {
  PENDING
  COMPLETED
  DENIED
}

model CommissionLog {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  commissionId String
  oldStatus    CommissionStatus
  newStatus    CommissionStatus
  changedBy    String
  changedAt    DateTime         @default(now())
}

model Target {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId  String       @db.ObjectId
  salesAgent    SalesAgent   @relation(fields: [salesAgentId], references: [id])
  productId     String       @db.ObjectId
  product       Product      @relation(fields: [productId], references: [id])
  targetType    TargetType   @default(COST) // Define whether target is based on COST or QUANTITY
  targetValue   Float // Value to achieve (e.g., $5000 sales or 100 units sold)
  achievedValue Float        @default(0) // Progress towards target
  startDate     DateTime
  endDate       DateTime
  status        TargetStatus @default(ONGOING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Company       Company?     @relation(fields: [companyId], references: [id])
  companyId     String?      @db.ObjectId

  @@unique([salesAgentId, productId]) // Composite unique constraint
  @@unique([salesAgentId, productId, startDate])
  @@index([salesAgentId, status, startDate, endDate])
}

enum TargetType {
  COST // Target based on total sales value
  QUANTITY // Target based on quantity sold
  REVENUE
  UNITS
  ORDERS
}

enum TargetStatus {
  ONGOING
  ACHIEVED
  EXPIRED
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  details   String?
}

enum SellerType {
  CLIENT
  CONSUMER
  ADMIN
  COMPANY
}

model UserActivity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  action    String // "view", "purchase", "favorite"
  createdAt DateTime @default(now())

  product MarketplaceListing @relation(fields: [productId], references: [id])

  @@index([userId, productId, createdAt])
}

model MarketplaceListing {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String?         @db.ObjectId
  company           Company?        @relation(fields: [companyId], references: [id])
  sellerId          String?         @db.ObjectId
  sellerType        SellerType?
  productId         String?         @db.ObjectId
  product           Product?        @relation(fields: [productId], references: [id])
  subCategoryName   String?
  title             String          @default("New Name")
  description       String?         @default("New Description")
  quantity          Int
  images            Json[]
  video             String?
  productCategoryId String          @db.ObjectId
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
  category          String?
  subCategory       Json
  tags              String[]
  brand             String?
  model             String?
  color             String[]
  size              String[]
  weight            String?
  condition         String?
  dimension         String?
  material          String[]
  profitMargin      Float?          @default(0)

  // New fields for category-specific details:
  author    String? // For Books
  publisher String? // For Books
  isbn      String? // For Books

  fabricComposition String? // For Clothing/Fashion
  careInstructions  String? // For Clothing/Fashion

  energyRating        String? // For Home Appliances
  warrantyPeriod      String? // For Home Appliances
  applianceDimensions String? // For Home Appliances – renamed to avoid conflict with 'dimension'

  ingredients       String? // For Beauty Products
  usageInstructions String? // For Beauty Products
  expirationDate    DateTime? // For Beauty Products

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discount     Int?    @default(0)
  isAvailable  Boolean @default(true)
  isOnOffer    Boolean @default(false)
  isFlashDeal  Boolean @default(false)
  isNewArrival Boolean @default(false)
  isDiscounted Boolean @default(false)
  isFeatured   Boolean @default(false)

  delivery      Boolean @default(false)
  paymentOption String  @default("AT SHOP") //"Standard", "Express", "AT SHOP"

  startDealDate DateTime?
  endDealDate   DateTime?
  buyingPrice   Float
  sellingPrice  Float
  finalPrice    Float?    @default(0) //Price inclusive discount

  contact   String?
  location  Json? // GeoJSON format { type: "Point", coordinates: [lng, lat] }
  amenities String[]

  bedrooms Json? // Updated to support multiple bedroom types
  studios  Json? // Updated to support multiple bedroom types

  status         ListingStatus    @default(ACTIVE)
  OrderItem      OrderItem[]
  UserActivity   UserActivity[]
  ProductMetrics ProductMetrics[]
  ProductReview  ProductReview[]
}

model ProductMetrics {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @unique @db.ObjectId
  views     Int      @default(0)
  purchases Int      @default(0)
  favorites Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product MarketplaceListing @relation(fields: [productId], references: [id])

  @@index([productId, updatedAt])
}

model ProductReview {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  productId             String                  @db.ObjectId
  product               MarketplaceListing      @relation(fields: [productId], references: [id])
  userId                String                  @db.ObjectId
  user                  User                    @relation(fields: [userId], references: [id])
  rating                Int
  comment               String?
  createdAt             DateTime                @default(now())
  ProductReviewLog      ProductReviewLog[]
  ProductReviewResponse ProductReviewResponse[]
  ProductReviewLike     ProductReviewLike[]
  ProductReviewDislike  ProductReviewDislike[]
}

model ProductReviewLog {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  reviewId  String        @db.ObjectId
  review    ProductReview @relation(fields: [reviewId], references: [id])
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id])
  action    String // e.g., "added", "edited", "deleted"
  createdAt DateTime      @default(now())
}

model ProductReviewResponse {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  reviewId  String        @db.ObjectId
  review    ProductReview @relation(fields: [reviewId], references: [id])
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id])
  response  String
  createdAt DateTime      @default(now())
}

model ProductReviewLike {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  reviewId  String        @db.ObjectId
  review    ProductReview @relation(fields: [reviewId], references: [id])
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
}

model ProductReviewDislike {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  reviewId  String        @db.ObjectId
  review    ProductReview @relation(fields: [reviewId], references: [id])
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
}

model ClientInventory {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  clientId         String               @db.ObjectId
  rating           Float                @default(0)
  availability     Boolean              @default(true)
  client           Client               @relation(fields: [clientId], references: [id])
  inventoryItemId  String               @db.ObjectId
  inventoryItem    InventoryItem        @relation(fields: [inventoryItemId], references: [id])
  agentInventoryId String               @db.ObjectId
  agentInventory   AgentInventory       @relation(fields: [agentInventoryId], references: [id])
  salesAgentId     String               @db.ObjectId
  salesAgent       SalesAgent           @relation(fields: [salesAgentId], references: [id])
  quantity         Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  logs             ClientInventoryLog[]

  @@unique([clientId, inventoryItemId]) // Composite unique constraint
}

model ClientInventoryLog {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  clientInventoryId String          @db.ObjectId
  clientInventory   ClientInventory @relation(fields: [clientInventoryId], references: [id])
  action            String // e.g., "allocated", "returned-to-agent", "returned-to-company"
  salesAgentId      String          @db.ObjectId
  salesAgent        SalesAgent      @relation(fields: [salesAgentId], references: [id])
  quantity          Int
  price             Float
  priceType         String // "buying" or "selling"
  totalPrice        Float
  status            String //completed, pending
  damaged           Int             @default(0)
  createdAt         DateTime        @default(now())
}

model AgentInventoryLog {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  agentInventoryId String         @db.ObjectId
  agentInventory   AgentInventory @relation(fields: [agentInventoryId], references: [id])
  totalPrice       Float
  action           String // e.g., "client-return", "company-return"
  clientId         String?        @db.ObjectId
  client           Client?        @relation(fields: [clientId], references: [id])
  quantity         Int
  damaged          Int            @default(0)
  createdAt        DateTime       @default(now())
}

model SalesSummary {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId    String
  totalCommission Float
  totalSales      Float
  updatedAt       DateTime @updatedAt
}

model EventLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventType String
  entityId  String
  message   String
  createdAt DateTime @default(now())
}

model Request {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  productId       String        @db.ObjectId
  product         Product       @relation(fields: [productId], references: [id], name: "ProductRequests")
  requestedById   String        @db.ObjectId // References either a Client or a SalesAgent
  requestedByType RequesterType // Enum to indicate the type of requester
  quantity        Int
  totalPrice      Float         @default(0)
  status          Status        @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  salesAgentId    String?       @db.ObjectId // Optional, if a sales agent is involved
  salesAgent      SalesAgent?   @relation(fields: [salesAgentId], references: [id])
  companyId       String?       @db.ObjectId
  company         Company?      @relation(fields: [companyId], references: [id])
  ApprovedBy      User?         @relation(fields: [ApprovedById], references: [id])
  ApprovedById    String?       @db.ObjectId
}

// Enum for requestedByType
enum RequesterType {
  CLIENT
  SALES_AGENT
}

model Consumer {
  id                   String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                 String?
  email                String                 @unique
  emailVerified        DateTime?
  image                String?
  accounts             Account[]
  sessions             Session[]
  phone                String?
  password             String?
  username             String?
  bio                  String?
  address              String?
  profilePicture       String?
  role                 ROLE?                  @default(USER)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  ConsumerInventory    ConsumerInventory[]
  ConsumerInventoryLog ConsumerInventoryLog[]
}

model ConsumerInventory {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  consumerId   String                 @db.ObjectId
  rating       Float                  @default(0)
  availability Boolean                @default(true)
  consumer     Consumer               @relation(fields: [consumerId], references: [id])
  quantity     Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  logs         ConsumerInventoryLog[]
}

model ConsumerInventoryLog {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  clientInventoryId String            @db.ObjectId
  clientInventory   ConsumerInventory @relation(fields: [clientInventoryId], references: [id])
  action            String // e.g., "allocated", "returned-to-agent", "returned-to-company"
  consumerId        String            @db.ObjectId
  consumer          Consumer          @relation(fields: [consumerId], references: [id])
  quantity          Int
  price             Float
  priceType         String // "buying" or "selling"
  totalPrice        Float
  status            String //completed, pending
  damaged           Int               @default(0)
  createdAt         DateTime          @default(now())
}

model CustomerOrder {
  id                    String      @id @default(auto()) @map("_id") @db.ObjectId
  consumerId            String      @db.ObjectId
  items                 OrderItem[] // Relationship to multiple order items
  totalPrice            Float
  orderSource           OrderSource @default(WEBSITE)
  status                OrderStatus @default(PENDING)
  trackingNumber        String? // Optional tracking number
  estimatedArrival      DateTime? // Estimated delivery time
  deliveryStatus        String? // "Order Placed", "Processing", "Shipped", etc.
  deliveryPersonName    String? // Delivery person's name
  deliveryPersonContact String? // Delivery person's contact info
  shippingAddress       Json? // Shipping address
  shippingMethod        String? // Shipping method (e.g., standard, express)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model OrderItem {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  orderId              String             @db.ObjectId
  order                CustomerOrder      @relation(fields: [orderId], references: [id])
  marketplaceListingId String             @db.ObjectId
  marketplaceListing   MarketplaceListing @relation(fields: [marketplaceListingId], references: [id])
  quantity             Int
  price                Float
}

model Location {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  latitude    Float
  longitude   Float
  address     String
  description String
  userId      String? @unique // Link to the user (optional)
}

enum OrderStatus {
  PENDING
  COMPLETED
  RECURRING
  SHIPPED
  OUT_FOR_DELIVERY
  CANCELLED
}

enum OrderSource {
  WEBSITE
  IN_PERSON
  MOBILE
}

model Banners {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  imageUrl     String
  productImage String?
  bannerType   String // e.g., "homepage", "category", "product"
  link         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  status       String    @default("active") // e.g., "active", "inactive"
  startDate    DateTime?
  endDate      DateTime?
  tags         String[]
}

model Collection {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  company        Company          @relation(fields: [companyId], references: [id])
  companyId      String           @db.ObjectId
  name           String
  slug           String           @unique
  description    String?
  image          String?
  products       Product[]
  order          Int              @default(0)
  CollectionItem CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  collection   Collection @relation(fields: [collectionId], references: [id])
  collectionId String     @db.ObjectId
  product      Product    @relation(fields: [productId], references: [id])
  productId    String     @db.ObjectId
  sortOrder    Int        @default(0)
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  rating    Int // 1–5
  title     String?
  body      String
  photos    String[] // URLs
  createdAt DateTime @default(now())
}

model Question {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  question  String
  answer    String?
  createdAt DateTime @default(now())
}

model RecentlyViewed {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  viewedAt  DateTime @default(now())
}

model Wishlist {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  user         User           @relation(fields: [userId], references: [id])
  userId       String         @db.ObjectId
  name         String
  // products Product[] @relation(references: [id], through: WishlistItem)
  WishlistItem WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id])
  wishlistId String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  productId  String   @db.ObjectId
  addedAt    DateTime @default(now())
}
