# ============================================================
# SALESMANPRO CANONICAL ENVIRONMENT CONFIGURATION SPECIFICATION
# ============================================================
# Notice: This file contains variable names, types, and safe placeholder descriptions only.
# Never commit active credentials, private keys, or plaintext secrets to source control.

# --- Core Next.js & Server Runtime ---
NODE_ENV=production
PORT=3000
BASE_PATH=
PLATFORM_BASE_DOMAIN=salesmanpro.site
VPS_IP=your_contabo_vps_ip

# --- Authentication & Session Security (NextAuth & JWT) ---
NEXTAUTH_URL=https://salesmanpro.site
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:3000
AUTH_TRUST_HOST=true
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate_strong_secret_using_openssl_rand_base64_32
AUTH_SECRET=generate_strong_secret_using_openssl_rand_base64_32
# Signing secret for Android & Desktop handover tokens
JWT_SECRET=generate_strong_jwt_signing_secret_here

# --- Google OAuth 2.0 (Single Sign-On & YouTube) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# --- Primary Databases & Message Broker ---
# MongoDB 7.0 Connection URI with rs0 Replica Set
DATABASE_URL="mongodb://127.0.0.1:27017/SALESMANDB?authSource=admin&directConnection=true"
# Redis 6+ In-Memory Cache & BullMQ Queue URI
REDIS_URL="redis://127.0.0.1:6379"

# --- Master AES-256-GCM Encryption Ciphers ---
# 32-byte hex-encoded string (64 hex characters) or 32 ASCII characters
ENCRYPTION_KEY=64_character_hex_string_for_aes_256_gcm_secret_encryption
MASTER_ENCRYPTION_KEY=64_character_hex_string_for_aes_256_gcm_secret_encryption

# --- Meta WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=your_custom_meta_webhook_verify_token_here
WHATSAPP_ACCESS_TOKEN=EAAB_your_permanent_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000002
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_ALLOW_UNSIGNED_WEBHOOK=false

# --- AI Inference & Agent Infrastructure ---
# Groq Ultra-Low Latency Inference
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Platform (GPT-4o, Embeddings)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini & Multimodal GenAI
GEMINI_API_KEY=AIza_your_gemini_api_key_here
GOOGLE_GENAI_API_KEY=AIza_your_gemini_api_key_here

# Anthropic Claude (Optional / Roadmapped)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# SerpApi Real-Time Web Search (AI Workforce Market Researcher)
SERPAPI_API_KEY=your_serpapi_key_here

# --- Payment Gateways & Financial Settlement ---
# 1. Safaricom Daraja 2.0 M-Pesa
MPESA_ENVIRONMENT=sandbox # sandbox or live
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://salesmanpro.site/api/mpesa/callback

# 2. Paystack Payments
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://salesmanpro.site/api/webhooks/paystack

# 3. Stripe Global Card Checkout
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_SIGNING_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_WEBHOOK_URL=https://salesmanpro.site/api/webhooks/stripe

# 4. PayPal REST v2
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_USE_SANDBOX=true

# 5. Ghuba Marketplace Platform Gateway
GHUBA_MERCHANT_ID=your_ghuba_merchant_id
GHUBA_API_KEY=your_ghuba_api_key
GHUBA_BASE_URL=https://api.ghuba.shop
GHUBA_CALLBACK_URL=https://salesmanpro.site/api/webhooks/ghuba

# --- Social Media OAuth & Content Publishing ---
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# --- Communications: Multi-Tenant Email & SMS ---
DEFAULT_EMAIL_PROVIDER=SMTP # SMTP, RESEND, SENDGRID
DEFAULT_FROM_NAME="SalesmanPro"
DEFAULT_FROM_EMAIL=no-reply@salesmanpro.site
DEFAULT_REPLY_TO=support@salesmanpro.site

# SMTP Relay Configuration (Hostinger / Gmail / SES)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@salesmanpro.site
SMTP_PASS=your_smtp_mailbox_password_here

# Alternative API Providers
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_RECEIVER=support@salesmanpro.site

# TextSMS Kenya Transactional Gateway
SMS_API_KEY=your_textsms_api_key
SMS_PARTNER_ID=your_textsms_partner_id
SMS_SENDER_ID=your_textsms_sender_id
SMS_BASE_URL=https://sms.textsms.co.ke/api/services

# Firebase Cloud Messaging (Android & Web Push)
FIREBASE_CLIENT_API_KEY=AIza_your_firebase_client_key
FIREBASE_CLIENT_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_CLIENT_PROJECT_ID=your_project_id
FIREBASE_CLIENT_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_CLIENT_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_CLIENT_APP_ID=1:your_app_id:web:your_hash

# --- Cloud Storage & CDN ---
AWS_ACCESS_KEY_ID=AKIA_your_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key_here
AWS_REGION=us-east-1
AWS_BUCKET_NAME=salesmanpro-media
NEXT_PUBLIC_CDN_URL=https://cdn.salesmanpro.site

# --- Automated Database Backup & Disaster Recovery ---
BACKUP_ENABLED=true
BACKUP_STORAGE_PROVIDER=s3
BACKUP_S3_BUCKET=salesmanpro-production-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=backups/production/mongodb
BACKUP_S3_ACCESS_KEY=AKIA_your_backup_access_key
BACKUP_S3_SECRET_KEY=your_backup_secret_key
BACKUP_ENCRYPTION_KEY=generate_strong_32_byte_secret_for_backup_encryption
BACKUP_ENCRYPTION_KEY_VERSION=v1
BACKUP_SECRET=generate_strong_backup_cron_secret
BACKUP_CRON_SECRET=generate_strong_backup_cron_secret
BACKUP_ALERT_EMAIL=devops@salesmanpro.site

# --- Search Engine Indexing ---
INDEXNOW_KEY=your_indexnow_api_key
