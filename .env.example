# ============================================================
# SALESMANPRO PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# --- Core App ---
NODE_ENV=production
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_strong_secret_using_openssl_rand_base64_32
DATABASE_URL=mongodb://127.0.0.1:27017/SALESMANDB?authSource=admin&directConnection=true

# --- Redis & BullMQ Queue ---
REDIS_URL=redis://127.0.0.1:6379

# --- Meta WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=your_custom_meta_webhook_verify_token_here
WHATSAPP_ACCESS_TOKEN=EAAB...your_permanent_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000002
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v21.0

# --- AI Provider Configuration ---
# Groq (Fast structured JSON inference)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Alternative provider)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Alternative provider)
GOOGLE_GENAI_API_KEY=AIza...

# --- Safaricom Daraja M-Pesa ---
MPESA_ENVIRONMENT=sandbox # sandbox or live
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# --- Secondary Payment Gateways ---
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://yourdomain.com/api/webhooks/paystack

STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_URL=https://yourdomain.com/api/webhooks/stripe

GHUBA_MERCHANT_ID=your_ghuba_merchant_id
GHUBA_API_KEY=your_ghuba_api_key
GHUBA_BASE_URL=https://api.ghuba.shop
GHUBA_CALLBACK_URL=https://yourdomain.com/api/webhooks/ghuba

# --- Encryption (AES-GCM for tenant secrets in DB) ---
ENCRYPTION_KEY=32_byte_hex_string_for_aes_gcm_secret_encryption

# --- Automated Database Backup & Disaster Recovery ---
BACKUP_ENABLED=true
BACKUP_TIMEZONE=UTC
BACKUP_HOURLY_ENABLED=true
BACKUP_DAILY_ENABLED=true
BACKUP_WEEKLY_ENABLED=true
BACKUP_MONTHLY_ENABLED=true

BACKUP_DAILY_CRON="0 2 * * *"
BACKUP_WEEKLY_CRON="0 3 * * 0"
BACKUP_MONTHLY_CRON="0 4 1 * *"

BACKUP_RETENTION_HOURLY=48
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_WEEKLY=12
BACKUP_RETENTION_MONTHLY=12

# Cloud Object Storage (S3, Cloudflare R2, Wasabi, or MinIO)
BACKUP_STORAGE_PROVIDER=s3
BACKUP_S3_BUCKET=salesmanpro-production-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=backups/production/mongodb
BACKUP_S3_ACCESS_KEY=AKIA...
BACKUP_S3_SECRET_KEY=...
# Optional endpoint for Cloudflare R2 / MinIO:
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Artifact Encryption (AES-256-GCM)
BACKUP_ENCRYPTION_KEY=generate_strong_32_byte_secret_for_backup_encryption
BACKUP_ENCRYPTION_KEY_VERSION=v1

# Reliability & Alerting
BACKUP_RESTORE_TEST_ENABLED=true
BACKUP_ALERTS_ENABLED=true
BACKUP_ALERT_EMAIL=devops@salesmanpro.com

# ============================================================
# MULTI-TENANT EMAIL ARCHITECTURE
# ============================================================

# --- SalesmanPro Platform & Default Fallback Gateway ---
DEFAULT_EMAIL_PROVIDER=SMTP # SMTP, RESEND, SENDGRID
DEFAULT_FROM_NAME="SalesmanPro"
DEFAULT_FROM_EMAIL=no-reply@salesmanpro.site
DEFAULT_REPLY_TO=support@salesmanpro.site

# SMTP Gateway Configuration (Supported by SalesmanPro, Hostinger, Gmail, SendGrid, Amazon SES SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@salesmanpro.site
SMTP_PASS=your_secure_smtp_password_here

# Alternative API Providers (When DEFAULT_EMAIL_PROVIDER is RESEND or SENDGRID)
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# --- Ghuba Marketplace Email Identity ---
GHUBA_FROM_NAME="Ghuba"
GHUBA_FROM_EMAIL=no-reply@ghuba.shop
GHUBA_REPLY_TO=support@ghuba.shop

# Contact Form Ingestion Receiver
EMAIL_RECEIVER=support@salesmanpro.site
