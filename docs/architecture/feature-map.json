  "features": [
    {
      "id": "commerce.dashboard",
      "title": "Agent Operational Dashboard",
      "description": "Daily operational overview with metrics, pending items, recent sales, and quick actions tailored to role and category.",
      "category": ["all"],
      "adminRoute": "/admin/{slug}",
      "agentRoute": "/agents/{slug}/dashboard",
      "allowedRoles": ["MANAGER", "SALES_AGENT", "SERVICE_AGENT", "FITNESS_STAFF", "CASHIER", "INVENTORY_STAFF", "STAFF"],
      "capabilities": ["dashboard.view"],
      "allowedActions": ["view", "filter_period"],
      "api": "/api/agent/dashboard",
      "service": "agentDashboardService",
      "model": "UserActivity, SalesAgent, StaffProfile",
      "pos": "none",
      "adminOnly": false,
      "status": "active"
    },
    {
      "id": "commerce.orders",
      "title": "Customer Orders & Fulfillment",
      "description": "Daily operational order tracking, dispatch, fulfillment status, and receipt lookup.",
      "category": ["ecommerce", "automotive", "restaurant"],
      "adminRoute": "/admin/{slug}/orders",
      "agentRoute": "/agents/{slug}/orders",
      "allowedRoles": ["MANAGER", "SALES_AGENT", "CASHIER", "STAFF"],
      "capabilities": ["orders.view", "orders.create", "orders.update_status"],
      "allowedActions": ["view", "search", "filter_status", "view_receipt", "update_fulfillment"],
      "api": "/api/admin/customer-orders",
      "service": "lib/orders/centralizedCreateOrder.ts",
      "model": "CustomerOrder, OrderItem",
      "pos": "StorePOS",
      "adminOnly": false,
      "status": "active"
    },
